{
  "name": "game-playtest",
  "version": "4.0.0",
  "schema": 4,
  "description": "4-Agent 四要素任务树黑盒验收框架（人/地点/做到什么/时间=节点唯一标识）：Lead 协调、开发白盒、测试黑盒、记录只读；适用于任意 GUI 应用（桌面软件、Web/Electron、游戏）。节点需三重确认（测试自判→开发复核→Lead 宣布）；禁作弊、只走用户可达路径、证据只增；双进度（用户数据只读 / 团队进度可覆盖）与自动化输入门禁。后端与引擎无关：统一动作契约（launch/close/focus/info/keys/hold/diag/click/type/scroll/shot/hint/read_text/state），内置 Windows 桌面参考后端（PostMessage 或 SendInput，键鼠+点击+文本+滚动，截图不覆盖，输入日志）与 Web 后端（Edge/Chrome DevTools 协议，无第三方依赖，元素定位只用于确定点击位置、隐藏/禁用/被遮挡元素拒绝点击）。工具：通用步骤执行器 step_runner（每步声明期望、超时轮询、失败快照）、HUD 走位器 hud_walker（防吞键/防假通过）、锚点检查、探针/证据清单/指标估算；step_runner 与 hud_walker 的结果不替代三重确认。",
  "entry": "SKILL.md",
  "skills": [
    "SKILL.md"
  ],
  "engines": [
    "godot",
    "unity",
    "web",
    "electron",
    "desktop"
  ],
  "platforms": [
    "windows",
    "macos",
    "linux"
  ],
  "scripts": [
    "scripts/windows/Common.ps1",
    "scripts/windows/PlaytestKit.ps1",
    "scripts/windows/Capture.ps1",
    "scripts/PlaytestKit.ps1",
    "scripts/backends/web/adapter.py"
  ],
  "backends": [
    {
      "name": "windows",
      "path": "scripts/windows/PlaytestKit.ps1",
      "capture": "scripts/windows/Capture.ps1",
      "runtime": "powershell",
      "platforms": [
        "windows"
      ],
      "actions": ["launch", "close", "focus", "info", "keys", "hold", "diag", "click", "type", "scroll", "shot", "hint"],
      "unsupported": ["state", "read_text", "test_fast", "failure_snapshot"],
      "status": "reference",
      "contract": "scripts/backends/CONTRACT.md"
    },
    {
      "name": "web",
      "path": "scripts/backends/web/adapter.py",
      "runtime": "python",
      "platforms": [
        "windows",
        "macos",
        "linux"
      ],
      "actions": ["launch", "close", "focus", "info", "keys", "hold", "diag", "click", "type", "scroll", "shot", "hint", "read_text", "state"],
      "unsupported": ["test_fast", "failure_snapshot"],
      "status": "reference",
      "contract": "scripts/backends/CONTRACT.md"
    }
  ],
  "tools": {
    "dispatch": [
      "tools/backendlib.py"
    ],
    "probes": [
      "tools/probes/walkprobe.py",
      "tools/probes/holdprobe.py",
      "tools/probes/fps_probe.py",
      "tools/probes/common.py"
    ],
    "screen": [
      "tools/screen/image_ops.py",
      "tools/screen/crop_region.py"
    ],
    "evidence": [
      "tools/evidence/manifest.py"
    ],
    "metrics": [
      "tools/metrics/dsh_metrics.py"
    ],
    "tests": [
      "tools/tests/selftest.py"
    ],
    "verify": [
      "tools/verify/common.py",
      "tools/verify/hud_walker.py",
      "tools/verify/step_runner.py",
      "tools/verify/anchor_check.py",
      "tools/verify/run_verify.py",
      "tools/verify/selftest.py"
    ]
  },
  "references": [
    "scripts/backends/CONTRACT.md",
    "examples/godot-project.md",
    "templates/playtest.json",
    "references/roles/lead.md",
    "references/roles/developer.md",
    "references/roles/tester.md",
    "references/roles/recorder.md",
    "references/standards/no-cheat.md",
    "references/standards/slot-safety.md",
    "references/standards/anchors-and-saves.md",
    "references/standards/evidence-and-acceptance.md",
    "references/standards/experience-library.md",
    "references/standards/engineering-patterns.md",
    "references/standards/troubleshooting.md",
    "references/testing/playbook.md",
    "references/testing/probes-and-metrics.md",
    "references/testing/case-studies.md",
    "references/testing/efficiency.md",
    "references/testing/progress-first.md",
    "references/testing/human-ai-dual-progress.md",
    "templates/anchor-ledger.md"
  ],
  "templates": [
    "templates/playtest.json",
    "templates/tester-prompt.md",
    "templates/developer-prompt.md",
    "templates/lead-dispatch.md",
    "templates/task-tree.md",
    "templates/experience-log.md",
    "templates/bug-ledger.md",
    "templates/recorder-log.md",
    "templates/report-template.md",
    "templates/acceptance-report.md",
    "templates/acceptance-report-user.md",
    "templates/node-metrics.csv",
    "templates/defect-table.csv",
    "templates/ablation-plan.md",
    "templates/anchor-ledger.md",
    "templates/evidence-index.md"
  ],
  "examples": [
    "examples/web-app.json",
    "examples/pal98-godot.json",
    "examples/generic-desktop.json",
    "examples/pal98-walk-specs.json",
    "examples/godot-project.md"
  ],
  "install": {
    "entry": "install.ps1",
    "target": "%USERPROFILE%\\.dsh\\skills\\game-playtest",
    "options": [
      "-Target",
      "-Force",
      "-DryRun",
      "-Backup"
    ]
  },
  "conventions": {
    "playtest_schema": "templates/playtest.json",
    "playtest_schema_version": 3,
    "backend_dispatch": "tools/backendlib.py",
    "backend_output": "one JSON object per action as the LAST stdout line; exit 0 ok / 1 error / 3 unsupported",
    "input_methods": {
      "postmessage": "send window messages; no cursor hijack; apps using raw input may ignore them",
      "sendinput": "real global input; target must be foreground (input gate)",
      "cdp-input": "browser trusted events (web backend)"
    },
    "evidence_layout": {
      "dir": "evidence/",
      "shots": "evidence/shots/",
      "manifest": "evidence/manifest.json",
      "reports": "evidence/reports/",
      "failures": "evidence/failures/",
      "input_log": "evidence/input-log.jsonl"
    },
    "single_instance": true,
    "backend_contract": "scripts/backends/CONTRACT.md",
    "task_tree_doc": "_playtest_regress/task-tree.md"
  },
  "requires": {
    "python": ">=3.8",
    "powershell": ">=5.1 (windows backend only)",
    "browser": "Edge or Chrome (web backend only)",
    "os": "windows"
  },
  "selfcheck": [
    "python -B tools/tests/selftest.py",
    "python -B tools/verify/selftest.py",
    "python -B tools/verify/step_runner.py --selfcheck",
    "python -B tools/verify/hud_walker.py --selfcheck",
    "python -B tools/verify/anchor_check.py --selfcheck",
    "python -B tests/Test-WebBackend.py",
    "powershell -NoProfile -File install.ps1 -DryRun",
    "powershell -NoProfile -ExecutionPolicy Bypass -File tests/Test-Plugin.ps1",
    "powershell -NoProfile -ExecutionPolicy Bypass -File tests/Test-Backend.ps1"
  ],
  "keywords": [
    "qa",
    "acceptance",
    "blackbox",
    "playtest",
    "ui-testing",
    "app-testing",
    "web-testing",
    "cdp",
    "automation",
    "agent",
    "task-tree",
    "step-runner",
    "experience",
    "evidence",
    "engine-agnostic",
    "backend",
    "progress-first",
    "single-verdict",
    "dual-progress",
    "user-slot",
    "team-slot",
    "slot-safety",
    "input-gate"
  ],
  "license": "MIT"
}
