; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="PAL98 Godot (REA port)"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://icon.svg"

[autoload]

PALTables="*res://pal/pal_tables.gd"
PALState="*res://pal/pal_state.gd"
PALText="*res://pal/text_db.gd"
PALAudio="*res://pal/pal_audio.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=400
window/size/window_width_override=1280
window/size/window_height_override=800
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="PAL98 Godot (REA port)"

[rendering]

textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
