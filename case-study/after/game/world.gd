## R186-S77PRESSURE-1（用户曾批准遇敌过频可修）：scene68 普通可见遭遇降追击/减半。
func _apply_s68_pressure() -> void:
	if sss == null:
		return
	var idx := 0
	var kept := 0
	for eid in range(1425, 1487):
		if eid <= 0 or eid > sss.events.size():
			continue
		if not _is_encounter_event(eid):
			continue
		idx += 1
		var o: Array = sss.event(eid)
		o[PalData.EO_AUTO_SCRIPT] = 0   # 全部取消追击
		# R188：scene68 只保留 1 场普通遭遇（第3个），其余收起；Boss/剧情不受影响。
		if idx == 3:
			kept += 1
		else:
			o[PalData.EO_STATE] = 0
	_battle_dbg("[s77] pressure: encounters=%d kept=%d (no chase)" % [idx, kept])


## R183-GROUNDRESCUE-1：scene69 phase2 脚下是否为浅色路面（用于卡草救援）。
func _s69_light_cell_ok(p: Vector2i) -> bool:
	if current_map == null:
		return false
	var slot := int(current_map.call("slot_at_pixel", p.x, p.y))
	if slot < 0:
		return false
	var bid := int((current_map.get("_bottom_index") as PackedInt32Array)[slot])
	return bid in S69_LIGHT_IDS


## R182-LIGHTPATH-1：把队伍精确放到绝对坐标（用于 2出口洞外浅色路起点）。
func _snap_party_abs(p: Vector2i) -> void:
	PALState.viewport = p - PARTY_OFFSET
	_clamp_viewport()
	# R285-EXACTSNAP：视口在窄地图边缘会被 clamp；此时不能强制 party 屏幕=PARTY_OFFSET，
	# 否则绝对坐标=clampedViewport+center ≠ p（会把救援/落点又带偏）。用差值反推屏幕坐标。
	var scr := p - PALState.viewport
	for i in range(PALState.party.size()):
		PALState.party[i]["x"] = scr.x
		PALState.party[i]["y"] = scr.y
	var sp := PALState.viewport + PARTY_OFFSET
	for i2 in range(PALState.trail.size()):
		PALState.trail[i2] = {"x": sp.x, "y": sp.y, "dir": PALState.party_dir}
	_a19g_key = ""
	_a19g_dist = {}
	_redraw = true


