						if abs(xx) == 12 or yy == -16 or yy == 16:
							_img.set_pixel(sxT + xx, syT + yy, fillT)
		return
	if int(PALState.scene) != 141 or int(PALState.vars.get("a36_stage", 0)) < 1:
		return
