## round74/P11b：到位容差——17 对话为精确格(8px)，19/20/21 为触碰半径(48px，贴到即自动触发)。
func _guide_arrival_tol() -> int:
	var sc := int(PALState.scene)
	if sc == 17:
		# R77-FIX-6g：回程断桥事件 cell 本身不可走（0x003E ride），用 48 容差让反向距离场
		# 在桥边可走格播种/引导，玩家走进触发半径即自动过桥。
		if _island_return_mode():
			return 48
		return 8
	if sc == 18:
		return 8
	return 48


## round74/P11b：当前格→目标格的动态对齐提示（按游戏位移单位：x 一格=16px、y 一步=8px）。
## 例："还差 左1格、下2步"；完全同格返回 "已对齐"。
func _cell_align_text(target: Vector2i) -> String:
	var pp := abs_party()
	var dx := (target.x - pp.x) / 16
	var dy := (target.y - pp.y) / 8
	if dx == 0 and dy == 0:
		return "已对齐"
	var parts: Array = []
	if dx > 0:
		parts.append("右%d格" % dx)
	elif dx < 0:
		parts.append("左%d格" % (-dx))
	if dy > 0:
		parts.append("下%d步" % dy)
	elif dy < 0:
		parts.append("上%d步" % (-dy))
	return "还差 " + "、".join(parts)


## round74/P11：顶栏后缀——目标方向/步数/到位动作（给 17/19/20/21 用）。
func _island_floor_suffix() -> String:
	var gt := _island_guide_target()
	if gt.is_empty() or sss == null:
		return ""
	var target: Vector2i = gt["target"]
	var pp := abs_party()
	if absi(pp.x - target.x) + absi(pp.y - target.y) * 2 < _guide_arrival_tol():
		return "到位：%s" % str(gt["action"])
	var dx := target.x - pp.x
	var dy := target.y - pp.y
	var dir_txt := "东"
	if dy < 0:
		dir_txt = "东北" if dx > 0 else ("西北" if dx < 0 else "北")
	elif dy > 0:
		dir_txt = "东南" if dx > 0 else ("西南" if dx < 0 else "南")
	else:
		dir_txt = "东" if dx > 0 else "西"
	var steps := _route_path.size() if not _route_path.is_empty() else maxi(1, (absi(dx) + absi(dy) * 2) / 16)
	var align := _cell_align_text(target)
	return "目标在%s（约 %d 步）— 跟绿块 → %s｜当前→目标：%s" % [
		dir_txt, steps, str(gt["action"]), align]


## round74/P11：岛内场景通用引导（真实碰撞 BFS，两遍；蛇形/柱廊等只按可走格）。
func _update_route_hint_island() -> void:
	var gt := _island_guide_target()
	_route_group = "island"
	if gt.is_empty():
		_route_path = []
		_route18_stand = Vector2i(-1, -1)
		return
	var target: Vector2i = gt["target"]
	_guide_action = str(gt["action"])
	_route18_stand = target
	_route_markers = [target]
	var start := abs_party()
	var tol := _guide_arrival_tol()
	if absi(start.x - target.x) + absi(start.y - target.y) * 2 < tol:
		_route_path = [start]
		_route18_next_key = ""
		return
	# R77-FIX-6：反向距离场（与 _s4g 同源 walkability/步长/边界；四邻 dist 严格 -1）
	_s4g_build(start, [target], tol)
	if not _s4g_dist.has(start):
		_route_path = []
		_route18_next_key = ""
		return
	var path: Array = []
	var cur := start
	var guard := 0
	while guard < 600 and int(_s4g_dist.get(cur, 0)) > 0:
		guard += 1
		var cd := int(_s4g_dist[cur])
		var nxt := cur
		for d in [Vector2i(0, -8), Vector2i(0, 8), Vector2i(-16, 0), Vector2i(16, 0)]:
			var n2: Vector2i = cur + d
			if _s4g_dist.has(n2) and int(_s4g_dist[n2]) == cd - 1 and _s4g_walk_ok(n2.x, n2.y):
				nxt = n2
				break
		if nxt == cur:
			break
		cur = nxt
		path.append(cur)
	_route_path = path
	_route_markers = [target]
	_route_path_p = start
	_route_path_fr = Engine.get_process_frames()
	_route18_next_key = "" if path.is_empty() else _key_dir_from_step(start, path[0])
	_route18_needs_ride = false


