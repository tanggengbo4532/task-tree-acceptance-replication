	while guard < 900:
		guard += 1
		for dx in range(-48, 49, 16):
			for dy in range(-24, 25, 8):
				_s77_path_cells[Vector2i(((cur.x + dx) / 16) * 16, ((cur.y + dy) / 8) * 8)] = true
		var n0 := int(_s4g_dist.get(cur, -1))
