func _update_a5_route() -> void:
	var p := abs_party()
	_route_group = "a5"
	var cands := [Vector2i(1792, 1296), Vector2i(1824, 1328), Vector2i(1760, 1264),
		Vector2i(1824, 1360), Vector2i(1856, 1328), Vector2i(1728, 1296)]
	# RI-7l：目标候选稳定化（避免 p 移动后 first-reachable candidate 变化导致 N 基线跳变）
	if _a5_target.x < 0:
		for c in cands:
			_s4g_build(p, [c], 48)
			if _s4g_dist.has(p):
				_a5_target = c
				break
		if _a5_target.x < 0:
			_a5_target = cands[0]
	var target: Vector2i = _a5_target
	_a5g_goal = target
	_s4g_build(p, [target], 48)
	if not _s4g_dist.has(p):
		# 连通分量变化时才重选候选
		for c in cands:
			_s4g_build(p, [c], 48)
			if _s4g_dist.has(p):
				_a5_target = c
				target = c
				_a5g_goal = c
				break
	if not _s4g_dist.has(p):
		_s4g_build(p, [target], 48)
	if not _s4g_dist.has(p):
		# 轴向回退（确保 HUD 仍给可执行方向）
		_route_path = []
		_route_markers = [target]
		_a5g_key = _axis_dir_toward(p, target)
		_a5g_left = maxi(1, (absi(p.x - target.x) + absi(p.y - target.y) * 2) / 16)
		return
	_a5g_goal = target
	var cd := int(_s4g_dist[p])
	var dry := _a5_dry_run_key(p, _s4g_dist)
	var bestk := str(dry[0])
	var bestd := int(dry[1])
	if bestk != "" and bestd < cd:
		_a5g_key = bestk
		_a5g_left = cd
	else:
		# 四个键都不能使 N 严格下降 → 显示「绕行」，不显示会误导的键
		_a5g_key = ""
		_a5g_left = cd

	# PERF：路径数组用于 crumbs，按位置/时间门控重建；key/dist 每帧仍实时算
	var rebuild_path := true
	if p == _route_path_p and Engine.get_process_frames() - _route_path_fr <= 15:
		rebuild_path = false
	elif not _route_path.is_empty():
		for pc in _route_path:
			if (pc as Vector2i) == p:
				rebuild_path = false
				break
	if not rebuild_path:
		return
	var path: Array = []
	var cur := p
	var guard := 0
	while guard < 400 and int(_s4g_dist.get(cur, 0)) > 0:
		guard += 1
		var cdd := int(_s4g_dist[cur])
		var nxt := cur
		for d2 in [Vector2i(0, -8), Vector2i(0, 8), Vector2i(-16, 0), Vector2i(16, 0)]:
			var n2: Vector2i = cur + d2
			if _s4g_dist.has(n2) and int(_s4g_dist[n2]) == cdd - 1 and _s4g_walk_ok(n2.x, n2.y):
				nxt = n2
				break
		if nxt == cur:
			break
		cur = nxt
		path.append(cur)
	_route_path = path
	_route_markers = [target]
	_route_path_p = p
	_route_path_fr = Engine.get_process_frames()


