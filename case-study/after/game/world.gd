		return
	var r := 24
	var all_lines := S81_BLUE_LINES.duplicate()
	all_lines.append(S81_NEW_BLUE)
	for line in all_lines:
		for i in range(line.size() - 1):
			var a: Vector2i = line[i]
			var b: Vector2i = line[i + 1]
			var steps := maxi(1, a.distance_to(b) / 8)
			for k in range(steps + 1):
				var p := a + (b - a) * k / steps
				for dx in range(-r, r + 1, 16):
