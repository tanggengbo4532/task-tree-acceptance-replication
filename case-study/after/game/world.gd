## RI-7f：按键 → movement 位移（与 _update_movement 一致，用于 HUD 按键同源校验）
func _a5_key_delta(k: String) -> Vector2i:
	match k:
		"up":
			return Vector2i(0, -8)
		"down":
			return Vector2i(0, 8)
		"left":
			return Vector2i(-16, 0)
		"right":
			return Vector2i(16, 0)
	return Vector2i.ZERO

## RI-7g：对 4 个键做 dry-run（movement 同源 _step_walkable + 落点 field dist），
## 返回 [best_key, best_dist]；只考虑真实可走落点，不复制 movement 逻辑。
func _a5_dry_run_key(p: Vector2i, dist: Dictionary) -> Array:
	var bestk := ""
	var bestd := 1 << 30
	for k in ["up", "down", "left", "right"]:
		var d := _a5_key_delta(k)
		if d == Vector2i.ZERO:
			continue
		if not _step_walkable(p, d):
			continue
		var n: Vector2i = p + d
		if not dist.has(n):
			continue
		var nd := int(dist[n])
		if nd < bestd:
			bestd = nd
			bestk = k
	return [bestk, bestd]


## R102-STUCK-1：A19/A14 引导专用——只返回“按一次后剩余格数严格减小”的方向。
## 与 _a5_dry_run_key 的区别：绝不返回 dist 等于/大于当前格的方向（防止 HUD 在平台边缘上下横跳）。
## avoid：上一帧所在格；若回到该格不会减小（nd >= cd）则禁止，避免 83↔84 来回。
func _a19_reducing_dir(p: Vector2i, dist: Dictionary, avoid: Vector2i) -> String:
	if not dist.has(p):
		return ""
	var cd := int(dist[p])
	var best := ""
	var bestd := cd
	for k in ["up", "down", "left", "right"]:
		var d := _a5_key_delta(k)
		if d == Vector2i.ZERO:
			continue
		if not _step_walkable(p, d):
			continue
		var n: Vector2i = p + d
		if not dist.has(n):
			continue
		var nd := int(dist[n])
		if nd >= cd:
			continue
		if n == avoid and nd >= cd:
			continue
		if nd < bestd:
			bestd = nd
			best = k
	return best






func _axis_dir_toward(p: Vector2i, target: Vector2i) -> String:
	var cands: Array = []
	if absi(p.x - target.x) >= absi(p.y - target.y) * 2:
		cands = [["left" if p.x > target.x else "right", Vector2i(-16 if p.x > target.x else 16, 0)],
			["up" if p.y > target.y else "down", Vector2i(0, -8 if p.y > target.y else 8)]]
	else:
		cands = [["up" if p.y > target.y else "down", Vector2i(0, -8 if p.y > target.y else 8)],
			["left" if p.x > target.x else "right", Vector2i(-16 if p.x > target.x else 16, 0)]]
	for c in cands:
		var dv: Vector2i = c[1]
		if _s4g_walk_ok(p.x + dv.x, p.y + dv.y):
			return c[0]
	# 交叉方向（若主轴被挡）
	for c2 in [["up", Vector2i(0, -8)], ["down", Vector2i(0, 8)], ["left", Vector2i(-16, 0)], ["right", Vector2i(16, 0)]]:
		var dv2: Vector2i = c2[1]
		if _s4g_walk_ok(p.x + dv2.x, p.y + dv2.y):
			return c2[0]
	return ""


