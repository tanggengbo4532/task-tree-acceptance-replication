## 站到"回客房"门口时给提示，按空格才进入（round8 设计层修复：二次确认）。
func _scan_room_door() -> void:
	_room_door_id = 0
	# R77-A12-3：NPC/剧情交互优先时不让房间门提示覆盖（避免提示跳动）
	if _interact_id != 0:
		return
	if _arrival_blocked():
		return
	if _room_door_ids.is_empty():
		return
	var p := abs_party()
	# R77-FIX-3：目标=李大娘房门口时只允许 script47(evt50)；门选择改为最近门
	var rd_goal := _a6_guide_goal()
	var rd_want_lady := false
	if rd_goal is Dictionary and str(rd_goal.get("key", "")) == "s4_roomdoor":
		rd_want_lady = true
	var rd_best := 0
	var rd_best_metric := 1 << 30
	for id in _room_door_ids.keys():
		var o: Array = sss.event(int(id))
		var mode := int(o[PalData.EO_TRIGGER_MODE])
		if int(o[PalData.EO_STATE]) <= 0:
			continue
		var trig0 := int(_room_door_ids[id])
		if rd_want_lady and trig0 != 47:
			continue
		var metric0 := absi(p.x - int(o[PalData.EO_X])) + absi(p.y - int(o[PalData.EO_Y])) * 2
		if metric0 < (mode - 4) * 32 + 16 and metric0 < rd_best_metric:
			rd_best_metric = metric0
			rd_best = int(id)
	if rd_best != 0:
		_room_door_id = rd_best
		_room_door_trig = int(_room_door_ids[rd_best])
	if _room_door_id != 0:
		_show_room_door_hint()


## R77-EXIT-4：靠近普通换地图门 → 中央一行「按空格前往 <地图名>」，不自动切换。
func _scan_space_door() -> void:
	_space_door_id = 0
	_space_door_trig = 0
	_space_door_dest = 0
	if _space_door_ids.is_empty() or player_busy or _dialog_tail:
		return
	if _dialog_box != null and _dialog_box.is_active():
		return
	if _arrival_blocked() or _space_door_cooldown > 0:
		return
	if _interact_id != 0:
		# R87-A19BACK-2：已进入“回程门”提示圈时，只要洞内链引导生效且该门不是当前引导目标，
		# 中央提示始终让位给引导文案（不因停步而恢复；SPACE 仍有效，玩家可主动返回）。
		if _interact_kind == "space_door" and _a19_cave_guide_active() and _a19_is_back_door(_interact_id):
			var stc0: Array = _a19_cave_scene_step(int(PALState.scene))
			if stc0.size() >= 2 and int(stc0[0]) != _interact_id:
				_a19g_prompt_suppressed = true
		# R109-C3HUD-1：第3章场景同理——当前引导目标若已在显示，则其它 SPACE 门（回程门/岔路门）
		# 不再覆盖中央提示；SPACE 仍有效（玩家主动按才会走）。
		elif _interact_kind == "space_door" and _a19_c3_guide_active():
			if int(_a19g_target_evt) > 0 and int(_interact_id) != int(_a19g_target_evt):
				_a19g_prompt_suppressed = true
		return
	_a19g_prompt_suppressed = false
	var p := abs_party()
	var best := 0
	var best_metric := 1 << 30
	for id in _space_door_ids.keys():
		var d: Dictionary = _space_door_ids[id]
		var o: Array = sss.event(int(id))
		# R128-BRIDGEDOOR-1：scene50 出村石桥 evt802 改为“走过桥自动触发”，不再显示“按空格前往”提示。
		if int(PALState.scene) == 50 and int(id) == 802:
			continue
		if int(o[PalData.EO_STATE]) <= 0:
			continue
		var m := absi(p.x - int(o[PalData.EO_X])) + absi(p.y - int(o[PalData.EO_Y])) * 2
		if m < int(d["r"]) and m < best_metric:
			best_metric = m
			best = int(id)
	if best != 0:
		_space_door_id = best
		_space_door_trig = int(_space_door_ids[best]["trig"])
		_space_door_dest = int(_space_door_ids[best]["dest"])
		_interact_id = best
		_interact_trig = _space_door_trig
		_interact_prompt = "按空格前往 %s" % str(_space_door_ids[best]["name"])
		_interact_kind = "space_door"
		# R86-A19GUIDE-1：SPACE 门提示此前只写变量不显示，被引导文案每帧覆盖；
		# 现在在扫描后显式上屏（引导块在 interact_id!=0 时不再覆盖）。
		# R87-A19BACK-2：洞内链引导生效时，“回程门”（目的地==上一场景，如 scene47
		# evt750/evt746/evt748 回 scene45）不抢占中央文案——用户实测 (528,704) 去 evt754 的
		# 最短 173 步路线必经 evt750 提示圈（该小格唯一出口），旧逻辑中央被
		# 「按空格前往 蛇妖洞窟·深处」覆盖，看起来像让玩家往回走。侧门/目标门提示不受影响；
		# 回程门 SPACE 仍有效（只是不在引导期间显示提示，避免误判方向）。
		var suppress := false
		if _a19_cave_guide_active() and _a19_is_back_door(best):
			var stc: Array = _a19_cave_scene_step(int(PALState.scene))
			if stc.size() >= 2 and int(stc[0]) != best:
				suppress = true
		# R109-C3HUD-1：第3章场景里非当前引导目标的 SPACE 门（如 scene53 evt885 回白河村）不覆盖中央任务提示；
		# SPACE 仍有效，玩家主动按才会走。
		# R131-GUIDE-1：即使是“当前引导目标门”，中央也应显示任务/下一步/剩余格，不单独显示「按空格前往」；
		# 门提示只在引导文案中提到“到点按空格/走近触发”，SPACE 仍有效。
		if _a19_c3_guide_active() and int(_a19g_target_evt) > 0 and best == int(_a19g_target_evt):
			suppress = true
		elif _a19_c3_guide_active() and int(_a19g_target_evt) > 0 and best != int(_a19g_target_evt):
			suppress = true
		_a19g_prompt_suppressed = suppress
		if not suppress:
			_show_interact_hint()


