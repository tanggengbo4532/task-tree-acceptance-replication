## R241-S85TILE-1：scene85 读档/落点不在蓝笔 tile 白名单 → 救到最近可走 tile 中心。
## R284-SAFEPOS：读档/战斗结束后若队伍绝对位置落在不可走格，救援到最近可走格（不跨场景、不伪造进度）。
func _rescue_party_if_unwalkable() -> void:
	var p: Vector2i = abs_party()
	if not _is_obstacle(p.x, p.y):
		return
	var best := p
	var bestd := 1 << 30
	for rad in [8, 16, 24, 32, 48, 64, 96, 128, 192, 256]:
		for ox in range(-rad, rad + 1, 8):
			for oy in range(-rad, rad + 1, 8):
				if ox == 0 and oy == 0:
					continue
				var q := p + Vector2i(ox, oy)
				if q.x < 16 or q.y < 8 or q.x >= 2048 or q.y >= 2048:
					continue
				if _is_obstacle(q.x, q.y):
					continue
				var d := absi(ox) + absi(oy) * 2
				if d < bestd:
					bestd = d
					best = q
		if bestd < 1 << 30:
			break
	if best != p:
		_snap_party_abs(best)
		_a19g_key = ""
		print("[save] R284-SAFEPOS rescue %s -> %s scene=%d" % [str(p), str(best), int(PALState.scene)])
	else:
		print("[save] R284-SAFEPOS no walkable rescue for %s scene=%d" % [str(p), int(PALState.scene)])


func _s85_wall_rescue() -> void:
	if int(PALState.scene) != 85 or current_map == null:
		return
	var p := abs_party()
	var near_old_start := absi(p.x - S85_SAVE_START.x) + absi(p.y - S85_SAVE_START.y) * 2 <= 48
	# R257-S85REPORTRESCUE：scene89 返回 scene85 时落点可能在可走但远离复命锚点处，
	# 旧版 HUD 会 N0/等待；空闲帧救到起点分量锚点(528,568)，再由 HUD N6 走到复命点。
	var stuck_report := int(PALState.vars.get("a34_case", 0)) >= 1 \
			and int(PALState.vars.get("a34_done", 0)) < 1 \
			and int(_a19g_target_evt) in [1594, 1599] \
			and int(_a14g_left) == 0 and str(_a14g_key) == "" \
			and absi(p.x - S85_REPORT_ANCHOR.x) + absi(p.y - S85_REPORT_ANCHOR.y) * 2 > 200
	if _s85_ground_cell_ok(p) and not near_old_start and not stuck_report:
		return
	# R248-S85THR25-1：用户槽1落在 (432,1000) 墙顶/孤立旧起点；救援到最近可连通的真实街道锚点。
	var best := S85_START_ANCHOR if (near_old_start or stuck_report) else _s85_nearest_walk_pixel(p)
	if best == p:
		return
	PALState.viewport = best - PARTY_OFFSET
	_clamp_viewport()
	var abs_pos := PALState.viewport + PARTY_OFFSET
	if not _s85_ground_cell_ok(abs_pos):
		PALState.viewport = best - PARTY_OFFSET
		abs_pos = best
	for i in range(PALState.party.size()):
		PALState.party[i]["x"] = PARTY_OFFSET.x
		PALState.party[i]["y"] = PARTY_OFFSET.y
		PALState.trail[i] = {"x": abs_pos.x, "y": abs_pos.y, "dir": PALState.party_dir}
	_load_safe_pos = abs_party()
	_load_wait_move = true
	_redraw = true
	_log_exit_area("R241 S85 tile rescue -> %s" % str(abs_party()))


## round73：取最近可行走格（事件坐标在墙/水里时，以最近可行走格作为真实触发参考）
func _nearest_walkable_cell(p: Vector2i) -> Vector2i:
	if not _is_obstacle(p.x, p.y):
		return p
	var best := Vector2i(-1, -1)
	var bestd := 1 << 30
	for r in range(1, 9):
		for dx in range(-r * 16, r * 16 + 1, 16):
			for dy in range(-r * 8, r * 8 + 1, 8):
				if absi(dx) + absi(dy) * 2 != r * 16:
					continue
				var q := Vector2i(p.x + dx, p.y + dy)
				if _is_obstacle(q.x, q.y):
					continue
				var d := absi(dx) + absi(dy) * 2
				if d < bestd:
					bestd = d
					best = q
		if best.x >= 0:
			return best
	return p

## round73 第二刀：按触发脚本在当前场景内找事件 id（真实交互/出口用）
func _find_scene_event_by_script(trig: int) -> int:
	if sss == null or trig == 0:
		return 0
	for id in range(evt_start + 1, evt_end + 1):
		var o: Array = sss.event(id)
		if int(o[PalData.EO_STATE]) > 0 and int(o[PalData.EO_TRIGGER_SCRIPT]) == trig:
			return id
	return 0


