## R174-YELLOWWALK-1：生成/取得门 A（scene69 起点黄色块 → scene72 东侧洞内）的交互事件 id。
func _ensure_cave_door_a() -> int:
	if sss == null:
		return 0
	var pid := int(PALState.vars.get("cave_door_a_evt", 0))
	if pid > 0 and pid <= sss.events.size():
		_cave_door_a_evt = pid
		return pid
	if sss.events.size() <= 1359:
		return 0
	var o: Array = sss.event(1359).duplicate(true)
	o[PalData.EO_X] = 1376
	o[PalData.EO_Y] = 1168
	o[PalData.EO_STATE] = 1
	o[PalData.EO_TRIGGER_MODE] = 2
	o[PalData.EO_TRIGGER_SCRIPT] = 0
	o[PalData.EO_AUTO_SCRIPT] = 0
	sss.events.append(o)
	pid = sss.events.size()
	PALState.vars["cave_door_a_evt"] = pid
	_cave_door_a_evt = pid
	_battle_dbg("[cave] door A event id=%d at (1408,1168)" % pid)
	return pid


