## F150+F149：A6 闭环引导（场景3/4/5/6）；过场（对白/脚本/战斗）期间隐藏 HUD 与方向提示
func _update_a6_guide() -> void:
	var sc := int(PALState.scene)
	var busy := player_busy or _dialog_tail or (vm != null and vm.is_active()) or _a6_dialog_on()
	if busy:
		if _ui18 != null:
			_ui18.visible = false
		if _hint_panel != null:
			_hint_panel.visible = false
		_a6g_arrived_now = false
		return
	if sc != 2 and sc != 3 and sc != 4 and sc != 5 and sc != 6 and sc != 7 and sc != 8 and sc != 12:
		if _ui18 != null:
			_ui18.visible = false
		return
	if _hint_label == null or _hint_panel == null:
		return
	var goal := _a6_guide_goal()
	if goal.is_empty():
		if _ui18 != null:
			_ui18.visible = false
		return
	# R77-FIX-1：目标滞回 —— 新目标需连续 18 帧稳定才切换，避免 N 回升/方向翻回
	var goal_key := str(goal.get("key", "")) + "|" + str(goal.get("targets", [])) + \
		"|" + str(int(PALState.scene)) + "|" + str(bool(_hall_level))
	if goal_key != _a6g_goal_key:
		if _a6g_goal_new_key == goal_key:
			_a6g_goal_new_frames += 1
		else:
			_a6g_goal_new_key = goal_key
			_a6g_goal_new_frames = 0
		var gp_now := abs_party()
		var old_arrived := false
		if not _a6g_goal_keep.is_empty():
			old_arrived = _a6_guide_metric_to(gp_now, _a6g_goal_keep.get("targets", [])) \
				< int(_a6g_goal_keep.get("touch_r", 48))
		# R77-FIX-4：移动中不切换目标（避免行走中 N 突增）；到达旧目标/停下 18 帧后才允许切换
		if _a6g_goal_keep.is_empty() or old_arrived \
				or (_a6g_goal_new_frames >= 18 and _move_cooldown == 0):
			_a6g_goal_keep = goal.duplicate(true)
			_a6g_goal_key = goal_key
			_a6g_goal_new_key = ""
			_a6g_goal_new_frames = 0
		else:
			goal = _a6g_goal_keep
	else:
		_a6g_goal_new_key = ""
		_a6g_goal_new_frames = 0
	var p := abs_party()
	var targets: Array = goal.get("targets", [])
	if int(PALState.scene) == 4:
		_s4_guide_update(p, goal)
	elif p != _a6g_pos or _a6g_key != str(goal.get("key", "")) or not _a6g_ok:
		_a6_guide_route_update(p, goal)
	var metric := _a6_guide_metric_to(p, targets)
	var touch_r := int(goal.get("touch_r", 48))
	_a6g_arrived_now = metric < touch_r
	if _a6g_rescue:
		_refresh_scene5_hud()
		_sync_a6_crumbs(p)
		return
	var t := ""
	if metric < touch_r:
		t = str(goal.get("arrived", "已到目标"))
	elif not _a6g_ok and _a6g_dir != "":
		t = "此路不通：先往 %s 走回主路（若在楼梯夹层请按住 DOWN 下楼→到楼梯口按住 UP 长按上楼）" % _a6g_dir
	elif not _a6g_ok:
		if int(PALState.scene) == 4:
			t = "此路不通（疑似楼梯夹层/栏杆死角）：请按住 DOWN 长按下楼回大厅，再到楼梯口按住 UP 长按上楼；勿连点"
		else:
			t = "此路不通：请沿主路往「%s」方向回退/绕行（看黄点）" % _a6g_todo
	elif _a6g_stuck:
		t = "先脱困 %s（剩 %d 格）· 轻按1格" % [_a6g_dir, _a6g_left]
	else:
		t = "下一步 【%s】（剩 %d 格）· 轻按1格" % [_a6g_dir, _a6g_left]
	_a6g_text = t
	_refresh_scene5_hud()
	_sync_a6_crumbs(p)


## round76：A6 当前路线 → crumbs/边缘箭头唯一来源（消除"顶栏说A、黄点指B"）
func _sync_a6_crumbs(p: Vector2i) -> void:
	_guide_crumb_override = false
	if _a6g_rescue or (not _a6g_ok and not _a6g_stuck):
		_route_path = []
		return
	if not _a6g_dist.has(p):
		return
	var path: Array = []
	var cur := p
	var dirs := [Vector2i(0, 8), Vector2i(16, 0), Vector2i(-16, 0), Vector2i(0, -8)]
	var guard := 0
	while int(_a6g_dist.get(cur, 0)) > 0 and guard < 4000:
		guard += 1
		var best := Vector2i(0, 0)
		var bd := 1 << 30
		for d in dirs:
			var n: Vector2i = cur + d
			if not _a6g_dist.has(n):
				continue
			var nd: int = int(_a6g_dist[n])
			if nd < bd:
				bd = nd
				best = d
		if best == Vector2i(0, 0):
			break
		cur += best
		path.append(cur)
	if path.is_empty():
		_route_path = []
		return
	_route_path = path
	_route_markers = [cur]
	_route_group = "a6_guide"
	_guide_crumb_override = true


