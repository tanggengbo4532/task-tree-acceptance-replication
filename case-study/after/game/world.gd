	# 负责淡入；移植此前只在 load_scene 消费该标志 → 战后返回地图时世界层永久黑幕（仅 UI 可见，ESC 菜单
	# 打开也被 layer10 黑幕盖住）。这里等"淡出已完成 + 脚本/战斗/对白都结束（主循环真正恢复）"后淡入，
	# 保留 0x0050 的完整淡出过程；换场景路径仍由 load_scene 消费（其 alpha=1→0 语义等价）。
	if PALState.need_fade_in and not _vm_running and not player_busy \
			and (vm == null or not vm.is_active()) and not _real_battle_active \
			and _fade_alpha >= 0.999:
		PALState.need_fade_in = false
		_fade_target = 0.0
		if _fade_rect != null:
			_fade_rect.color = Color(0, 0, 0, _fade_alpha)
		_redraw = true
	# 进入场景后，等过场/剧本结束、玩家拿到操作权时再显示地点名与出口提示
	if _hint_pending and not player_busy and (vm == null or not vm.is_active()) and not _dialog_tail:
		_hint_pending = false
		_show_scene_hint()
	# round9：一楼大厅提示再补一次 —— 楼梯下行落地后走动 >=3 格、且提示条已收起时重显
	if _hint_reshow_pending and not player_busy and (vm == null or not vm.is_active()) and not _dialog_tail:
		if _hint_spawn_pos.x < 0:
			_hint_spawn_pos = abs_party()
		elif _hint_panel != null and not _hint_panel.visible:
			var hp := abs_party()
			if absi(hp.x - _hint_spawn_pos.x) + absi(hp.y - _hint_spawn_pos.y) * 2 >= 48:
				_hint_reshow_pending = false
				_show_scene_hint()
	# 寻路面包屑：定期从队伍位置 BFS 到当前退出目标，画一条安全路线（不穿过其它场景门）
	_route_timer += 1
	var route_period := 30   # round76：统一 30 帧（原 scene2 每 10 帧一次 BFS → 行走顿挫）
	if _route_timer % route_period == 0:
		_update_route_hint()
	_update_scene2_guide()
	if not _a6_guide_active():
		_update_scene4_guide()
	_update_a6_guide()
	# round76：顶栏在 A6 之后刷新 → 与中央提示同源（楼梯口 UP/DOWN 互斥）
	_floor_timer += 1
	if _floor_timer % 8 == 0:
		_update_floor_label()
	# RI-7m：A14 HUD 全局可见兜底（门/提示/对话逻辑可能隐藏 hint panel）
	if int(PALState.scene) in [5, 6, 22] and int(PALState.vars.get("a13_stage", 0)) >= 1 \
			and not player_busy and not _dialog_tail and not _a6_dialog_on() \
			and (vm == null or not vm.is_active()) and not _a6_dialog_on():
		if _hint_panel != null and _hint_label != null and _hint_label.text != "":
			_hint_panel.visible = true

	if _redraw:
		var skip_render := false
		if _auto_mode and DisplayServer.get_name() == "headless":
			# headless 长跑：只在截图窗口期渲染（其余帧跳过，提速）
			skip_render = (_auto_timer % 600) > 2
		if not skip_render:
			_render()
		_redraw = false
		_update_status()
		if _shoot_tag != "":
			var tag := _shoot_tag
			_shoot_tag = ""
			_auto_screenshot(tag)


