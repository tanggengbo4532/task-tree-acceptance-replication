## 短 BFS（含起点与终点）：from→to 精确格；pass0 避荷叶/事件，失败再 pass1（仅地图）。## 短 BFS（含起点与终点）：from→to 精确格；pass0 避荷叶/事件，失败再 pass1（仅地图）。
func _s18_bfs_cells(from_p: Vector2i, to_p: Vector2i) -> Array:
	var leaf_cells := {}
	for id in range(evt_start + 1, evt_end + 1):
		var lo: Array = sss.event(id)
		if int(lo[PalData.EO_SPRITE]) == 84 and int(lo[PalData.EO_TRIGGER_MODE]) >= 4 and int(lo[PalData.EO_STATE]) > 0:
			leaf_cells[Vector2i(int(lo[PalData.EO_X]), int(lo[PalData.EO_Y]))] = true
	var dirs := [Vector2i(16, 0), Vector2i(-16, 0), Vector2i(0, 8), Vector2i(0, -8)]
	for pass_i in range(2):
		var prev := {from_p: from_p}
		var queue: Array = [from_p]
		var head := 0
		var goal := from_p
		var found := false
		while head < queue.size() and head < 60000:
			var p: Vector2i = queue[head]
			head += 1
			if p == to_p:
				goal = p
				found = true
				break
			for d in dirs:
				var n: Vector2i = p + d
				if prev.has(n):
					continue
				if _is_obstacle_tiles(n.x, n.y):
					continue
				# task-24 R15-1：两遍都必须尊重事件阻挡（与 movement 同源）；pass0 额外避荷叶，pass1 允许踩荷叶
				if _is_obstacle(n.x, n.y):
					continue
				if pass_i == 0 and leaf_cells.has(n):
					continue
				prev[n] = p
				queue.append(n)
		if found:
			var path: Array = []
			var cur := goal
			while cur != from_p:
				path.append(cur)
				cur = prev[cur]
			path.reverse()
			path.push_front(from_p)
			return path
	return []


## task-24 R16-1：构建/刷新"任意格→最近 waypoint"多源 BFS（waypoint 为源、沿可行走格反向扩展）。
func _s18_build_wp_bfs() -> void:
	_s18_wp_dist.clear()
	_s18_wp_next.clear()
	_s18_wp_index.clear()
	var wps := _s18_light_waypoints()
	var queue: Array = []
	for i in range(wps.size()):
		var w: Vector2i = wps[i]
		_s18_wp_index[w] = i
		_s18_wp_dist[w] = 0
		queue.append(w)
	var dirs := [Vector2i(16, 0), Vector2i(-16, 0), Vector2i(0, 8), Vector2i(0, -8)]
	var head := 0
	while head < queue.size() and head < 80000:
		var p: Vector2i = queue[head]
		head += 1
		for d in dirs:
			var n: Vector2i = p + d
			if _s18_wp_dist.has(n):
				continue
			if _is_obstacle_tiles(n.x, n.y):
				continue
			if _is_obstacle(n.x, n.y):
				continue
			_s18_wp_dist[n] = int(_s18_wp_dist[p]) + 1
			_s18_wp_next[n] = p   # n 的下一格 = 朝最近 waypoint 方向
			queue.append(n)


## all_done 光点阶段：以多源 BFS 找"可达最近 waypoint"，沿其 next 链接到 waypoint，再沿 waypoint 序列到光点。
## 返回含当前格的完整路线；与 waypoint 完全不连通返回 []（调用方回退实时 BFS/等待）。
## 玩家不在 waypoint 序列上时置 `_s18_detour_active=true`（HUD 提示"绕行中，N 暂增属正常"）。
func _s18_waypoint_route(pp: Vector2i) -> Array:
	var wps := _s18_light_waypoints()
	if wps.size() < 2:
		return []
	if _s18_wp_dist.is_empty():
		_s18_build_wp_bfs()
	_s18_detour_active = false
	if not _s18_wp_dist.has(pp):
		return []
	# 沿 next 链走到最近 waypoint（可能绕行；waypoint 点本身 dist=0）
	var path: Array = [pp]
	var cur: Vector2i = pp
	var guard := 0
	while int(_s18_wp_dist.get(cur, 0)) > 0 and guard < 4000:
		guard += 1
		if not _s18_wp_next.has(cur):
			return []
		cur = _s18_wp_next[cur]
		path.append(cur)
	if not _s18_wp_index.has(cur):
		return []
	var wi: int = int(_s18_wp_index[cur])
	if path.size() > 1:
		_s18_detour_active = true   # 需要绕行回主路线
	for k in range(wi + 1, wps.size()):
		path.append(wps[k])
	# 全路径逐格校验（与 movement 单一判定源）；有不可走步则放弃（回退实时 BFS）
	for i in range(1, path.size()):
		if not _s18_step_allowed(path[i - 1] as Vector2i, path[i] as Vector2i):
			return []
	return path



## 下一座未打碎石像：返回 [sid, stand, approach, all_done]；all_done 时 stand=隐藏光点。
func _scene18_next_target() -> Array:
	for sid in SCENE18_ORDER:
		var o: Array = sss.event(sid)
		if int(o[PalData.EO_STATE]) > 0:
			var sp: Vector2i = SCENE18_STELES[sid]
			# round74/P10b：目标=「使用格」=(石像x+16, 石像y+8)（石像右下 1 格）。
			# 0x0081 判定容差 48：站在使用格朝左(←)即可用锤成功；不必再往左踩进石像正下方格
			# （该格可能是荷叶 0x0044 触发格 → 会滑走导致死循环）。
			return [sid, sp + Vector2i(16, 8), sp + Vector2i(32, 8), false]
	return [0, Vector2i(1024, 912), Vector2i(1024, 912), true]


## 供顶栏文案用的轻量信息（不做 BFS）。
func _scene18_route_info() -> Dictionary:
	var t := _scene18_next_target()
	var stand: Vector2i = t[1]
	var sid := int(t[0])
	var pp := abs_party()
	var dx := stand.x - pp.x
	var dy := stand.y - pp.y
	var dir_txt := "东"
	if dy < 0:
		dir_txt = "东北" if dx > 0 else ("西北" if dx < 0 else "北")
	elif dy > 0:
		dir_txt = "东南" if dx > 0 else ("西南" if dx < 0 else "南")
	else:
		dir_txt = "东" if dx > 0 else "西"
	var steps := maxi(1, (absi(dx) + absi(dy) * 2) / 16)
	# round75/task-20 F-R3-1：路线缓存失效条件=目标变化/缓存为空/**当前队伍不在缓存路线上**（偏移/骑乘后）。
	# 在路线上时按 idx 直接算剩余步数（不重算 BFS）；失效时**同步重算真实 BFS**（walkability 同源 _is_obstacle）。
	# 禁止用直线估算作为"下一步"依据（直线仅作无路线时距离提示，key 一律由真实路线决定）。
	var on_path := false
	if _route18_stand == stand and not _route_path.is_empty():
		var idx := _route_idx_of(pp)
		if idx >= 0:
			on_path = true
			steps = maxi(1, _route_path.size() - idx)
		elif _s18_step_allowed(pp, _route_path[0]):
			on_path = true   # island/16 路径从"下一格"开始，也算在路线上
			steps = maxi(1, _route_path.size())
	var need_replan := _route_path.is_empty() or not on_path or _route18_stand != stand
	# R76-STUTTER-2：重规划冷却（顶栏 7.5Hz 刷新不再触发全图 BFS）
	if need_replan and Engine.get_process_frames() - _route18_replan_frame >= 15 \
			and not (player_busy or (vm != null and vm.is_active())):
		if int(PALState.scene) == 18:
			_route18_replan_frame = Engine.get_process_frames()
			_update_route_hint_scene18()
		elif int(PALState.scene) == 17 or int(PALState.scene) == 19 or int(PALState.scene) == 20 or int(PALState.scene) == 21:
			_route18_replan_frame = Engine.get_process_frames()
			_update_route_hint_island()
	if _route18_stand == stand and not _route_path.is_empty():
		var idx2 := _route_idx_of(abs_party())
		if idx2 >= 0:
			steps = maxi(1, _route_path.size() - idx2)
	_s18_diag_tick()
	return {"sid": sid, "stand": stand, "dir_txt": dir_txt, "steps": steps, "all_done": bool(t[3])}


func _update_route_hint_scene18() -> void:
	_route_group = "exit18"
	var t := _scene18_next_target()
	var stand: Vector2i = t[1]
	var approach: Vector2i = t[2]
	_route18_stand = stand
	_route_markers = [stand]
	var start := abs_party()
	if _s18_blocked_at != start:
		_s18_blocked_at = start
		_s18_blocked_dirs.clear()
	_s18_guide_stuck_tick(start)
	_route18_from = start
	_route18_goal = stand
	var goal_metric := 16 if bool(t[3]) else 8
	# task-29：石像段必须真正站上使用格才算到位（阈值 metric<=8）；光点段保留 40（触发半径 16）
	var near_eps := 40 if bool(t[3]) else 8
	if absi(start.x - stand.x) + absi(start.y - stand.y) * 2 <= near_eps:
		_route_path = [start]
		return
	# task-29：防振荡——同一格被反复重规划且距离不降 → 清空被挡方向学习，ring(16) 重算一次
	if start == _s18_osc_pos:
		_s18_osc_count += 1
	else:
		_s18_osc_pos = start
		_s18_osc_count = 0
	if _s18_osc_count >= 6:
		_s18_osc_count = 0
		_s18_blocked_dirs.clear()
		if not bool(t[3]):
			goal_metric = 16
	if approach == stand:
		approach = stand
	var dirs := [Vector2i(16, 0), Vector2i(-16, 0), Vector2i(0, 8), Vector2i(0, -8)]
	# 荷叶 0x0044 触发格（sprite 84、mode>=4、state>0 的事件所在格；踩上会自动滑行）
	var leaf_cells := {}
	for id in range(evt_start + 1, evt_end + 1):
		var lo: Array = sss.event(id)
		if int(lo[PalData.EO_SPRITE]) == 84 and int(lo[PalData.EO_TRIGGER_MODE]) >= 4 and int(lo[PalData.EO_STATE]) > 0:
			leaf_cells[Vector2i(int(lo[PalData.EO_X]), int(lo[PalData.EO_Y]))] = true
	_route18_needs_ride = false
	# R20-A/R21：石像段（6 座未破前）—— 反向距离场唯一来源（任意落点/长按均严格递减，不翻转）
	if not bool(t[3]):
		var stone_path := _s18_stone_path(start, stand)
		if not stone_path.is_empty():
			_route_path = stone_path
			_route18_from = start
			_route18_goal = stand
			_route18_needs_ride = false
			for cell in stone_path:
				if leaf_cells.has(cell):
					_route18_needs_ride = true
					break
			return
		# R21：无路→等待（**不回退旧 BFS**，旧 BFS 会在 live 差异处反向振荡）
		_route_path = []
		_route18_from = start
		_route18_goal = stand
		return
	# task-24：all_done 光点阶段 —— waypoint 预校验路线优先（HUD 下一步必可走、N=剩余格数）
	if bool(t[3]):
		var wp_path := _s18_waypoint_route(start)
		if not wp_path.is_empty():
			_route_path = wp_path
			_route18_from = start
			_route18_goal = stand
			return
	for pass_i in range(2):
		var prev := {start: start}
		var queue: Array = [start]
		var head := 0
		var goal := start
		var found := false
		while head < queue.size() and head < 60000:
			var p: Vector2i = queue[head]
			head += 1
			if absi(p.x - stand.x) + absi(p.y - stand.y) * 2 <= goal_metric:
				goal = p
				found = true
				break
			for d in dirs:
				var n: Vector2i = p + d
				if prev.has(n):
					continue
				# task-22b：BFS 扩展与移动层同一判定源（含地图边界/事件阻挡/**实测被挡方向**）
				if not _s18_step_allowed(p, n):
					continue
				if pass_i == 0 and leaf_cells.has(n):
					continue   # pass0 优先不踩荷叶；pass1 允许踩荷叶滑行（游戏机制）
				prev[n] = p
				queue.append(n)
		if found:
			var path: Array = []
			var cur := goal
			while cur != start:
				path.append(cur)
				cur = prev[cur]
			path.reverse()
			# round75/task-20 F-R3-1：缓存路线**包含起点**（否则"当前是否在路线上"永远为假→每帧重规划/HUD 距离跳变）
			path.push_front(start)
			# task-21：路线经过荷叶格 → 标记"本段要踩荷叶滑行"（顶栏提前提示；滑行中由 busy 分支暂停引导）
			_route18_needs_ride = false
			for cell in path:
				if leaf_cells.has(cell):
					_route18_needs_ride = true
					break
			_route_path = path
			return


## task-22b：引导卡住看门狗——HUD 已给出"下一步方向"但玩家位置连续 ~2s 没有变化（且非 busy/剧情），
## 视为该方向实测无效：登记被挡方向并作废路线（下次自动重规划绕行）；四向全无效时自然变成"等待"。
func _s18_guide_stuck_tick(pp: Vector2i) -> void:
	if player_busy or (vm != null and vm.is_active()):
		_s18_stuck_frames = 0
		_s18_stuck_pos = pp
		return
	if _route_path.is_empty() or _route18_stand.x < 0:
		_s18_stuck_frames = 0
		_s18_stuck_pos = pp
		return
	if Engine.get_process_frames() - _s18_last_dir_frame > 60:
		# 玩家最近 1 秒内没按方向键（只是站着读 HUD）→ 不算"按了不动"，不登记被挡
		_s18_stuck_frames = 0
		_s18_stuck_pos = pp
		return
	if pp != _s18_stuck_pos:
		_s18_stuck_pos = pp
		_s18_stuck_frames = 0
		return
	_s18_stuck_frames += 1
	if _s18_stuck_frames < 120:
		return
	_s18_stuck_frames = 0
	# task-26：直接用缓存路线的下一格，避免 _route18_next_point→_update_route_hint_scene18 的递归风险
	var np := Vector2i(-1, -1)
	for i in range(_route_path.size()):
		if (_route_path[i] as Vector2i) == pp and i + 1 < _route_path.size():
			np = _route_path[i + 1]
			break
	if np.x < 0 or np == pp:
		return
	_s18_note_step_blocked(np)
	_route_path = []
	if _debug_hud:
		print("[t22] stuck watchdog: pos=%s blocked next=%s" % [str(pp), str(np)])
	_route_path = []


## round74/P11：岛内场景（17/19/20/21）分阶段引导目标。返回 {"target":Vector2i,"action":String}
## R77-FIX-6：岛链回程模式（已取得紫金丹 item273>0）——引导走回码头/乘船回余杭镇方向。
func _island_return_mode() -> bool:
	return int(PALState.get_item_amount(273)) > 0


func _island_guide_target() -> Dictionary:
	var sc := int(PALState.scene)
	# R77-FIX-6：已取紫金丹 → 回程目标（storylayer 场景链接/事件数据）
	if _island_return_mode():
		match sc:
			21:
				return {"target": Vector2i(480, 1536), "action": "出宫门（回水月宫前）"}
			20:
				return {"target": Vector2i(224, 1120), "action": "离开水月宫前（回断桥）"}
			17:
				# 回程过断桥：桥事件 evt217(1744,1096) 触发 0x003E ride 自动过桥。
				# 玩家在右侧(x>900)→先上桥；过桥到左侧→回石阵出口 evt211(240,856)。
				if abs_party().x > 900:
					return {"target": Vector2i(1744, 1096), "action": "上断桥（自动过桥动画）"}
				return {"target": Vector2i(240, 856), "action": "过桥回石阵（回密林）"}
			19:
				return {"target": Vector2i(512, 1184), "action": "回密林（码头方向）"}
			18:
				return {"target": Vector2i(512, 1184), "action": "回密林（码头方向）"}
			16:
				return {"target": Vector2i(352, 1696), "action": "回仙灵岛码头"}
			15:
				return {"target": Vector2i(704, 832), "action": "与船夫对话（乘船回余杭镇）"}

	match sc:
		19:
			return {"target": Vector2i(1872, 488), "action": "碰触出口"}
		20:
			return {"target": Vector2i(1088, 592), "action": "碰触入口"}
		21:
			return {"target": Vector2i(1152, 944), "action": "接近灵儿"}
		17:
			if sss == null:
				return {"target": Vector2i(1088, 1424), "action": "ENTER 对话"}
			var trap := int(sss.event(217)[PalData.EO_STATE])
			var light := int(sss.event(214)[PalData.EO_STATE])
			if trap > 0 and light == 0:
