	if not _space_door_ids.has(door_id):
		return false
	return int((_space_door_ids[door_id] as Dictionary).get("dest", 0)) == prev


func _a19_guide_to_event(evt_id: int) -> void:
	if sss == null or evt_id <= 0 or evt_id > sss.events.size():
		_a14g_key = ""
		return
	_ensure_walk_blocked()
	var p := abs_party()
	# R109-C3HUD-1：记录当前引导目标，供“回程门提示让位”判断。
	_a19g_target_evt = evt_id
	# R102-STUCK-1：记录上一格，方向选择时禁止立即走回（除非回走会减小 N）。
	var came_from: Vector2i = _a19g_prev_p
	_a19g_prev_p = p
	var key := "%d|%d|%d|%d|%d|%s" % [int(PALState.scene), evt_id, int(_walk_blocked_scene),
		int(_walk_blocked_frame), 1 if _hall_level else 0, str(_guide_crumb_override)]
	if key != _a19g_key:
		_a19g_key = key
		_a19_guide_rebuild(evt_id)
		_a19g_last_p = p
		_a19g_prev_p = p
	if _a19g_fb:
		# 绕行模式：玩家每移动一格重算一次（兜底 BFS 有 cap，且通常只在被隔断的小区域里发生）
		if p != _a19g_last_p:
			_a19g_last_p = p
			var o2: Array = sss.event(evt_id)
			var d2 := _script_scene_targets(int(o2[PalData.EO_TRIGGER_SCRIPT]))
			var nd2 := int(d2[0]) if not d2.is_empty() else 0
			var fb2 := _a19_find_reachable_door(p, nd2)
			if fb2.is_empty():
				_a19g_fb = false
			else:
				_a19g_fb_dir = str(fb2["dir"])
				_a19g_fb_left = int(fb2["left"])
				_a19g_fb_id = int(fb2["id"])
		if _a19g_fb:
			if _a19g_fb_dir == "":
				_a19g_cd0 = true
				_a14g_key = ""
				_a14g_left = 0
			else:
				_a19g_cd0 = false
				_a14g_key = _a19g_fb_dir
				_a14g_left = _a19g_fb_left
			return
	if _a19g_dist.is_empty() or not _a19g_dist.has(p):
		# 主目标场里没有玩家当前格：先按旧缓存清空方向，重建一次后再决定（R98-BLACK-1：
		# 黑区不可走后目标可能真的不可达，此时绝不能给“朝目标的直线方向”误导玩家走进黑区）。
		_a14g_key = ""
		_a14g_left = 0
		_a19g_cd0 = false
		_a19_guide_rebuild(evt_id)
		_a19g_last_p = p
		if _a19g_fb:
			if _a19g_fb_dir == "":
				_a19g_cd0 = true
				_a14g_key = ""
				_a14g_left = 0
			else:
				_a14g_key = _a19g_fb_dir
				_a14g_left = _a19g_fb_left
		elif _a19g_dist.is_empty() or not _a19g_dist.has(p):
			# 主目标不可达且没有可绕行门：HUD 显示“等待/绕行中”（见 _build_merged_guide），不给方向。
			_a14g_key = ""
			_a14g_left = 0
		else:
			var cd_rb := int(_a19g_dist[p])
			_a14g_left = cd_rb
			if cd_rb <= 0:
				_a14g_key = ""
			else:
				var dir_rb := _a19_reducing_dir(p, _a19g_dist, came_from)
				if dir_rb == "":
					_a14g_key = ""
				else:
					_a14g_key = dir_rb
		return
	var cd := int(_a19g_dist[p])
	_a19g_cd0 = cd <= 0
	_a14g_left = cd
	if cd <= 0:
		_a14g_key = ""
		return
	# R102-STUCK-1：方向必须让 N 严格减小；禁止 83↔84 上下横跳。
	var dir := _a19_reducing_dir(p, _a19g_dist, came_from)
	if dir != "":
		_a14g_key = dir
		return
	# 当前位置四方向都不能减小：只对当前位置重建一次距离场再试；仍无则显示“等待/绕行中”，
	# 绝不回退到“朝目标的直线方向”（那可能指黑区/导致横跳）。
	if _a19g_nodir_pos != p:
		_a19_guide_rebuild(evt_id)
		_a19g_nodir_pos = p
		_a19g_last_p = p
		if _a19g_dist.has(p):
			cd = int(_a19g_dist[p])
			_a14g_left = cd
			_a19g_cd0 = cd <= 0
			dir = _a19_reducing_dir(p, _a19g_dist, came_from)
			if dir != "":
				_a14g_key = dir
				return
	_a14g_key = ""


