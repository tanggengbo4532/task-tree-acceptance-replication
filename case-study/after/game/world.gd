## R120-WATER-1：队伍若正好落在开放水域（水面底图且无桥面 overlay），救回最近“主陆地连通分量”的可走地砖。
## 只在“当前格确实是开放水域”时触发；桥/码头/浅滩（top overlay）与普通陆地不受影响。
## 不能只选最近可走格：河中小岛/水边死格会让人落在与主线不连通的孤岛（HUD 无方向），所以按最大连通分量选岸。
func _water_stuck_rescue() -> void:
	if current_map == null:
		return
	var p := abs_party()
	if not current_map.is_open_water_at(p.x, p.y):
		return
	var w := current_map.map_pixel_width()
	var h := current_map.map_pixel_height()
	# 标注全部可走格点的连通分量（x16/y8 与移动步长一致）
	var comp: Dictionary = {}
	var sizes: Dictionary = {}
	var cid := 0
	var x := 16
	while x < w:
		var y := 8
		while y < h:
			var q := Vector2i(x, y)
			if not comp.has(q) and not _is_obstacle(x, y):
				cid += 1
				comp[q] = cid
				var ql: Array = [q]
				var head := 0
				var cnt := 0
				while head < ql.size():
					var c: Vector2i = ql[head]
					head += 1
					cnt += 1
					for dd in [Vector2i(0, 8), Vector2i(0, -8), Vector2i(16, 0), Vector2i(-16, 0)]:
						var n: Vector2i = c + dd
						if n.x < 16 or n.y < 8 or n.x >= w or n.y >= h:
							continue
						if comp.has(n):
							continue
						if _is_obstacle(n.x, n.y):
							continue
						comp[n] = cid
						ql.append(n)
				sizes[cid] = cnt
			y += 8
		x += 16
	if sizes.is_empty():
		return
	var best_cid := -1
	var best_size := -1
	for k in sizes.keys():
		var sz := int(sizes[k])
		if sz > best_size:
			best_size = sz
			best_cid = int(k)
	var best := Vector2i(-1, -1)
	var best_d := 1 << 30
	for qk in comp.keys():
		if int(comp[qk]) != best_cid:
			continue
		var q: Vector2i = qk
		var d := absi(q.x - p.x) + absi(q.y - p.y) * 2
		if d < best_d:
			best_d = d
			best = q
	if best.x < 0:
		return
	PALState.viewport = best - PARTY_OFFSET
	_clamp_viewport()
	print("[water] R120-WATER-1 rescue from open water %s -> %s scene=%d comp=%d size=%d" % [
		str(p), str(best), int(PALState.scene), best_cid, best_size])


func _r99_boss_exit_rescue() -> void:
	if int(PALState.scene) != 48 or sss == null or sss.events.size() <= 761:
		return
	if int(sss.event(761)[PalData.EO_STATE]) > 0:
		return   # boss 未打完：正常流程，不救援
	if current_map == null:
		return
	var p := abs_party()
	var goal_o: Array = sss.event(759)
	var goal := Vector2i(int(goal_o[PalData.EO_X]), int(goal_o[PalData.EO_Y]))
	_ensure_walk_blocked()
	var prev := {p: p}
	var q: Array = [p]
	var head := 0
	var connected := false
	while head < q.size() and head < 400000:
		var c: Vector2i = q[head]
		head += 1
		if absi(c.x - goal.x) + absi(c.y - goal.y) * 2 < 16:
			connected = true
			break
		for d in [Vector2i(0, 8), Vector2i(0, -8), Vector2i(16, 0), Vector2i(-16, 0)]:
			var dd: Vector2i = d
			var nn: Vector2i = c + dd
			if prev.has(nn):
				continue
			if not _walk_target_ok(c, dd):
				continue
			prev[nn] = c
			q.append(nn)
	if connected:
		return
	script_party_position(14, 59, 0)
	_position_scripted = false
	_redraw = true
	_log_auto("R99-BOSS-EXIT rescue scene48: %s -> (448,944)（战后岛与 evt759 石门不连通）" % str(p))
	print("[battle] R99-BOSS-EXIT rescue %s -> (448,944)" % str(p))


