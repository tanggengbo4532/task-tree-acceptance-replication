	var n := 0
	var i := 1
	# 每 2 格点一次（点本身 2×2，视觉上接近连续），长路线（街道→村道 ~110 格）也能画到出口
	while i < _route_path.size() and n < 120:
		var p: Vector2i = _route_path[i]
		var sx: int = p.x - vp.x
		var sy: int = p.y - vp.y
		if sx >= 2 and sy >= 2 and sx < SCREEN_W - 3 and sy < SCREEN_H - 3:
			# PERF：一次 fill_rect 代替 4 次 set_pixel（scene5/6 长路线每帧 ~480 次 GDScript 调用）
			_img.fill_rect(Rect2i(sx, sy, 2, 2), dot)
		i += 1 if int(PALState.scene) == 2 else 2
		n += 1
	# round74/P6：场景16 靠近出口时画黄框+箭头（站在 (1792,944) 附近即进 evt205 触发圈）
	# round74/P9b：场景18 —— 青色目标框（目标位置）+ **黄色"下一步按键方向"箭头**（严格=下一步该按的键）。
