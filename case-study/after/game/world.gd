## 0x000A 是/否：异步（ScriptVM → waiting_choice → vm.resume_choice）
## VM 优先找 confirm_menu()（同步）；这里只提供 request_confirm()，强制走异步路径。
func request_confirm() -> void:
	if _auto_mode:
		_log_auto("CONFIRM_MENU -> yes (auto)")
		await get_tree().create_timer(0.3).timeout
		_finish_confirm(true)
		return
	if ResourceLoader.exists("res://game/menu.gd") and load("res://game/menu.gd") != null:
		var menu_script = load("res://game/menu.gd")
		if menu_script == null:
			_finish_confirm(true)
			return
		var m = menu_script.new()
		_mode_node = m
		add_child(m)
		# R242-CONFIRMTOP-1：脚本 0x000A 选择框（PalMenu CanvasLayer 默认 layer5）会被
		# _ui（layer10，对白/头像）盖住；选择框必须放最上层，保证可见可选。
		m.layer = 20
		player_busy = true
		m.choice_made.connect(Callable(self, "_on_confirm_choice"), CONNECT_ONE_SHOT)
		m.closed.connect(Callable(self, "_on_confirm_closed"), CONNECT_ONE_SHOT)
		m.setup_confirm("")
		return
	if _dialog_box != null and _dialog_box.has_method("show_choice"):
		var yes: bool = await _dialog_box.show_choice()
		_finish_confirm(yes)
		return
	_finish_confirm(true)


func _on_confirm_choice(yes: bool) -> void:
	_finish_confirm(yes)


func _on_confirm_closed() -> void:
	if _mode_node != null:
		_mode_node.queue_free()
		_mode_node = null
	player_busy = false
	_redraw = true


func _finish_confirm(yes: bool) -> void:
	_log_auto("CONFIRM_MENU -> %s" % ("yes" if yes else "no"))
	if vm != null and vm.is_active() and vm.has_method("resume_choice"):
		vm.resume_choice(yes)
	elif vm != null and vm.is_active() and vm.waiting_dialog:
		vm.advance_dialog()
	_redraw = true


func request_ending() -> void:
	script_end_game()


## task-26：退出/崩溃取证——写 user://quit_trace.log（供 tester 实机退出后取证）
func _write_quit_trace(reason: String) -> void:
	var f := FileAccess.open("user://quit_trace.log", FileAccess.WRITE)
	if f == null:
		return
	f.store_string("time=%s\nreason=%s\nscene=%d\npos=%s\nbusy=%s\nvm_active=%s\n" % [
		Time.get_datetime_string_from_system(), reason, int(PALState.scene), str(abs_party()),
		str(player_busy), str(vm != null and vm.is_active())])
	if vm != null:
		var rep: Dictionary = vm.get_report()
		f.store_string("vm_entry=%s vm_ip=%s ended=%s stack=%s unknown_ops=%s missing_hooks=%s\n" % [
			str(rep.get("entry", "")), str(rep.get("ip", "")), str(rep.get("ended", "")),
			str(rep.get("stack_depth", "")), str(rep.get("unknown_ops", {})), str(rep.get("missing_hooks", {}))])
	f.close()
	print("[quit-trace] written user://quit_trace.log reason=%s scene=%d" % [reason, int(PALState.scene)])


func request_quit_game() -> void:
	_write_quit_trace("script 0x00A0 quit_game")
	get_tree().quit()


func _notification(what: int) -> void:
	if what == NOTIFICATION_WM_CLOSE_REQUEST:
		_write_quit_trace("window close request")
		get_tree().quit()


## 0x0037 RNG 完整播放：播放完成后恢复 VM
func request_rng_full(rng_id: int, start_frame: int, frames: int, speed: int) -> void:
	PALState.current_rng = rng_id
	if not ResourceLoader.exists("res://pal/rng_player.gd"):
		_log_auto("RNG %d 播放器未就绪（跳过）" % rng_id)
		call_deferred("_rng_done")
		return
	# R76-CUTSCENE-2：覆盖 _rng 前先彻底释放旧实例/孤儿（否则旧 RNG 会继续画全屏特效）
	_free_all_rng_players()
	var r = load("res://pal/rng_player.gd").new()
	_rng = r
	add_child(r)
	if r.has_signal("finished"):
		r.finished.connect(Callable(self, "_rng_done"), CONNECT_ONE_SHOT)
	if r.has_method("play_full"):
		r.play_full(rng_id, start_frame, frames, speed)
	else:
		r.play(rng_id)
	# 兜底：若播放器没有 finished 信号，最多等 frames 帧后恢复
	if not r.has_signal("finished"):
		await get_tree().create_timer(0.5).timeout
		_rng_done()


## R76-CUTSCENE-1：统一清理过场动画/遮罩/残帧（RNG 播放器/颜色 fade/对话框/提示）。
## reset_fade=true 时把黑幕 alpha 归零（场景已可正常显示）；false 只清叠加层，保留 need_fade_in 的淡入。
## R76-CUTSCENE-2：清理所有 RngPlayer 实例（含被覆盖后遗留的孤儿节点，防止全屏过场特效残留）
func _free_all_rng_players() -> void:
	if _rng != null:
		if is_instance_valid(_rng):
			if _rng.has_method("stop"):
				_rng.call("stop")
			_rng.queue_free()
		_rng = null
	var tree := get_tree()
	if tree != null:
		var nodes := tree.get_nodes_in_group("rng_player")
		for n in nodes:
			if is_instance_valid(n):
				if n.has_method("stop"):
					n.call("stop")
				n.queue_free()
	PALState.current_rng = -1


func _clear_cutscene_visuals(reset_fade: bool) -> void:
	_free_all_rng_players()
	_color_fade_frames = 0
	_color_fade_total = 0
	_color_fade_restore = false
	_color_fade_color = Color(0, 0, 0, 1)
	if reset_fade and not PALState.need_fade_in:
		_fade_alpha = 0.0
		_fade_target = 0.0
		if _fade_rect != null:
			_fade_rect.color = Color(0, 0, 0, 0)
	if _dialog_panel != null:
		_dialog_panel.visible = false
	if _dialog_box != null and _dialog_box.has_method("clear"):
		_dialog_box.clear()
	if _hint_panel != null:
		_hint_panel.visible = false
	if _floor_label != null:
		_floor_label.visible = false


func _rng_done() -> void:
	# R76-CUTSCENE-2：统一回收（含孤儿；避免 finished 回调误释放新实例/老实例残留在树上）
	_free_all_rng_players()
	if vm != null and vm.is_active() and vm.has_method("resume_rng"):
		vm.resume_rng()
	_redraw = true


