## R163-BATTLEGUARD-3：墙钟时间战后宽限（flee 10s / win 5s），宽限内拒绝任何“遭遇战”，
## 剧情战/Boss（flee_disabled=true 或来源不是 encounter）豁免。返回 {blocked,...}。
func battle_guard_check(team_id: int, src_evt: int = 0, flee_disabled: bool = false) -> Dictionary:
	var now_ms := Time.get_ticks_msec()
	var in_grace: bool = now_ms < _battle_guard_until_ms \
		and (_last_battle_result == "flee" or _last_battle_result == "win")
	var is_enc := false
	if src_evt > 0:
		is_enc = _is_encounter_event(src_evt)
	# R172-ESCAPEGUARD-1（用户口述逃跑后同点再战）：宽限内**所有非 Boss/非不可逃战斗**都拒绝，
	# 不再依赖来源事件是否被 `_is_encounter_event` 识别（固定陷阱/自动脚本可能漏判）。
	if not flee_disabled:
		is_enc = true
	var blocked: bool = in_grace and not flee_disabled
	var info := {
		"blocked": blocked,
		"team": team_id,
		"src_evt": src_evt,
		"is_encounter": is_enc,
		"flee_disabled": flee_disabled,
		"last_team": _last_battle_team,
		"last_evt": _last_battle_evt,
		"result": _last_battle_result,
		"age_ms": now_ms - _last_battle_frame if _last_battle_frame > 0 else -1,
		"guard_until_ms": _battle_guard_until_ms,
	}
	if blocked:
		_battle_dbg("[battle-entry] guard_check BLOCKED from=world.check team=%d src_evt=%d enc=%s flee_disabled=%s last_team=%d result=%s age_ms=%d" % [
			team_id, src_evt, str(is_enc), str(flee_disabled), _last_battle_team, _last_battle_result, int(info["age_ms"])])
	else:
		_battle_dbg("[battle-entry] guard_check PASS from=world.check team=%d src_evt=%d enc=%s flee_disabled=%s last_team=%d result=%s age_ms=%d" % [
			team_id, src_evt, str(is_enc), str(flee_disabled), _last_battle_team, _last_battle_result, int(info["age_ms"])])
	return info


## R163-BATTLEGUARD-3：记录被拒来源并清场。宽限内把所有当前场景遭遇事件 state=0/vanish/auto=0，
## 防止相邻遭遇（team 交替）或同一事件被自动脚本重新 arm。
func battle_guard_mark_blocked(team_id: int, src_evt: int = 0, why: String = "") -> void:
	var st := get_stack()
	var stack_txt := ""
	for i in range(mini(5, st.size())):
		stack_txt += str(st[i].get("function", "?")) + " <- "
	_battle_dbg("[battleguard] blocked re-entry from=%s team=%d src_evt=%d last_team=%d result=%s age_ms=%d stack=%s" % [
		why, team_id, src_evt, _last_battle_team, _last_battle_result,
		Time.get_ticks_msec() - _last_battle_frame, stack_txt])
	_clear_encounter_events_during_guard()


## R163-BATTLEGUARD-3：宽限内在场景层把所有遭遇事件隐藏并停 auto，防 re-arm/相邻队。
func _clear_encounter_events_during_guard() -> void:
	if sss == null:
		return
	# R164-GUARDRESTORE-1：第一次清场时保存原 state/auto，宽限到期后恢复；重复清场不覆盖快照。
	if _guard_event_backup.is_empty():
		var b := 0
		for eid in range(evt_start + 1, evt_end + 1):
			if not _is_encounter_event(eid):
				continue
			var ob: Array = sss.event(eid)
			_guard_event_backup[eid] = [int(ob[PalData.EO_STATE]), int(ob[PalData.EO_AUTO_SCRIPT]),
				int(ob[PalData.EO_VANISH])]
			b += 1
		if b > 0:
			_battle_dbg("[battleguard] backed up %d encounter events in scene %d" % [b, int(PALState.scene)])
	var n := 0
	for eid in range(evt_start + 1, evt_end + 1):
		if not _is_encounter_event(eid):
			continue
		var o: Array = sss.event(eid)
		o[PalData.EO_VANISH] = maxi(600, int(o[PalData.EO_VANISH]))
		o[PalData.EO_STATE] = 0
		o[PalData.EO_AUTO_SCRIPT] = 0
		n += 1
	if n > 0:
		_battle_dbg("[battleguard] cleared %d encounter events in scene %d (temporary, restore after guard)" % [n, int(PALState.scene)])


## R164-GUARDRESTORE-1：墙钟宽限到期后恢复被临时清场的遭遇事件（state/auto），
## 让该图遇敌在 10s/5s 后正常回来，而不是永久消失。
func _restore_encounter_events_after_guard() -> void:
	if _guard_event_backup.is_empty():
		return
	if Time.get_ticks_msec() < _battle_guard_until_ms:
		return
	var n := 0
	for eid in _guard_event_backup.keys():
		if sss == null or int(eid) <= 0 or int(eid) >= sss.events.size():
			continue
		var o: Array = sss.event(int(eid))
		var info: Array = _guard_event_backup[eid]
		o[PalData.EO_STATE] = int(info[0])
		o[PalData.EO_AUTO_SCRIPT] = int(info[1])
		o[PalData.EO_VANISH] = 0
		n += 1
	_guard_event_backup.clear()
	if int(PALState.scene) == 77:
		# R188：宽限恢复后立刻重新施加 scene77 普通遭遇压制，防止备份把10场全部恢复。
		_apply_s77_pressure()
	_battle_dbg("[battleguard] restored %d encounter events after guard (scene %d)" % [n, int(PALState.scene)])


func request_battle(team_id: int, flee_disabled: bool = false) -> bool:
	# round73 去作弊清理：删除 _auto_mode 强制胜利 / _no_battle 跳过战斗 / force_win 自动判胜；
	# 正常玩法与自动长跑都必须真实打完整场战斗（结果只由战斗系统决定）。
	# R161-BATTLEGUARD-1：所有触发路径的唯一收口点做战后宽限；不依赖 event id/轮询路径。
	var src_evt := 0
	if vm != null:
		var _le = vm.get("last_event_object_id")
		if _le != null:
			src_evt = int(_le)
		if src_evt <= 0:
			var _ve = vm.get("_evt_id")
			if _ve != null:
				src_evt = int(_ve)
	_battle_dbg("[battle-entry] from=request_battle team=%d flee_disabled=%s src_evt=%d" % [team_id, flee_disabled, src_evt])
	var g := battle_guard_check(team_id, src_evt, flee_disabled)
	if bool(g.get("blocked", false)):
		battle_guard_mark_blocked(team_id, src_evt, "request_battle")
		PALState.in_battle = false
		return false
	battle_requested.emit(team_id)
	_log_auto("BATTLE team=%d flee_disabled=%s" % [team_id, flee_disabled])
	# R157-BATTLERESET-1：GameOver 读档后重进同一遭遇时，先清掉旧战斗节点/战斗标记，
	# 避免两个战斗实例叠加（输入落到旧实例、指令阶段看似卡死）。
	if _mode_node != null:
		_log_auto("BATTLERESET free stale battle node")
		_mode_node.queue_free()
		_mode_node = null
	_real_battle_active = false
	player_busy = false
	_dialog_tail = false
	if not ResourceLoader.exists("res://game/battle.gd"):
		push_warning("World: 战斗模块 game/battle.gd 尚未就绪，跳过战斗（按胜利继续）")
		call_deferred("on_battle_finished", "win")
		return true
	var battle_script = load("res://game/battle.gd")
	if battle_script == null:
		push_warning("World: battle.gd 编译失败，跳过战斗（按胜利继续）")
		call_deferred("on_battle_finished", "win")
		return true
	var b = battle_script.new()
	b.setup(team_id, flee_disabled)
	b.finished.connect(Callable(self, "on_battle_finished"))
	_mode_node = b
	_real_battle_active = true
	add_child(b)
	player_busy = true
	if _auto_mode and b.has_method("set_auto_battle"):
		b.set_auto_battle()
	if vm != null and vm.has_method("set_battle_proxy"):
		vm.set_battle_proxy(b)
	return true


func on_battle_finished(result: String) -> void:
	# R147-A33DONE-1：女飞贼战斗（evt1630/脚本13834，team29）结束（胜/败均按真实剧情继续）→ 记 a33_stage=1。
	if vm != null and sss != null:
		var a33_evt := int(vm.last_event_object_id)
		if a33_evt == 1630 or a33_evt == 1760:
			PALState.vars["a33_stage"] = 1
			_log_auto("A33 battle done evt=%d result=%s" % [a33_evt, result])
	# R136-FLEEGUARD-1：逃跑成功后同一触发事件进入保护期（3s + 必须离开原触发圈），
	# 防止玩家原地按 SPACE/走一步立即再次触发同一场战斗（tester r135 BLOCKED 死循环）。
	if result == "flee" and vm != null:
		var fevt := int(vm.last_event_object_id)
		_flee_guard_all_until = Engine.get_process_frames() + 600
		if fevt > 0 and sss != null and fevt < sss.events.size():
			var feo: Array = sss.event(fevt)
			# R159-FLEECOOLDOWN-1：逃跑后给遭遇事件一个可见 vanish（约5s）+ 10s 遭遇跳过窗口；
			# a2 的 0x4B 清场在 R136 的 force_finish 前可能来不及执行，这里显式清场，保证不会 2 步再战。
			feo[PalData.EO_VANISH] = maxi(300, int(feo[PalData.EO_VANISH]))
			_flee_guard_evt = fevt
			_flee_guard_until = Engine.get_process_frames() + 600
			_flee_guard_ring = maxi(96, _a19_evt_ring(feo) + 32)
			_log_auto("FLEEGUARD evt=%d ring=%d until=%d all_until=%d" % [fevt, _flee_guard_ring, _flee_guard_until, _flee_guard_all_until])
	# R159-FLEECOOLDOWN-1：胜利后遭遇怪也给可见 vanish（约5s），避免原地/两步内重生再战；
	# 剧情战/固定 Boss 不受影响（只对遭遇事件生效）。
	if result == "win" and vm != null and sss != null:
		var wevt := int(vm.last_event_object_id)
		if wevt > 0 and wevt < sss.events.size() and _is_encounter_event(wevt):
			var weo: Array = sss.event(wevt)
			weo[PalData.EO_VANISH] = maxi(300, int(weo[PalData.EO_VANISH]))
			# R159-FLEECOOLDOWN-2：胜利后也给 5s 全遭遇冷却（含旁边怪），避免 100 步内战斗过密。
			_flee_guard_all_until = maxi(_flee_guard_all_until, Engine.get_process_frames() + 300)
			_log_auto("WINVANISH evt=%d vanish=%d all_until=%d" % [wevt, int(weo[PalData.EO_VANISH]), _flee_guard_all_until])
	# R75-GAME1：胜利/逃跑后该怪物延长 vanish + 追逐冷却（给玩家离开/调整的时间；仅调参场景）
	if (result == "win" or result == "flee") and int(PALState.scene) == int(DesignTuning.CHASE["scene"]):
		var evt_id := 0
		if vm != null:
			evt_id = int(vm.last_event_object_id)
		if evt_id > 0 and evt_id < sss.events.size():
			var eo: Array = sss.event(evt_id)
			eo[PalData.EO_VANISH] = int(DesignTuning.CHASE["post_battle_vanish"])
			_chase_pause[evt_id] = int(DesignTuning.CHASE["post_battle_vanish"])
			_chase_miss.erase(evt_id)
			_chase_returning.erase(evt_id)
			_log_auto("GAME1 chase cooldown evt=%d vanish=%d" % [evt_id, int(DesignTuning.CHASE["post_battle_vanish"])])
		_scene_doors_dirty = true
	if _mode_node != null:
		_mode_node.queue_free()
		_mode_node = null
	_real_battle_active = false
	player_busy = false
	_dialog_panel.visible = false
	_redraw = true
	_log_auto("BATTLE_RESULT %s" % result)
	# R161-BATTLEGUARD-1：记录上一场结果/队伍/来源/时间；逃跑 10s、胜利 5s 内同队/同来源拒绝重开战。
	_last_battle_result = result
	_last_battle_team = int(PALState.vars.get("battle_team", 0))
	_last_battle_frame = Time.get_ticks_msec()
	_last_battle_evt = int(vm.last_event_object_id) if vm != null else 0
	_battle_guard_until = 0
	if result == "flee":
		_battle_guard_until_ms = _last_battle_frame + BATTLE_GUARD_FLEE_MS
		_clear_encounter_events_during_guard()
	elif result == "win":
		_battle_guard_until_ms = _last_battle_frame + BATTLE_GUARD_WIN_MS
		_clear_encounter_events_during_guard()
	else:
		_battle_guard_until_ms = 0
	# task-71：A13 剧情战失败 → 恢复到战前快照（房间麻布袋旁，a12=1/a13=0），可再次 SPACE 重试；
	# 不执行脚本失败分支（不回滚 A12/不回大厅），也不伪造胜利。
	if result == "lose" and _a13_battle_pending:
		_a13_battle_pending = false
		var snap: Dictionary = _a13_battle_snapshot.duplicate(true)
		_a13_battle_snapshot = {}
		_force_end_script()
		PALState.in_battle = false
		if not snap.is_empty():
			PALState.vars = (snap["vars"] as Dictionary).duplicate(true)
			PALState.roles = (snap["roles"] as Dictionary).duplicate(true)
			PALState.party = (snap["party"] as Array).duplicate(true)
			load_scene(2, false)
			var spos: Vector2i = snap["pos"]
			script_party_position(int(spos.x) / 32, int(spos.y) / 16, 0)
		else:
			load_scene(2, false)
			script_party_position(40, 16, 0)
		_a13_cloth_started = false
		_a13_auto_fired = false
		_a13_last_scene = -1
		_show_a13_goal("战斗失败：已回到战前（房间麻布袋旁），按空格查看麻布袋可重新挑战")
		_log_exit_area("A13 battle lose -> restored pre-battle pos=%s a12=%s a13=%s" % [
			str(abs_party()), str(PALState.vars.get("a12_stage", 0)),
			str(PALState.vars.get("a13_stage", 0))])
		return
	if vm != null and vm.is_active() and vm.has_method("resume_battle"):
		vm.resume_battle(result)
	# R264-SCRIPTLOSE-1：脚本战（0x0007）失败后 VM 继续跑败后剧情时，不能把 lose 留给全灭兜底；
	# 只有“无脚本/脚本已结束”的随机战败才 GameOver。清结果并加保护帧。
	if result == "lose" and vm != null and vm.is_active():
		_last_battle_result = ""
		_load_safe_frames = maxi(_load_safe_frames, 240)
		_a36_scripted_loss = true
		_log_auto("SCRIPTED-LOSE continue vm entry=%d ip=%d" % [int(vm.entry), int(vm.ip)])
	# R136-FLEEUNLOCK-1：逃跑后必须立即恢复世界移动。部分遭遇脚本没有 flee 分支/收尾等待，
	# resume_battle 后 VM 可能仍 active/等待中被静默挂起 → _update_movement 每帧被 VM 清输入，
	# 表现为四方向原地冻结（ESC 仍可开菜单）。这里对 flee 强制收尾并清输入/等待锁。
	if result == "flee":
		if vm != null and vm.is_active():
			if vm.has_method("force_finish"):
				vm.force_finish()
			else:
				vm.ended = true
			vm.waiting_battle = false
		_dialog_tail = false
		player_busy = false
		_wait_release = false
		_held_dirs.clear()
		_pending_move_dir = -1
		_search_lock = 0
		PALState.in_battle = false
		_real_battle_active = false
		_redraw = true
		_log_auto("FLEEUNLOCK scene=%d pos=%s" % [int(PALState.scene), str(abs_party())])
	_rescue_party_if_unwalkable()
	if result == "lose" and not (vm != null and vm.is_active()):
		_game_over()


