func _is_obstacle(x: int, y: int) -> bool:
	# R299-S189REPLACE：用户确认 scene189 只用其蓝层可走集（替换原可走）；起点锚点已补
	if int(PALState.scene) == 189:
		return not _s189_user_route_ok(Vector2i(x, y))
	# R212-S81MOVE-1：scene81 白名单在碰撞最前生效（否则 native 墙/void 先返回 true，角色走不动）。
	if int(PALState.scene) == 81 and _s81_restrict_scene == 81:
		return not _s81_ground_cell_ok(Vector2i(x, y))
	# R241-S85TILE-1：scene85 按用户蓝笔 tile 白名单（移动/HUD 同源）。
	if int(PALState.scene) == 85:
		return not _s85_ground_cell_ok(Vector2i(x, y))
	# R282：用户三场景路线可走集（替换；非并集）
	if int(PALState.scene) in [106, 109, 118]:
		return not _scene_route_ground_cell_ok(int(PALState.scene), Vector2i(x, y))
	# R285-S141WATER：map130 蜀山外景底部 tile206 是湖水/空区，不属于可走地面；
	# 原版阻挡数据缺失导致角色可站水面（用户截图）。按真实画面把206判为不可走。
	if int(PALState.scene) == 141 and current_map != null:
		var slot141 := _s85_slot_at_pixel(x, y)
		if slot141 >= 0:
			var bidx = current_map.get("_bottom_index")
			if bidx is PackedInt32Array and slot141 < bidx.size() and int(bidx[slot141]) in [0, 206]:
				return true
	# 这里显式限制大厅可行走矩形，避免 A14 引导/玩家走进黑区）。
	if int(PALState.scene) == 4 and _hall_level and _stair_anim_kind == "":
		if x < 600 or x > 1456 or y < 1560 or y > 1840:
			return true
	# round73/A62 场景16 最小真实通路补数据：原版数据里"15→18→16 落点区(约674格)"与主区仅隔
	# (368,1640) 一格不可走；诊断（bridge16 探针）确认开这一格即可连通，无传送/宽区域。
	if int(PALState.scene) == 16 and x == 368 and y == 1640:
		return false
	# R292-USER-WIDEN：神木林 A44 窄道入口用户要求放宽1格；(1088,1448) 原底层tile150，
	# 只开放这一格与现有通路形成2格宽入口，不开放水/void/墙，不改变其余碰撞。
	if int(PALState.scene) == 185 and ((x == 1088 and y == 1448) or (x == 1056 and y == 1440)):
		return false
	# R295：用户蓝笔路线（206格）全部作为可走；移动/HUD同源
	if int(PALState.scene) == 185 and _s185_user_route_ok(Vector2i(x, y)):
		return false
	# F153：场景4 不做整段 y 区间阻挡（1F/2F 区域在 map10 中 y 范围重叠，会误伤 A59 回廊）；
	# 改为"楼梯动画脚本结束后归一标准落点 + 夹层 SPACE 自救"（见 _stair_anim_kind / _a6g_rescue）。

	if _no_collision:
		return false
	if _s69_restrict_scene == int(PALState.scene):
		if not _s69_path_cells.has(Vector2i(x, y)):
			return true
		# R182-LIGHTPATH-1（用户规则）：phase2 出洞后只走浅色土路面 tile；绿草/竹林不可走。
		if int(PALState.vars.get("a30_s69_phase", 0)) >= 2:
			var slot_l := int(current_map.call("slot_at_pixel", x, y))
			if slot_l < 0:
				return true
			var bid_l := int((current_map.get("_bottom_index") as PackedInt32Array)[slot_l])
			if bid_l not in S69_LIGHT_IDS:
				return true
		return false
	if _s77_restrict_scene == int(PALState.scene) and not _s77_ground_cell_ok(Vector2i(x, y)):
		return true
	if _s68_restrict_scene == int(PALState.scene) and not _s68_ground_cell_ok(Vector2i(x, y)):
		return true
	if _s79_restrict_scene == int(PALState.scene) and not _s79_ground_cell_ok(Vector2i(x, y)):
		return true
	if _s81_restrict_scene == int(PALState.scene) and not _s81_ground_cell_ok(Vector2i(x, y)):
		return true
	if _s84_restrict_scene == int(PALState.scene) and not _s84_ground_cell_ok(Vector2i(x, y)):
		return true
	if _s80_restrict_scene == int(PALState.scene) and not _s80_ground_cell_ok(Vector2i(x, y)):
		return true
	if _s83_restrict_scene == int(PALState.scene) and not _s83_ground_cell_ok(Vector2i(x, y)):
		return true
	if _s70_restrict_scene == int(PALState.scene):
		# 用户红线路径走廊内视为可走（这是用户批准的真实可行路面；走廊外全部不可走）。
		return not _s70_path_cells.has(Vector2i(x, y))
	# R174-YELLOWWALK-1：map61（scene69）/map64（scene72）只允许黄色土路/洞内石土地面可走；
	# 草丛/void/水/非土路格一律不可走。
	if _yellow_restrict_scene == int(PALState.scene) and not _is_yellow_cell_ok(x, y):
		return true
	var tx: int = x / 32
	var ty: int = y / 16
	var h := 0
	var xr: int = x % 32
	var yr: int = y % 16
	if xr + yr * 2 >= 16:
		if xr + yr * 2 >= 48:
			tx += 1
			ty += 1
		elif 32 - xr + yr * 2 < 16:
			tx += 1
		elif 32 - xr + yr * 2 < 48:
			h = 1
		else:
			ty += 1
	if current_map.is_blocked(tx, ty, h):
		return true
	# P0-PERF-2：事件障碍走缓存（每场景/120 帧重建一次），避免 BFS 每格遍历全部事件
	_ensure_walk_blocked()
	return _walk_blocked_cells.has(Vector2i(x, y))


## R76-EXIT-1：该事件是否为"纯换场景门"（脚本前几条就 0x0059，且没有对白/ride/移动）
## 纯门才做半径 48 上限与到达保护；"船边上船(ride+dialog+0x0059)"这类非纯门保留原半径，否则会无法触发。
## R77-EXIT-4：普通纯换地图门脚本判定（只含位置/淡入淡出/音乐 + 0x0059；无对话/ride/状态/道具/战斗）
## R77-EXIT-5：真脚本强制切换（ride 0x003E/0x003F、战斗 0x0007）→ 保持自动，不加 SPACE。
func _is_forced_scene_change_script(trig: int) -> bool:
	if sss == null or trig <= 0:
		return false
	var n_ops := int(sss.scripts.size() / 4)
	for k in range(trig, mini(trig + 400, n_ops)):
		var q: PackedInt32Array = sss.script_entry(k)
		if q.size() < 4:
			break
		var op := int(q[0])
		if op == 0x0000:
			break
		if op == 0x003E or op == 0x003F or op == 0x0007:
			return true
	return false


func _is_ordinary_scene_door_script(trig: int) -> bool:
	if sss == null or trig <= 0:
		return false
	var n_ops := int(sss.scripts.size() / 4)
	if trig >= n_ops:
		return false
	var allow := {0x0000: true, 0x0001: true, 0x0005: true, 0x0013: true, 0x0043: true,
		0x0047: true, 0x0046: true, 0x0050: true, 0x0051: true, 0x0059: true, 0x006D: true}
	var n_scene := 0
	for k in range(trig, mini(trig + 80, n_ops)):
		var q: PackedInt32Array = sss.script_entry(k)
		if q.size() < 4:
			break
		var op := int(q[0])
		if op == 0x0000:
			break
		if not allow.has(op):
			return false
		if op == 0x0059:
			n_scene += 1
	return n_scene >= 1


## R77-EXIT-4：枚举本场景普通换地图门（关自动 touch，改 SPACE 提示）。
## 排除：房间门（已有 SPACE 系统）、楼梯、STORY_GATES、以及既有 explicit 交互门（A4 大厅门等）。
func _refresh_space_doors() -> void:
	_space_door_ids.clear()
	_auto_touch_block_ids.clear()
	_space_door_id = 0
	_space_door_trig = 0
	_space_door_dest = 0
	if sss == null or int(PALState.scene) < 2:
		return
	var sc := int(PALState.scene)
	# 既有 explicit 交互门（A4 大厅门/s2 门/街道门/船）：touch 也一律屏蔽自动切换，
	# 但提示交给原专用系统（避免 A4 未对话提前放行等语义变化）。
	var explicit := {45: true, 95: true, 4: true, 117: true, 47: true, 48: true}
	for id in range(evt_start + 1, evt_end + 1):
		var o: Array = sss.event(id)
		var mode := int(o[PalData.EO_TRIGGER_MODE])
		if mode < 4 or int(o[PalData.EO_STATE]) <= 0:
			continue
		var trig := int(o[PalData.EO_TRIGGER_SCRIPT])
		if trig == 0:
			continue
		var targets := _script_scene_targets(trig)
		if targets.is_empty():
			continue
		if _stair_gate_kind(id) != "":
			continue
		# ride/battle 强制切换保持自动
		if _is_forced_scene_change_script(trig):
			continue
		# 其它一切 touch 场景切换：屏蔽自动切换
		_auto_touch_block_ids[id] = true
		if _room_door_ids.has(id) or explicit.has(id):
			continue
		if STORY_GATES.has(sc) and (STORY_GATES[sc] as Dictionary).has(id):
			continue
		var dest := int(targets[0])
		_space_door_ids[id] = {"trig": trig, "dest": dest,
			"name": _location_name(dest), "r": mini(112, (mode - 4) * 32 + 16)}
	_log_exit_area("SPACE_DOORS scene=%d prompt=%s block=%s" % [
		sc, str(_space_door_ids.keys()), str(_auto_touch_block_ids.keys())])


func _is_pure_scene_door(id: int) -> bool:
	if _is_scene_door_id(id) == false:
		return false
	var trig := _a6_evt_trig(id)
	if trig <= 0:
		return false
	for k in range(trig, mini(trig + 6, sss.scripts.size() / 4)):
		var q: PackedInt32Array = sss.script_entry(k)
		if q.size() < 4:
			break
		var op := int(q[0])
		if op == 0x0059:
			return true
		if op == 0xFFFF or op == 0x003B or op == 0x003C or op == 0x003D or op == 0x003E \
				or op == 0x003F or op == 0x0044 or op == 0x0070 or op == 0x007A or op == 0x007B \
				or op == 0x0010 or op == 0x0011 or op == 0x0046:
			return false
		if op == 0x0000 or op == 0x0001:
			return false
	return false


## R76-EXIT-1：该事件是否为"换场景门"（_scene_door_positions）
func _is_scene_door_id(id: int) -> bool:
	for d in _scene_door_positions:
		if int(d["id"]) == id:
			return true
	return false


## R76-EXIT-1：记录到达位置，并把当前正踩着的 mode>=4 触发加入"暂忽略"集合（离开后解除）
## R77-FIX-1：读档宽限：前 20 帧 + 玩家首次方向输入前，不触发 touch/auto 事件
func _load_grace_active() -> bool:
	if _load_wait_move:
		return true
	return Engine.get_process_frames() < _load_grace_until


func _arm_arrival_guard(frames: int) -> void:
	_arrive_pos = abs_party()
	_arrive_guard_until = Engine.get_process_frames() + frames
	_arrive_skip_events.clear()
	if sss == null or current_map == null:
		return
	var p := _arrive_pos
	for id in range(evt_start + 1, evt_end + 1):
		var o: Array = sss.event(id)
		var mode := int(o[PalData.EO_TRIGGER_MODE])
		if mode < 4 or int(o[PalData.EO_STATE]) <= 0:
			continue
		var r := (mode - 4) * 32 + 16
		if absi(p.x - int(o[PalData.EO_X])) + absi(p.y - int(o[PalData.EO_Y])) * 2 < r + 8:
			_arrive_skip_events[id] = r


## R76-EXIT-1：到达保护期内（且未离开原触发区）跳过场景切换类触发
func _arrival_blocked() -> bool:
	if Engine.get_process_frames() >= _arrive_guard_until:
		return false
	if _arrive_pos.x < 0:
		return false
	var p := abs_party()
	return absi(p.x - _arrive_pos.x) + absi(p.y - _arrive_pos.y) * 2 < 48


## R159-FLEECOOLDOWN-1：判断事件是否为“遭遇/追击类”事件（触发脚本含 0x0007 战斗或 auto 含 0x004C 追击）。
## 结果按场景缓存；只用于逃跑后的短窗口跳过，不改变事件数据/剧情门/移动。
func _is_encounter_event(id: int) -> bool:
	if sss == null or id <= 0 or id >= sss.events.size():
		return false
	var sc := int(PALState.scene)
	if _encounter_ids_scene != sc or _encounter_ids_cache.is_empty():
		_encounter_ids_scene = sc
		_encounter_ids_cache.clear()
		var n_ops := int(sss.scripts.size() / 4)
		for eid in range(evt_start + 1, evt_end + 1):
			var o: Array = sss.event(eid)
			var bases: Array = [int(o[PalData.EO_TRIGGER_SCRIPT]), int(o[PalData.EO_AUTO_SCRIPT])]
			var found := false
			for b in bases:
				if int(b) <= 0:
					continue
				for k in range(int(b), mini(int(b) + 400, n_ops)):
					var q: PackedInt32Array = sss.script_entry(k)
					if q.size() < 4:
						break
					var op := int(q[0])
					if op == 0x0007 or op == 0x004C:
						found = true
						break
					if op == 0x0000:
						break
				if found:
					break
			if found:
				_encounter_ids_cache[eid] = true
	return _encounter_ids_cache.has(id)


func _check_touch_triggers() -> void:
	_restore_real_door_events()
	# R77-FIX-1：读档宽限内不触发任何 touch/门/楼梯事件
	if _load_grace_active():
		return
	# R77-FIX-3：读档出生安全区内禁用一切 touch；离开 96px 后恢复
	# R85-DEADLOCK：若玩家被读档残留的追击怪占位包围、连续按方向仍无法移动（_no_move_frames≥10），
	# 解除安全区与跳过集合，让真实 touch 战斗/事件触发（不传送、不伪造）。
	if _load_safe_radius > 0:
		var sp9 := abs_party()
		if absi(sp9.x - _load_safe_pos.x) + absi(sp9.y - _load_safe_pos.y) * 2 < _load_safe_radius:
			# 站在真实门/楼梯触发圈内且玩家已按住方向 → 解除安全抑制（仍走真实事件判定）
			if _held_dir(true) or _held_dir(false) or _no_move_frames >= 10:
				_load_safe_radius = 0
				_load_skip_events.clear()
			else:
				return
		else:
			_load_safe_radius = 0
	var p := abs_party()
	# R77-FIX-3：读档出生点附近 touch 事件：半径内跳过，离开后恢复
	if not _load_skip_events.is_empty():
		var lsp := abs_party()
		for sid1 in _load_skip_events.keys():
			var eo1: Array = sss.event(int(sid1))
			var rr1 := int(_load_skip_events[sid1])
			var dd1 := absi(lsp.x - int(eo1[PalData.EO_X])) + absi(lsp.y - int(eo1[PalData.EO_Y])) * 2
	# 到达保护结束且已离开落点 → 解除全部"暂忽略"（保证反向回门口能触发）
	if Engine.get_process_frames() >= _arrive_guard_until and not _arrive_skip_events.is_empty():
		if absi(p.x - _arrive_pos.x) + absi(p.y - _arrive_pos.y) * 2 > 16:
			_arrive_skip_events.clear()
	for id in range(evt_start + 1, evt_end + 1):
		var o: Array = sss.event(id)
		var mode := int(o[PalData.EO_TRIGGER_MODE])
		var state := int(o[PalData.EO_STATE])
		var vanish := int(o[PalData.EO_VANISH])
		# play.c:87-94：vanish 计时中的事件本帧不触发（计时在 _update_event_updates 里推进）
		if vanish != 0:
			continue
		# play.c:96-107：state==0 隐藏 / state<0 已消灭待重生：均不触发
		if state <= 0:
			continue
		# play.c:107：仅 mode >= kTriggerTouchNear(4) 的事件做触碰判定（<4 走 SPACE 搜索）
		if mode < 4:
			continue
		# R159-FLEECOOLDOWN-1：逃跑后 10s 脱战窗口内跳过所有遭遇/追击事件（含旁边同队怪），
		# 只跳过遭遇，不冻结移动、不影响剧情门。
		if Time.get_ticks_msec() < _battle_guard_until_ms and _is_encounter_event(id):
			continue
		# R136-FLEEGUARD-1：逃跑成功后同一战斗事件保护（3s 且必须离开原触发圈），防原地立即重触发。
		if id == _flee_guard_evt:
			var fgd := absi(p.x - int(o[PalData.EO_X])) + absi(p.y - int(o[PalData.EO_Y])) * 2
			if Engine.get_process_frames() < _flee_guard_until or fgd < _flee_guard_ring:
				continue
			_flee_guard_evt = 0
		# round74/④：读档瞬间一次性跳过（仅此一次，不放宽半径/不改事件状态）
		if _touch_skip_once.has(id):
			_touch_skip_once.erase(id)
			continue
		# round8：一楼"回客房/回廊"门不再触碰即传送，改为按空格进入（见 _scan_room_door）
		if _room_door_ids.has(id):
			continue
		# R128-BRIDGEDOOR-1：scene50 出村石桥 evt802 恢复原版“走过桥触发”——玩家踩上桥面/走进触发圈即切 scene55；
		# 其它 touch 场景门仍按 R77-EXIT-5 屏蔽自动切（避免误触）。读档安全/到达保护仍生效。
		var bridge_touch_door := int(PALState.scene) == 50 and id == 802
		if not bridge_touch_door and (_auto_touch_block_ids.has(id) or _space_door_ids.has(id)):
			continue
		# round13：一楼李大娘前置闲聊只播一次（否则长按序列/多轮流程被反复打断）
		var lidan_once := int(PALState.scene) == 4 and int(o[PalData.EO_SPRITE]) == 21
		if lidan_once and bool(PALState.vars.get("lidan_hall_talk_done", false)):
			continue
		# round9：楼梯触发改为方向判定（按住对应方向才触发，半径放宽 + 冷却）
		# R77-FIX-3：读档出生点附近事件：在半径内跳过，离开后恢复
		# R85-DEADLOCK：玩家连续无法移动（被追击怪占位包围）时解除跳过，允许真实 touch 战斗触发。
		if _load_skip_events.has(id):
			var sk_p := abs_party()
			var sk_d := absi(sk_p.x - int(o[PalData.EO_X])) + absi(sk_p.y - int(o[PalData.EO_Y])) * 2
			if sk_d < int(_load_skip_events[id]) + 8:
				if _no_move_frames < 10:
					continue
			_load_skip_events.erase(id)
		var stair_kind := _stair_gate_kind(id)
		if stair_kind != "":
			# R77-FIX-3：仅当 A6 目标=李大娘房门口(s4_roomdoor) 时禁用楼梯触发（防 2F 引导↓误下楼）；
			# 其它目标（含楼梯引导）保持正常上下楼，避免误伤 P1 楼梯长按。
			var sg_goal := _a6_guide_goal()
			if sg_goal is Dictionary and str(sg_goal.get("key", "")) == "s4_roomdoor":
				continue
			if _stair_cooldown > 0 or not _held_dir(stair_kind == "up"):
				continue
			# R77-FIX-2：楼梯触发半径按引导目标条件扩张（默认 40；仅当当前引导目标=楼梯时 80/112）。
			# P0-1 根因：无条件 80 会让“去李大娘房门”的走廊路径落入楼梯触发圈，按 ↑ 被楼梯脚本瞬移。
			var stair_r: int = 40
			var gg := _a6_guide_goal()
			if gg is Dictionary:
				var gkey := str(gg.get("key", ""))
				if gkey.begins_with("s4_upstairs") or gkey.begins_with("a11_inn_upstairs") \
						or gkey.find("stairs") >= 0 or gkey.find("_up") >= 0:
					stair_r = 80
			if absi(p.x - int(o[PalData.EO_X])) + absi(p.y - int(o[PalData.EO_Y])) * 2 < stair_r:
				var s_entry := int(o[PalData.EO_TRIGGER_SCRIPT])
				if s_entry != 0:
					_stair_cooldown = 45
					_wait_release = true   # round13：楼梯动画结束后等松键再走
					# round13：楼梯下行/上行切换"楼层状态"（场景4 内部分 2F 回廊/1F 大厅），
					# 并让出口区域/引导在动画结束后按新楼层重新计算。
					if int(PALState.scene) == 4:
						_hall_level = (stair_kind == "down")
						_stair_anim_kind = stair_kind   # F153：脚本结束后归一落点
						_exit_area_scene = -1
					if _auto_mode:
						_auto_used[id] = true
					# R144-STAIR94-1：scene94 客栈上楼（35655）后标记 a33_stairs，HUD 再指 evt1728。
					if int(PALState.scene) == 94 and s_entry == 35655:
						PALState.vars["a33_stairs"] = 1
					_log_exit_area("STAIR trigger scene=%d id=%d script=%d dir=%s hall=%s pos=%s" % [
						PALState.scene, id, s_entry, stair_kind, str(_hall_level), str(p)])
					_start_script(s_entry, id)
					_redraw = true
					return
			continue
		var touch_r := (mode - 4) * 32 + 16
		# R76-EXIT-1：换场景门体验修正——(a) 到达后 45 帧内完全忽略场景门；(b) 场景门触发半径上限 48（原版 mode7=112 过大）
		var is_story_gate := false
		if STORY_GATES.has(int(PALState.scene)) and (STORY_GATES[int(PALState.scene)] as Dictionary).has(id):
			is_story_gate = true
		if _is_pure_scene_door(id) and not is_story_gate:
			if Engine.get_process_frames() < _arrive_guard_until:
				continue
			touch_r = mini(touch_r, 48)
		# R76-EXIT-1：刚进场景时正踩在内的触发先忽略，直到玩家离开其半径+8（防按方向键立刻回上一张图）
		if _arrive_skip_events.has(id):
			if _held_dir(true) or _held_dir(false):
				_arrive_skip_events.erase(id)
			elif absi(p.x - int(o[PalData.EO_X])) + absi(p.y - int(o[PalData.EO_Y])) * 2 >= int(_arrive_skip_events[id]) + 8:
				_arrive_skip_events.erase(id)
			else:
				continue
		# F150：A6 大厅门口优先级——房间两事件完成后，苗人头领 evt60(1070) 与店门 evt45 可能同帧在半径内；
		# 原版苗人挡在门口传话；这里跳过"换场景门"触发，让 evt60 的 1070 先播（不改半径/数据）。
		if int(PALState.scene) == 4 and id != 60 and _a6_evt_trig(60) == 1070 \
				and _a6_evt_state(36) == 0 and _a6_evt_trig(37) != 964 and _a6_evt_trig(37) != 0:
			var e60p := _a6_evt_xy(60)
			var near60 := absi(p.x - e60p.x) + absi(p.y - e60p.y) * 2 < 80
			var is_door := false
			for dd in _scene_door_positions:
				if int(dd["id"]) == id:
					is_door = true
					break
			if near60 and is_door:
				continue
		if absi(p.x - int(o[PalData.EO_X])) + absi(p.y - int(o[PalData.EO_Y])) * 2 < touch_r:
			var entry := int(o[PalData.EO_TRIGGER_SCRIPT])
			if entry == 0:
				continue
			# play.c:120-148：多帧精灵事件被触发时复位帧并面向队伍（PAL_UpdatePartyGestures(FALSE) 等价）
			if int(o[PalData.EO_FRAMES]) > 0:
				o[PalData.EO_CUR_FRAME] = 0
				var xo := p.x - int(o[PalData.EO_X])
				var yo := p.y - int(o[PalData.EO_Y])
				if xo > 0:
					o[PalData.EO_DIRECTION] = DIR_EAST if yo > 0 else DIR_NORTH
				else:
					o[PalData.EO_DIRECTION] = DIR_SOUTH if yo > 0 else DIR_WEST
				for l in range(PALState.max_party_member_index + 1):
					PALState.party[l]["frame"] = PALState.party_dir * 3
				_redraw = true
			if _debug_hud:
				print("[touch] scene=%d id=%d mode=%d entry=%d pos=%s state=%d vanish=%d" % [
					int(PALState.scene), id, mode, entry, str(p), state, vanish])
