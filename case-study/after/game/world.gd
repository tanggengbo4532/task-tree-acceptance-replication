func _update_a28(delta: float) -> void:
	if sss == null:
		return
	if int(PALState.vars.get("a27_stage", 0)) < 1:
		# R131-A28STAMP-1：已处在 scene58（将军墓）＝ A28 剧情脚本 11399 已执行并切场完成；
		# 旧档/剧情变量未写 a27_stage 时不能因此卡住 A28→A30 链，按真实场景补写进度。
		if int(PALState.scene) == 58 and int(PALState.vars.get("a28_stage", 0)) < 1:
			PALState.vars["a28_stage"] = 1
			_show_a28_goal("已到将军冢（将军墓）并看过剧情！下一步：离开将军墓 → 白河村外（第 3 章）")
		return
	var sc := int(PALState.scene)
	if sc != _a28_last_scene:
		_a28_last_scene = sc
		_a28_fade_frames = 150
	if sc == 54 or sc == 53 or sc == 50 or sc == 55 or sc == 57 or sc == 59 or sc == 58:
		if int(PALState.vars.get("a28_stage", 0)) < 1:
			_fade_reset()
	if _a28_fade_frames > 0:
		_a28_fade_frames -= 1
		_fade_reset()
	if int(PALState.vars.get("a28_stage", 0)) >= 1:
		return
	if not _a28_talk_started:
		return
	_a28_timer += delta
	var vm_idle: bool = (vm == null or not vm.is_active())
	var dlg_active: bool = _dialog_box != null and _dialog_box.has_method("is_active") and _dialog_box.is_active()
	# 剧情脚本已结束（vm idle）→ 不用等对白尾巴/player_busy，直接收尾（避免黑盒被 dialog_tail 卡住看不到目标）
	if vm_idle and not dlg_active:
		_a28_talk_started = false
		_a28_timer = 0.0
		_dialog_tail = false
		player_busy = false
		_wait_release = false
		# R115-A28TALK-1：剧情播完写入真实进度，HUD 停止继续指“查看将军墓”。
		PALState.vars["a28_stage"] = 1
		_log_exit_area("A28 tomb done scene=%d pos=%s" % [sc, str(abs_party())])
		_show_a28_goal("已到将军冢（将军墓）并看过剧情！继续深入找灵儿 → 赤鬼王（第 3 章）")
		return
	# 兜底：脚本/对白异常时 12 秒后强制收尾
	if _a28_timer > 12.0:
		_a28_talk_started = false
		_a28_timer = 0.0
		_dialog_tail = false
		player_busy = false
		PALState.vars["a28_stage"] = 1
		_log_exit_area("A28 tomb done(timeout) scene=%d" % sc)
		_show_a28_goal("已到将军冢（将军墓）并看过剧情！继续深入找灵儿 → 赤鬼王（第 3 章）")


