					_img.set_pixel(sx + x, sy + y, fill)


func _draw_scene_markers() -> void:
	if int(Time.get_ticks_msec() / 450) % 2 != 0:
		return
	_draw_s106_gate_marker()
	_draw_s141_walk_markers()
	var markers: Array = _route_markers if not _route_markers.is_empty() else _active_exit_markers()
	if markers.is_empty():
		return
	# 屏幕外方向箭头按"路线下一步"方向画（保证箭头指的方向是能走的）；没有路线才退回直线方向。
	# R18 修复：必须用"当前队伍位置→下一个必经格"（_route18_next_point，与顶栏/黄箭头同源），
	# 不能读 _route_path[0]/[1]——玩家沿缓存路线前进后 path 前两格是旧起点，箭头会指反方向。
	# round76c 去重：中央步骤条可用时，不重复画屏幕边缘方向箭头（保留地面黄点/黄框）
	var edge_arrows_ok := _debug_hud or not _help_bar_available()
	var route_dir := ""
	if int(PALState.scene) == 18 or int(PALState.scene) in [17, 19, 20, 21]:
		var np18 := _route18_next_point()
		if np18.x >= 0:
			route_dir = _key_dir_from_step(abs_party(), np18)
	if route_dir == "" and _route_path.size() >= 2:
		var p0: Vector2i = _route_path[0]
		var p1: Vector2i = _route_path[1]
		var dd := p1 - p0
		if dd.x > 0: route_dir = "right"
		elif dd.x < 0: route_dir = "left"
		elif dd.y < 0: route_dir = "up"
		elif dd.y > 0: route_dir = "down"
	for m in markers:
		var sx: int = int(m.x) - PALState.viewport.x
		var sy: int = int(m.y) - PALState.viewport.y
		var on_screen := sx >= 8 and sx < SCREEN_W - 8 and sy >= 16 and sy < SCREEN_H - 8
		if on_screen:
			if int(PALState.scene) != 18:
				_blit_arrow(Vector2i(sx, sy - 16), "down")
		elif route_dir != "" and edge_arrows_ok:
			var cyan_fill := Color(0.35, 0.95, 1.0, 1.0)
			var cyan_edge := Color(0.10, 0.45, 0.85, 1.0)
			var use_cyan := int(PALState.scene) == 18
			var fill_c := cyan_fill if use_cyan else Color(1.0, 0.92, 0.25, 1.0)
			var edge_c := cyan_edge if use_cyan else Color(0.55, 0.30, 0.0, 1.0)
			match route_dir:
				"left":
					_blit_arrow_color(Vector2i(10, clampi(sy, 14, SCREEN_H - 10)), "left", fill_c, edge_c)
				"right":
					_blit_arrow_color(Vector2i(SCREEN_W - 10, clampi(sy, 14, SCREEN_H - 10)), "right", fill_c, edge_c)
				"up":
					_blit_arrow_color(Vector2i(clampi(sx, 10, SCREEN_W - 10), 14), "up", fill_c, edge_c)
				_:
					_blit_arrow_color(Vector2i(clampi(sx, 10, SCREEN_W - 10), SCREEN_H - 10), "down", fill_c, edge_c)
		elif edge_arrows_ok:
			var dx: int = sx - SCREEN_W / 2
			var dy: int = sy - SCREEN_H / 2
			var cx: int = clampi(sx, 10, SCREEN_W - 10)
			var cy: int = clampi(sy, 14, SCREEN_H - 10)
			if absi(dx) >= absi(dy * 2):
				_blit_arrow(Vector2i(10 if dx < 0 else SCREEN_W - 10, cy), "left" if dx < 0 else "right")
			else:
				_blit_arrow(Vector2i(cx, 14 if dy < 0 else SCREEN_H - 10), "up" if dy < 0 else "down")


## round74/P6（task-9）：场景16 密林出口引导路线（BFS 到原版 evt205 触发圈 ~(1824,944)）。
## 只做"可发现性"：黄面包屑 + 屏幕边缘方向箭头 + 出口黄框；触发仍是原版 mode5 触碰（半径 48），
## 无宽区域/传送/自动触发/放宽半径。
## round74/P6 二修（tester 截图定位）：除崖壁遮挡/无路标外，密林有 4 个"触碰即战斗"的怪物圈
## （evt207~210，绿叶小妖/双妖精），主走廊单格——tester 25 分钟走不到就是因为这条之字走廊中段
## 有怪挡路且无任何提示。引导路线改为"避开怪物触碰圈"（原版玩家真实策略：绕开或打赢），
## 若起点就在某个怪圈内（刚打完/逃完）则忽略该圈，避免永远无路。
func _update_route_hint_scene16() -> void:
	_route_group = "exit16"
	var exitp := Vector2i(1824, 944)
	var stand := Vector2i(1792, 944)
	_route_markers = [stand]
	_route18_stand = stand
	var start := abs_party()
	if absi(start.x - exitp.x) + absi(start.y - exitp.y) * 2 < 44:
		_route_path = [start]
		return
	# 怪物触碰圈（spr=468 的怪物事件，mode>=4；不含出口/回程门）
	var hazards: Array = []
	for id in range(evt_start + 1, evt_end + 1):
		var o: Array = sss.event(id)
		var mode := int(o[PalData.EO_TRIGGER_MODE])
		if mode < 4 or int(o[PalData.EO_STATE]) <= 0:
			continue
		if int(o[PalData.EO_SPRITE]) != 468:
			continue
		var ex := int(o[PalData.EO_X])
		var ey := int(o[PalData.EO_Y])
		var r := (mode - 4) * 32 + 16
		if absi(start.x - ex) + absi(start.y - ey) * 2 < r:
			continue   # 起点已在圈内：忽略该圈（刚打完/逃完）
		hazards.append({"x": ex, "y": ey, "r": r})
	var dirs := [Vector2i(16, 0), Vector2i(-16, 0), Vector2i(0, 8), Vector2i(0, -8)]
	for pass_i in range(2):
		var prev := {start: start}
		var queue: Array = [start]
		var head := 0
		var goal := start
		var found := false
		while head < queue.size() and head < 40000:
			var p: Vector2i = queue[head]
			head += 1
			if absi(p.x - exitp.x) + absi(p.y - exitp.y) * 2 < 44:
				goal = p
				found = true
				break
			for d in dirs:
				var n: Vector2i = p + d
				if prev.has(n):
					continue
				if _is_obstacle_tiles(n.x, n.y):
					continue
				if pass_i == 0:
					var bad := _is_obstacle_fast(n.x, n.y)
					if not bad:
						for h in hazards:
							if absi(n.x - int(h["x"])) + absi(n.y - int(h["y"])) * 2 < int(h["r"]):
								bad = true
								break
					if bad:
						continue
				prev[n] = p
				queue.append(n)
		if found:
			var path: Array = []
			var cur := goal
			while cur != start:
				path.append(cur)
				cur = prev[cur]
			path.reverse()
			_route_path = path
			_route18_needs_ride = pass_i == 1
			_route18_next_key = _key_dir_from_step(start, path[0] if not path.is_empty() else stand)
			return
	_route_path = []
	_route18_next_key = ""
	_route16_empty_frame = Engine.get_process_frames()


