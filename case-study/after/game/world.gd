	var stand: Vector2i = t[1]
	var dirs := [Vector2i(16, 0), Vector2i(-16, 0), Vector2i(0, 8), Vector2i(0, -8)]
	var ok4 := []
	for d in dirs:
		ok4.append("%d" % (1 if _s18_step_allowed(pp, pp + d) else 0))
	var key := _route18_current_key()
	var line := "f=%d pos=%d,%d sid=%d stand=%d,%d stand_d=%d key=%s dist=%d busy=%s vm=%s ride=%s edges=%d rebuilds=%d" % [
		Engine.get_process_frames(), pp.x, pp.y, int(t[0]), stand.x, stand.y,
		absi(pp.x - stand.x) + absi(pp.y - stand.y) * 2, key,
		int(_s18_stone_dist.get(pp, -1)), str(player_busy), str(vm != null and vm.is_active()),
		str(_route18_needs_ride), _s18_stone_blocked_edges.size(), _s18_stone_rebuilds]
	_s18_diag_buf.append(line)
	if _s18_diag_buf.size() > 400:
		_s18_diag_buf = _s18_diag_buf.slice(_s18_diag_buf.size() - 400)
