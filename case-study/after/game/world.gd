## R119-PARTY-1：读档时按真实剧情恢复应有队伍编成（修“李逍遥单人”运行期编成丢失）。
## 数据依据：
##  - player role 0=李逍遥 / 1=赵灵儿 / 2=林月如；
##  - 原剧本 0x0075 set_party 参数 1-based：scene36/37/40/43 的 set_party(1,3,0) => [李(0), 林(2)]；
##    白河村/将军冢段（scene49..59，A28 前）party 应为 李逍遥+林月如 2 人（赵灵儿在韩医仙家养伤）；
##  - 存档若只有李一人（nparty=0，party 全 role0），且真实剧情标志 a24_stage>=1、林月如真实等级/HP 存在，
##    则读档后恢复 [0,2]，不写存档、不伪造剧情；a28_stage>=1 后不再干预（后续剧情可能合法改队伍）。
func _repair_story_party_on_load() -> void:
	if PALState == null:
		return
	if int(PALState.max_party_member_index) >= 1:
		return
	if PALState.party.is_empty():
		return
	if int(PALState.party[0].get("role", 0)) != 0:
		return
	if int(PALState.vars.get("a24_stage", 0)) < 1:
		return
	if int(PALState.vars.get("a28_stage", 0)) >= 1:
		return
	var lv: Array = PALState.roles.get("level", [])
	var hp: Array = PALState.roles.get("hp", [])
	if lv.size() <= 2 or hp.size() <= 2:
		return
	if int(lv[2]) < 2 or int(hp[2]) <= 0:
		return
	PALState.party[1]["role"] = 2
	for i in range(2, PALState.party.size()):
		PALState.party[i]["role"] = 2
	PALState.max_party_member_index = 1
	print("[party] R119-PARTY-1 restore story party=李逍遥+林月如 scene=%d a24=%d a28=%d" % [
		int(PALState.scene), int(PALState.vars.get("a24_stage", 0)), int(PALState.vars.get("a28_stage", 0))])


