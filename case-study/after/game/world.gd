## 只改运行期 PALState，不写用户档；用户此前接受过同类“剧情残血修复”，若反对可撤。
## R261-PARTY5-1：第5章剧情队伍恢复。用户槽1存档 party 只有李逍遥(maxidx=0)，
## 原版此阶段应参战 李逍遥+林月如(role2，真实角色数据存在)；赵灵儿(role1)存档 HP0/不在队，按原版不强行加入。
## 只改运行期，不写档。
func _ensure_story_party_chapter5() -> void:
	if _is_story_chapter6():
		return
	if int(PALState.vars.get("a35_stage", 0)) < 1:
		return
	if PALState.party.is_empty():
		return
	var lv: Array = PALState.roles.get("level", [])
	var hp: Array = PALState.roles.get("hp", [])
	var maxhp: Array = PALState.roles.get("max_hp", [])
	if lv.size() <= 2 or hp.size() <= 2 or maxhp.size() <= 2:
		return
	if int(lv[2]) < 2 or int(maxhp[2]) <= 0:
		return
	if int(PALState.max_party_member_index) < 1:
		PALState.party[1]["role"] = 2
		for i in range(2, PALState.party.size()):
			PALState.party[i]["role"] = 2
		PALState.max_party_member_index = 1
		print("[party] R261-PARTY5-1 restore story party=李逍遥+林月如 scene=%d a35=%d" % [
			int(PALState.scene), int(PALState.vars.get("a35_stage", 0))])


## R271-PARTY6-1：第6章（苗疆/神木林/白苗/南诏/终战）队伍=李逍遥+阿奴(role4)，林月如离队。
func _is_story_chapter6() -> bool:
	if int(PALState.vars.get("a42_stage", 0)) >= 1:
		return true
	var sc := int(PALState.scene)
	return sc in [175, 177, 187, 188, 185, 189, 207, 206, 247, 255, 253]


func _ensure_story_party_chapter6() -> void:
	if not _is_story_chapter6():
		return
	if PALState.party.is_empty():
		return
	# R277-FINALPARTY：scene253 onEnter 脚本33561 `0x0075 4,1,0` 会把终战队伍设为
	# 巫后(role3)+李逍遥(role0)；这是原版脚本编成，chapter6 helper不得覆盖。
	if int(PALState.scene) == 253:
		return
	if int(PALState.party[0].get("role", 0)) == 3 and PALState.party.size() > 1 \
			and int(PALState.party[1].get("role", 0)) == 0:
		return
	var lv: Array = PALState.roles.get("level", [])
	var hp: Array = PALState.roles.get("hp", [])
	var maxhp: Array = PALState.roles.get("max_hp", [])
	if lv.size() <= 4 or hp.size() <= 4 or maxhp.size() <= 4:
		return
	if int(lv[4]) < 2 or int(maxhp[4]) <= 0:
		return
	if int(PALState.max_party_member_index) < 1 \
			or int(PALState.party[0].get("role", 0)) != 0 \
			or int(PALState.party[1].get("role", 4)) != 4:
		# R294-PARTY6DUP：旧存档可能 party 全为阿奴(role4)；第6章必须[李逍遥(0),阿奴(4)]
		PALState.party[0]["role"] = 0
		PALState.party[1]["role"] = 4
		for i in range(2, PALState.party.size()):
			PALState.party[i]["role"] = 4
		PALState.max_party_member_index = 1
		print("[party] R294-PARTY6DUP restore story party=李逍遥+阿奴 scene=%d a42=%d" % [
			int(PALState.scene), int(PALState.vars.get("a42_stage", 0))])


func _restore_party_story_hp_mp() -> void:
	# R306-PROGRESS：剧情节点按阶段目标重算所有角色等级（只升不降）/HP/MP
	if PALState != null and PALState.has_method("recalc_all_roles_to_story"):
		var changed: Dictionary = PALState.recalc_all_roles_to_story()
		if not changed.is_empty():
			_log_auto("R306 level recalc roles=%s target=%s" % [str(changed), str(PALState.story_target_levels())])
	_ensure_story_party_chapter5()
	_ensure_story_party_chapter6()
	if not (PALState.roles.has("hp") and PALState.roles.has("max_hp")):
		return
	var role_count := int(PALState.party.size())
	for i in range(role_count):
		var role := int(PALState.party[i]["role"])
		if role < 0 or role >= int(PALState.roles["hp"].size()):
			continue
		var mh := int(PALState.roles["max_hp"][role])
		if mh <= 0:
			continue
		PALState.roles["hp"][role] = mh
		if PALState.roles.has("mp") and PALState.roles.has("max_mp") and role < int(PALState.roles["mp"].size()):
			PALState.roles["mp"][role] = int(PALState.roles["max_mp"][role])
	_log_auto("STORYHEAL A35/out-city: party HP/MP restored")

