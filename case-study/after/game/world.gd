## 场景区域判定：分别从"一楼店门"和"二楼回廊"做 BFS 距离场，离哪个锚点近就算在哪个区域。
## 用于同一张地图里按区域切换引导目标（客栈：二楼→楼梯、一楼→店门），修掉 round4 的箭头翻转/回头路。
## [round6] 场景 4 实际只含一楼大厅（map 10），且店门锚点在可行走区之外（可达性恒为 0），
## 本函数对场景 4 不再使用；保留给未来"同场景多楼层"的地图。区域出口组见 _active_exit_group。
func _ensure_scene_regions() -> void:
	var sc := int(PALState.scene)
	if _regions_scene == sc:
		return
	_regions_scene = sc
	_hall_dist.clear()
	_gallery_dist.clear()
	_region_group = ""
	if sc != 4:
		return
	_hall_dist = _bfs_dist(Vector2i(976, 1704))
	_gallery_dist = _bfs_dist(Vector2i(1520, 1496))


func _bfs_dist(start: Vector2i) -> Dictionary:
	var dist := {start: 0}
	var queue: Array = [start]
	var head := 0
	var dirs := [Vector2i(16, 0), Vector2i(-16, 0), Vector2i(0, 8), Vector2i(0, -8)]
	while head < queue.size() and head < 20000:
		var p: Vector2i = queue[head]
		head += 1
		var d0: int = int(dist[p])
		for d in dirs:
			var n: Vector2i = p + d
			if dist.has(n):
				continue
			if _is_obstacle(n.x, n.y):
				continue
			dist[n] = d0 + 1
			queue.append(n)
	return dist


func _update_region_group() -> void:
	_ensure_scene_regions()
	var sc := int(PALState.scene)
	if sc != 4:
		return
	var p := abs_party()
	var dh: int = int(_hall_dist.get(p, 1 << 30))
	var dg: int = int(_gallery_dist.get(p, 1 << 30))
	_region_group = "hall" if dh <= dg else "gallery"


func _hint_text() -> String:
	match int(PALState.scene):
		2:
			return ""   # round76c 去重：客栈段由顶栏+中央条覆盖
		3:
			return ""   # round76f：顶栏地点 + 中央合并行
		4:
			return ""   # round76c 去重
		5:
			return ""   # round76c 去重
		6:
			return ""   # round76c 去重（客栈段）
		15:
			return ""   # round76f
		22:
			return str(HINT_TEXTS.get("22", ""))
	return ""


## R126-NAME-1：HUD/提示地名统一「将军冢」。
## 当前源码文案均为「将军冢」；此函数防御性修正任何遗留来源（旧缓存/Word/手误）里的
## 「将军家」「将军塚」→「将军冢」，保证所有 HUD/提示显示一致。
func _hud_name_fix(s: String) -> String:
	if s.find("将军家") >= 0:
		s = s.replace("将军家", "将军冢")
	if s.find("将军塚") >= 0:
		s = s.replace("将军塚", "将军冢")
	return s


## 进入场景后，等剧本/过场结束、玩家可操作时显示地点名 + 出口方向提示。
func _show_scene_hint() -> void:
	if _hint_label == null or _hint_panel == null:
		return
	var text := _hint_text()
	if text == "":
		return
	_hint_label.text = _hud_name_fix(text)
	_hint_panel.visible = true
	_hint_timer = SCENE_HINT_SECONDS


func _update_hint(delta: float) -> void:
	if _hint_panel == null or not _hint_panel.visible:
		return
	_hint_timer -= delta
	if _hint_timer <= 0.0:
		_hint_panel.visible = false


## round70/A56（F88 方案A）：场景2 分步常驻引导（按位置更新；不改数据/碰撞、不传送）
##  起点：向下 2 格 → 向左到楼梯口 → 向下自动下楼（落到 evt4 的 48px 触碰半径）
## round71/A58（F88 方案B）：16/8 移动网格 BFS 到 evt4 触碰格（距门 metric<48），
## 缓存下一步方向与剩余格数（队伍位置变化才重算）。
## round76：从"到目标距离场"重建路径 → crumbs/边缘箭头唯一来源（guide 与地面标记同源）
func _sync_guide_crumbs_from_dist(p: Vector2i, dist: Dictionary) -> void:
	if not dist.has(p):
		return
	var path: Array = []
	var cur := p
	var dirs := [Vector2i(0, 8), Vector2i(-16, 0), Vector2i(0, -8), Vector2i(16, 0)]
	var guard := 0
	while int(dist.get(cur, 0)) > 0 and guard < 4000:
		guard += 1
		var best := Vector2i(0, 0)
		var bd := 1 << 30
		for d in dirs:
			var n: Vector2i = cur + d
			if not dist.has(n):
				continue
			var nd: int = int(dist[n])
			if nd < bd:
				bd = nd
				best = d
		if best == Vector2i(0, 0):
			break
		cur += best
		path.append(cur)
	if path.is_empty():
		_route_path = []
		return
	_route_path = path
	_route_markers = [cur]
	_route_group = "guide_override"
	_guide_crumb_override = true


func _scene2_route_update(p: Vector2i) -> void:
	_s2_guide_pos = p
	_s2_guide_ok = false
	_s2_guide_stuck = false
	_s2_guide_dir = ""
	_s2_guide_left = 0
	# 多源 BFS：从"距门 metric<48 的可行走格"反向扩散，得到每个格到门口的剩余步数
	var dist := {}
	var q: Array = []
	for gx in [1152, 1168, 1184, 1200]:
		for gy in [352, 360, 368, 376, 384]:
			var g := Vector2i(gx, gy)
			if absi(g.x - 1152) + absi(g.y - 384) * 2 >= 48:
				continue
			if _is_obstacle_fast(g.x, g.y):
				continue
			if dist.has(g):
				continue
			dist[g] = 0
			q.append(g)
	var dirs_all := [Vector2i(0, 8), Vector2i(0, -8), Vector2i(-16, 0), Vector2i(16, 0)]
	var head := 0
	while head < q.size() and head < 40000:
		var c: Vector2i = q[head]
		head += 1
		var d0: int = int(dist[c])
		for d in dirs_all:
			var n: Vector2i = c + d
			if dist.has(n):
				continue
			if _is_obstacle_fast(n.x, n.y):
				continue
			dist[n] = d0 + 1
			q.append(n)
	if not dist.has(p):
		return
	# round72/F95 残留修复：只给"严格减少剩余步数"的方向（每按一次提示方向必 -1 格，不会 A→B→A 往复）；
	# 只有在没有严格下降邻居时才进入「先脱困」分支（旧逻辑把 ↑/→ 一律当先脱困，会把正常上/右行进误标成脱困）。
	var best := Vector2i(0, 0)
	var best_d := 1 << 30
	var cur_d: int = int(dist[p])
	var prefer := [Vector2i(0, 8), Vector2i(-16, 0), Vector2i(0, -8), Vector2i(16, 0)]
	for d in prefer:
		var n: Vector2i = p + d
		if not dist.has(n):
			continue
		var nd: int = int(dist[n])
		if nd < cur_d and nd < best_d:
			best_d = nd
			best = d
	if best == Vector2i(0, 0):
		_s2_guide_stuck = true
		for d in prefer:
			var n2: Vector2i = p + d
			if not dist.has(n2):
				continue
			var nd2: int = int(dist[n2])
			if nd2 < best_d:
				best_d = nd2
				best = d
	if best == Vector2i(0, 0):
		return
	_s2_guide_ok = true
	_s2_guide_left = cur_d
	# R76-GUIDE-10：下一步必须真实可走（书架/家具旁不再无位移/翻转）
	if best == Vector2i(0, 0) or not _step_walkable(p, best):
		var bw2 := _pick_walkable_dir(p, dist, cur_d)
		if bw2 != Vector2i(0, 0):
			best = bw2
			_s2_guide_stuck = true
	_sync_guide_crumbs_from_dist(p, dist)
	if best.x > 0:
		_s2_guide_dir = "→"
	elif best.x < 0:
		_s2_guide_dir = "←"
	elif best.y > 0:
		_s2_guide_dir = "↓"
	elif best.y < 0:
		_s2_guide_dir = "↑"


func _is_scene2_guide_text(t: String) -> bool:
	# round72/F95：引导自己的两种文案（"下一步…/先脱困…"）也要识别为"自己的提示"，
	# 否则 _update_scene2_guide 会把它当外来提示让位（early-return），导致引导最长冻结 12s/1s
	# （表现为"下一步 ↓（剩 N）"停更、按格子数不减、被挡后突然跳"先脱困 ↑"）。
	return t.begins_with("客栈二楼") or t.begins_with("已到楼梯口") or t.begins_with("【客栈二楼】") \
		or t.begins_with("下一步 ") or t.begins_with("先脱困 ")


func _update_scene2_guide() -> void:
	if int(PALState.scene) != 2:
		return
	if _hint_label == null or _hint_panel == null:
		return
	if player_busy or _dialog_tail or (vm != null and vm.is_active()):
		if _hint_panel != null:
			_hint_panel.visible = false
		return
	if _interact_id != 0:
		return
	# 其它提示（A 节点目标等）显示中时让位；自己的引导文字则允许随移动刷新
	var p := abs_party()
	if p != _s2_guide_pos:
		_scene2_route_update(p)
	var metric: int = absi(p.x - 1152) + absi(p.y - 384) * 2
	var t := ""
	if metric < 48:
		t = "已到楼梯口：向下走即下楼（↓）"
	elif not _s2_guide_ok:
		t = "客栈二楼：这里走不通，先向其它方向挪一格（轻按）"
	elif _s2_guide_stuck:
		t = "先脱困 %s（剩 %d 格）· 轻按1格" % [_s2_guide_dir, _s2_guide_left]
	else:
		if _s2_guide_dir == "↓":
			t = "下一步 【%s】（剩 %d 格）· 轻按1格·向下即下楼" % [_s2_guide_dir, _s2_guide_left]
		else:
			t = "下一步 【%s】（剩 %d 格）· 轻按1格" % [_s2_guide_dir, _s2_guide_left]
	_s2_guide_text = t


## round72/F94 方案A（用户批准）：场景4 二楼回廊"逐格 BFS 引导"（与场景2 F88 方案B 同一设计）。
##   - 目标 = 楼梯下行触发格 evt48(1168,1368) 半径 40（stair_r，见 _check_touch_triggers）内的可行走格；
##   - 每格给"下一步方向 + 剩余格数"；进入触发半径显示"已到楼梯口：按住 DOWN 下楼"；
##   - 提示常驻到真正下楼（hall_level 置位）→ 顺带解决 F96；只做引导层：不改碰撞/触发/地图数据，
##     不放宽触发半径（B 方案未批准）。
func _scene4_stair_goal_cells() -> Array:
	var out: Array = []
	for gx in range(S4_STAIR_TRIGGER.x - 48, S4_STAIR_TRIGGER.x + 49, 16):
		for gy in range(S4_STAIR_TRIGGER.y - 24, S4_STAIR_TRIGGER.y + 25, 8):
			if absi(gx - S4_STAIR_TRIGGER.x) + absi(gy - S4_STAIR_TRIGGER.y) * 2 >= S4_STAIR_METRIC:
				continue
			if _is_obstacle(gx, gy):
				continue
			out.append(Vector2i(gx, gy))
	return out


## 多源 BFS（16/8 移动网格、_is_obstacle 判走）：从楼梯触发格反向扩散，位置变化才重算。
func _scene4_route_update(p: Vector2i) -> void:
	_s4_guide_pos = p
	_s4_guide_ok = false
	_s4_guide_stuck = false
	_s4_guide_dir = ""
	_s4_guide_left = 0
	var goals := _scene4_stair_goal_cells()
	if goals.is_empty():
		return
	var dist := {}
	var q: Array = []
	for g in goals:
		dist[g] = 0
		q.append(g)
	var dirs_all := [Vector2i(0, 8), Vector2i(0, -8), Vector2i(-16, 0), Vector2i(16, 0)]
	var head := 0
	while head < q.size() and head < 40000:
		var c: Vector2i = q[head]
		head += 1
		var d0: int = int(dist[c])
		for d in dirs_all:
			var n: Vector2i = c + d
			if dist.has(n):
				continue
			if _is_obstacle_fast(n.x, n.y):
				continue
			dist[n] = d0 + 1
			q.append(n)
	if not dist.has(p):
		return
	# 选"严格减少剩余格数"的相邻格；多个时按 上>左>下>右 稳定顺序（楼梯口在回廊左上）
	var best := Vector2i(0, 0)
	var best_d := 1 << 30
	var prefer := [Vector2i(0, -8), Vector2i(-16, 0), Vector2i(0, 8), Vector2i(16, 0)]
	var cur_d: int = int(dist[p])
	for d in prefer:
		var n: Vector2i = p + d
		if not dist.has(n):
			continue
		var nd: int = int(dist[n])
		if nd < cur_d and nd < best_d:
			best_d = nd
			best = d
	if best == Vector2i(0, 0):
		# 无严格下降邻居：先脱困——选可走邻居里剩余步数最少的方向（若存在）
		_s4_guide_stuck = true
		for d in prefer:
			var n2: Vector2i = p + d
			if not dist.has(n2):
				continue
			var nd2: int = int(dist[n2])
			if nd2 < best_d:
				best_d = nd2
				best = d
	if best == Vector2i(0, 0):
		return
	_s4_guide_ok = true
	_s4_guide_left = cur_d
	# R76-GUIDE-10：下一步必须真实可走（楼梯口/栏杆旁不再无位移/翻转）
	if best == Vector2i(0, 0) or not _step_walkable(p, best):
		var bw4 := _pick_walkable_dir(p, dist, cur_d)
		if bw4 != Vector2i(0, 0):
			best = bw4
			_s4_guide_stuck = true
	_sync_guide_crumbs_from_dist(p, dist)
	if best.x > 0:
		_s4_guide_dir = "→"
	elif best.x < 0:
		_s4_guide_dir = "←"
	elif best.y > 0:
		_s4_guide_dir = "↓"
	elif best.y < 0:
		_s4_guide_dir = "↑"


func _is_s4_guide_text(t: String) -> bool:
	# 识别"自己的引导"（含入口场景提示）以便随移动刷新；其它提示显示时让位
	return t.begins_with("下一步 ") or t.begins_with("先脱困 ") or t.begins_with("已到楼梯口") \
		or t.begins_with("客栈二楼") or t.begins_with("【客栈二楼")


func _update_scene4_guide() -> void:
	if int(PALState.scene) != 4 or _hall_level:
		return
	if _hint_label == null or _hint_panel == null:
		return
	if player_busy or _dialog_tail or (vm != null and vm.is_active()):
		if _hint_panel != null:
			_hint_panel.visible = false
		return
	if _interact_id != 0:
		return
	# 其它提示（A 节点目标等）显示中时让位；自己的引导文字允许随移动刷新；客房门交互不顶掉引导（F99）
	var p := abs_party()
	if p != _s4_guide_pos:
		_scene4_route_update(p)
	var metric: int = absi(p.x - S4_STAIR_TRIGGER.x) + absi(p.y - S4_STAIR_TRIGGER.y) * 2
	var t := ""
	if metric < S4_STAIR_METRIC:
		t = "已到楼梯口：按住 DOWN 下楼（↓）"
	elif not _s4_guide_ok:
		t = "先脱困：这里走不通，先向其它方向挪一格（轻按）"
	elif _s4_guide_stuck:
		t = "先脱困 %s（剩 %d 格）· 轻按1格" % [_s4_guide_dir, _s4_guide_left]
	else:
		t = "下一步 【%s】（剩 %d 格）· 轻按1格" % [_s4_guide_dir, _s4_guide_left]
	# round72/F99：贴近客房门时不清掉方向提示，改为在后面追加"空格进客房"（交互提示与引导共存）
	if _room_door_id != 0 and (t.begins_with("下一步") or t.begins_with("先脱困")):
		t += "· 门口可空格进客房"
	_s4_guide_text = t


