		push_error("World: 场景 %d 没有地图" % n)
		return
	PALState.scene = n
	if n != 81:
		_clear_s81_markers()
	# R285-S141EVENTS：把蜀山剑圣/塔入口改为“走到触发区自动触发”的可见事件，
