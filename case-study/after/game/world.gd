## F150：多源 BFS（源=目标触摸半径内可行走格；walkability 与移动同源 `_is_obstacle`）
## R77-FIX-4：scene4 反向距离场。walkability 与 _update_movement 同源（_is_obstacle + 同边界），
## 目标环 = 目标 cell 的 touch_r 内可走格；每帧从当前 cell 选 dist 严格 -1 的方向。
func _s4g_walk_ok(x: int, y: int) -> bool:
	# task-71：scene4 1F 黑区（东/南外圈）不进 A14 距离场，与 movement 边界一致
	if int(PALState.scene) == 4 and _hall_level:
		if x < 560 or x > 1456 or y > 1840:
			return false
	if current_map == null:
		return false
	if int(PALState.scene) == 81 and _s81_restrict_scene == 81:
		return _s81_ground_cell_ok(Vector2i(x, y))
	# R77-A14-5：A14 1F 场排除楼梯触发格（evt47/48），否则路径会指向 DOWN 触发楼梯脚本的格子
	if _s4g_block_stairs and int(PALState.scene) == 4 and _hall_level:
		for sid in [47, 48]:
			if sss != null and sid < sss.events.size():
				var eo: Array = sss.event(sid)
				if absi(x - int(eo[PalData.EO_X])) + absi(y - int(eo[PalData.EO_Y])) * 2 < 32:
					return false
	# R267：HUD 路径避开“非目标真实门”的触发圈（门本身仍保留/可手动触发）
	if not _s4g_avoid_events.is_empty() and sss != null:
		for aid in _s4g_avoid_events.keys():
			if aid >= 1 and aid < sss.events.size():
				var eo: Array = sss.event(int(aid))
				if absi(x - int(eo[PalData.EO_X])) + absi(y - int(eo[PalData.EO_Y])) * 2 < int(_s4g_avoid_events[aid]):
					return false
	var block_x: int = PARTY_OFFSET.x / 32
	var block_y: int = PARTY_OFFSET.y / 16
	var tx: int = x / 32
	var ty: int = y / 16
	if tx < block_x or tx >= current_map.map_pixel_width() / 32 - block_x - 1 \
			or ty < block_y or ty >= current_map.map_pixel_height() / 16 - block_y - 1:
		return false
	return not _is_obstacle(x, y)


func _s4g_build(p: Vector2i, targets: Array, touch_r: int) -> void:
	_ensure_walk_blocked()
	var key := str(targets) + "|" + str(touch_r) + "|" + str(int(PALState.scene)) + "|" + str(_s4g_block_stairs) + "|" + str(bool(_hall_level)) + "|" + str(_walk_blocked_frame) + "|" + str(_s4g_avoid_events)
	if key == _s4g_key and not _s4g_dist.is_empty() and _s4g_dist.has(p):
		return
	_s4g_key = key
	_s4g_touch_r = touch_r
	var dist := {}
	var q: Array = []
	for t in targets:
		var tp: Vector2i = t
		var gx := tp.x - touch_r - 16
		while gx <= tp.x + touch_r + 16:
			var gy := tp.y - touch_r - 16
			while gy <= tp.y + touch_r + 16:
				var g := Vector2i(gx, gy)
				var md := absi(g.x - tp.x) + absi(g.y - tp.y) * 2
				if md < touch_r and not dist.has(g) and _s4g_walk_ok(g.x, g.y):
					dist[g] = 0
					q.append(g)
				gy += 8
			gx += 16
	var dirs := [Vector2i(16, 0), Vector2i(-16, 0), Vector2i(0, 8), Vector2i(0, -8)]
	var head := 0
	while head < q.size() and head < 80000:
		var c: Vector2i = q[head]
		head += 1
		var d0: int = int(dist[c])
		for d in dirs:
			var n: Vector2i = c + d
			if dist.has(n) or not _s4g_walk_ok(n.x, n.y):
				continue
			dist[n] = d0 + 1
			q.append(n)
	_s4g_dist = dist
	_s4g_rebuild_frame = Engine.get_process_frames()
	if not dist.has(p):
		# 玩家区域与目标环不连通：从玩家侧 BFS 找最近可达目标环 cell，再以该 cell 为种子重建
		var prev := {p: p}
		var q2: Array = [p]
		var hit := Vector2i(-1, -1)
		var h2 := 0
		while h2 < q2.size() and h2 < 60000:
			var c2: Vector2i = q2[h2]
			h2 += 1
			if dist.has(c2) and c2 != p:
				hit = c2
				break
			for d in dirs:
				var n2: Vector2i = c2 + d
				if prev.has(n2) or not _s4g_walk_ok(n2.x, n2.y):
					continue
				prev[n2] = c2
				q2.append(n2)
		if hit.x >= 0:
			# 以 hit 为目标环种子重建（保持目标语义：先到最近可达环 cell）
			var dist2 := {}
			var q3: Array = [hit]
			dist2[hit] = 0
			var h3 := 0
			while h3 < q3.size() and h3 < 80000:
				var c3: Vector2i = q3[h3]
				h3 += 1
				var d3: int = int(dist2[c3])
				for d in dirs:
					var n3: Vector2i = c3 + d
					if dist2.has(n3) or not _s4g_walk_ok(n3.x, n3.y):
						continue
					dist2[n3] = d3 + 1
					q3.append(n3)
			_s4g_dist = dist2
			_s4g_seed_metric = absi(hit.x - int((targets[0] as Vector2i).x)) + absi(hit.y - int((targets[0] as Vector2i).y)) * 2
		else:
			_s4g_seed_metric = 1 << 30


func _s4_guide_update(p: Vector2i, goal: Dictionary) -> void:
	var targets: Array = goal.get("targets", [])
	var touch_r := int(goal.get("touch_r", 48))
	_a6g_key = str(goal.get("key", "")) + ":" + str(int(PALState.scene)) + ":" + str(bool(_hall_level))
	_a6g_touch_r = touch_r
	_a6g_arrived = str(goal.get("arrived", ""))
	_a6g_label = str(goal.get("label", ""))
	_a6g_todo = str(goal.get("todo", ""))
	_a6g_avoid.clear()
	# R77-FIX-4：换场景清空 A6 目标滞回/反向距离场（防止带着上个场景目标/距离场）
	_a6g_goal_key = ""
	_a6g_goal_keep = {}
	_a6g_goal_new_key = ""
	_a6g_goal_new_frames = 0
	_a6g_ok = false
	_a6g_left = 0
	# R77-A13-2：换场景清 A13 触发标记，防止残留状态误判完成
	_a13_cloth_started = false
	_a13_auto_fired = false
	_a6g_dir = ""
	# P0-PERF-1：不清空 _s4g 缓存；_s4g_build 按 scene/floor/target/touch 缓存，变化才重建
	_a6g_ok = false
	_a6g_stuck = false
	_a6g_dir = ""
	_a6g_left = 0
	if targets.is_empty():
		return
	_s4g_build(p, targets, touch_r)
	var dist: Dictionary = _s4g_dist
	if not dist.has(p):
		_a6g_rescue = false
		return
	_a6g_rescue = false
	var cur_d: int = int(dist[p])
	_a6g_left = cur_d
	var dirs4 := [Vector2i(0, -8), Vector2i(0, 8), Vector2i(-16, 0), Vector2i(16, 0)]
	var best := Vector2i(0, 0)
	var best_d := 1 << 30
	var strict := Vector2i(0, 0)
	for d in dirs4:
		var n: Vector2i = p + d
		if dist.has(n) and _s4g_walk_ok(n.x, n.y):
			var nd: int = int(dist[n])
			if nd == cur_d - 1 and strict == Vector2i(0, 0):
				strict = d
			if nd < best_d:
				best_d = nd
				best = d
	if strict != Vector2i(0, 0):
		best = strict
	elif best != Vector2i(0, 0):
		_a6g_stuck = true
	else:
		return
	_a6g_ok = true
	if best.x > 0:
		_a6g_dir = "→"
	elif best.x < 0:
		_a6g_dir = "←"
	elif best.y > 0:
		_a6g_dir = "↓"
	else:
		_a6g_dir = "↑"



func _a6_guide_route_update(p: Vector2i, goal: Dictionary) -> void:
	_a6g_pos = p
	_a6g_ok = false
	_a6g_stuck = false
	_a6g_dir = ""
	_a6g_left = 0
	var targets: Array = goal.get("targets", [])
	var touch_r := int(goal.get("touch_r", 48))
	# F151：缓存 key 加入场景/楼层（同 scene4 的 1F/2F 用不同 dist，楼层切换必须重算）
	var key := str(goal.get("key", "")) + ":" + str(int(PALState.scene)) + ":" + str(bool(_hall_level))
	_a6g_key = key
	_a6g_touch_r = touch_r
	_a6g_arrived = str(goal.get("arrived", ""))
	_a6g_label = str(goal.get("label", ""))
	_a6g_todo = str(goal.get("todo", ""))
	if targets.is_empty():
		return
	# round76h：避让其它换场景门触发区（目标门所在区域除外），防止沿提示走时被自动门传走。
	# 仅在场景4二楼（2F 回廊）启用：1F/其它场景的路径可能必须经过门区，硬避让会切断可达性。
	_a6g_avoid.clear()
	# R76-GUIDE-9：仅"2F 回廊→楼梯口/房间门口"这一段避让其它换场景门触发区，
	# 避免走向楼梯时被客房门（mode5，半径48）自动传走；其它场景/目标不启用（防止切断可达性）。
	var use_avoid := false   # R76-GUIDE-9：探针验证会绕圈/挂起，本轮不启用（O-1/O-2 已由 GUIDE-10 修）；下轮单独修
	for d in (_scene_door_positions if use_avoid else []):
		var dp: Vector2i = d["pos"]
		var is_target := false
		for t in targets:
			var tp3: Vector2i = t
			if absi(tp3.x - dp.x) + absi(tp3.y - dp.y) * 2 < touch_r + 96:
				is_target = true
				break
		if is_target:
			continue
		var ax0 := dp.x - 64
		while ax0 <= dp.x + 64:
			var ay0 := dp.y - 32
			while ay0 <= dp.y + 32:
				var c := Vector2i(ax0, ay0)
				if absi(ax0 - dp.x) + absi(ay0 - dp.y) * 2 < 56:
					_a6g_avoid[c] = true
				ay0 += 8
			ax0 += 16
	if _a6g_dist_key != key or _a6g_dist.is_empty():
		var dist := {}
		var q: Array = []
		for t in targets:
			var tp: Vector2i = t
			var gx := tp.x - 192
			while gx <= tp.x + 192:
				var gy := tp.y - 128
				while gy <= tp.y + 128:
					var g := Vector2i(gx, gy)
					if absi(g.x - tp.x) + absi(g.y - tp.y) * 2 < touch_r and not _is_obstacle_fast(g.x, g.y) and not dist.has(g) and not _a6g_avoid.has(g):
						dist[g] = 0
						q.append(g)
					gy += 8
				gx += 16
		var dirs_all := [Vector2i(0, 8), Vector2i(16, 0), Vector2i(-16, 0), Vector2i(0, -8)]
		var head := 0
		while head < q.size() and head < 80000:
			var c: Vector2i = q[head]
			head += 1
			var d0: int = int(dist[c])
			for d in dirs_all:
				var n: Vector2i = c + d
				if dist.has(n) or _is_obstacle_fast(n.x, n.y) or _a6g_avoid.has(n):
					continue
				dist[n] = d0 + 1
				q.append(n)
		_a6g_dist = dist
		_a6g_dist_key = key
	if _a6g_avoid.has(p) and not _a6g_dist.has(p):
		# 玩家正站在"其它换场景门"触发区内（如楼梯落点恰好贴着客房门）：先朝非避让、可走、朝向目标更近的邻格走一步
		var out_dirs := [Vector2i(0, 8), Vector2i(16, 0), Vector2i(-16, 0), Vector2i(0, -8)]
		var out_best := Vector2i(0, 0)
		var out_best_d := 1 << 30
		for d in out_dirs:
			var n3: Vector2i = p + d
			if _a6g_avoid.has(n3) or _is_obstacle_fast(n3.x, n3.y):
				continue
			var tv: Vector2i = targets[0] if not targets.is_empty() else p
			var md := absi(n3.x - tv.x) + absi(n3.y - tv.y) * 2
			if md < out_best_d:
				out_best_d = md
				out_best = d
		if out_best != Vector2i(0, 0):
			_a6g_ok = true
			_a6g_stuck = false
			_a6g_left = 0
			if out_best.x > 0:
				_a6g_dir = "→"
			elif out_best.x < 0:
				_a6g_dir = "←"
			elif out_best.y > 0:
				_a6g_dir = "↓"
			else:
				_a6g_dir = "↑"
			return
	if not _a6g_dist.has(p):
		# F151：玩家在 BFS 不可达的口袋（楼梯夹层/栏杆死角等）——从 p 做 BFS 找最近的可达(dist)格，
		# 给"先回主路"的多步脱困方向（不再只看相邻格；相邻格也可能全在口袋里）。
		var prev: Dictionary = {p: p}
		var q: Array = [p]
		var head := 0
		var hit := Vector2i(-1, -1)
		var esc_dirs := [Vector2i(0, 8), Vector2i(16, 0), Vector2i(-16, 0), Vector2i(0, -8)]
		while head < q.size() and head < 6000:
			var c: Vector2i = q[head]
			head += 1
			if _a6g_dist.has(c) and c != p:
				hit = c
				break
			for d in esc_dirs:
				var n: Vector2i = c + d
				if prev.has(n) or _is_obstacle_fast(n.x, n.y) or _a6g_avoid.has(n):
					continue
				prev[n] = c
				q.append(n)
		if hit.x >= 0:
			var cur := hit
			while prev.has(cur) and prev[cur] != p:
				cur = prev[cur]
			var step := cur - p
			# R76-GUIDE-10：脱困方向同样必须真实可走（否则按键无位移）
			if not _step_walkable(p, step):
				var alt := _pick_walkable_dir(p, _a6g_dist, 0)
				if alt != Vector2i(0, 0):
					step = alt
			_a6g_stuck = true
			_a6g_left = int(_a6g_dist.get(hit, 0))
			if step.x > 0:
				_a6g_dir = "→"
			elif step.x < 0:
				_a6g_dir = "←"
			elif step.y > 0:
				_a6g_dir = "↓"
			elif step.y < 0:
				_a6g_dir = "↑"
		else:
			# F153：完全无路（楼梯夹层/栏杆死角）→ 允许 SPACE 触发真实下楼脚本脱困
			_a6g_rescue = int(PALState.scene) == 4 and not _hall_level
		return
	_a6g_rescue = false
	var cur_d: int = int(_a6g_dist[p])
	var best := Vector2i(0, 0)
	var best_d := 1 << 30
	var prefer := [Vector2i(0, 8), Vector2i(16, 0), Vector2i(-16, 0), Vector2i(0, -8)]
	# R76-GUIDE-10：HUD 下一步必须与移动同源可走；优先选"可走且 dist 下降"的方向
	for d in prefer:
		if not _step_walkable(p, d):
			continue
		var n: Vector2i = p + d
		if not _a6g_dist.has(n):
			continue
		var nd: int = int(_a6g_dist[n])
		if nd < cur_d and nd < best_d:
			best_d = nd
			best = d
	if best == Vector2i(0, 0):
		# 无可走下降方向（栏杆/家具/门口挡道）→ 选可走方向里离目标最近者并提示"先脱困/绕行"
		best = _pick_walkable_dir(p, _a6g_dist, cur_d)
		if best != Vector2i(0, 0):
			_a6g_stuck = true
	if best == Vector2i(0, 0):
		return
	_a6g_ok = true
	_a6g_left = cur_d
	if best.x > 0:
		_a6g_dir = "→"
	elif best.x < 0:
		_a6g_dir = "←"
	elif best.y > 0:
		_a6g_dir = "↓"
	elif best.y < 0:
		_a6g_dir = "↑"


func _a6_guide_metric_to(p: Vector2i, targets: Array) -> int:
	var best := 1 << 30
	for t in targets:
		var tp: Vector2i = t
		var d := absi(p.x - tp.x) + absi(p.y - tp.y) * 2
		best = mini(best, d)
	return best


