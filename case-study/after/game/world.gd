## round76：事件阻挡缓存（与 `_is_obstacle` 同语义：state>=2 且 metric<16 的 3x3 格）
## 每 120 帧/换场景/门状态变化时重建；BFS 用 `_is_obstacle_fast` O(1) 查表，替代每次遍历全部事件。
func _ensure_walk_blocked() -> void:
	var fr := Engine.get_process_frames()
	if _walk_blocked_scene == int(PALState.scene):
		return
	_walk_blocked_scene = int(PALState.scene)
	_walk_blocked_frame = fr
	_walk_blocked_cells.clear()
	if sss == null:
		return
	for id in range(evt_start + 1, evt_end + 1):
		# R269-S188BRIDGE：scene188 的3153/3154是桥接状态件；旧缓存把state2当阻挡，
		# 导致187落点无法走到evt3155触发桥接。两个事件不放阻挡集（门/事件本身保留）。
		if int(PALState.scene) == 188 and (id == 3153 or id == 3154):
			continue
		var o: Array = sss.event(id)
		if int(o[PalData.EO_STATE]) < 2:
			continue
		var ex := int(o[PalData.EO_X])
		var ey := int(o[PalData.EO_Y])
		for ddx in [-16, 0, 16]:
			for ddy in [-8, 0, 8]:
				if absi(ddx) + absi(ddy) * 2 < 16:
					_walk_blocked_cells[Vector2i(ex + ddx, ey + ddy)] = true


## round76：两个格数组是否相同（路线缓存键）
func _same_cells(a: Array, b: Array) -> bool:
	if a.size() != b.size():
		return false
	for i in range(a.size()):
		if (a[i] as Vector2i) != (b[i] as Vector2i):
			return false
	return true


## R76-GUIDE-10：与 `_update_movement` 完全同源的"这一步能否真正走出"（边界 + live 障碍事件）
## movement / dry-run 共用的“目标格可走”判定（同一张阻挡集）。
func _walk_target_ok(from_p: Vector2i, d: Vector2i) -> bool:
	if current_map == null:
		return false
	if int(PALState.scene) == 81 and _s81_restrict_scene == 81:
		return _s81_ground_cell_ok(from_p + d)
	# R241-S85TILE-1：scene85 移动/HUD 同源。
	if int(PALState.scene) == 85:
		return _s85_ground_cell_ok(from_p + d)
	var target: Vector2i = from_p + d
	var block_x: int = PARTY_OFFSET.x / 32
	var block_y: int = PARTY_OFFSET.y / 16
	var tx: int = target.x / 32
	var ty: int = target.y / 16
	if tx < block_x or tx >= current_map.map_pixel_width() / 32 - block_x - 1 \
			or ty < block_y or ty >= current_map.map_pixel_height() / 16 - block_y - 1:
		return false
	# scene4 1F 黑区（与 _update_movement 完全一致）
	if int(PALState.scene) == 4 and _hall_level and _stair_anim_kind == "":
		if target.x < 560 or target.x > 1456 or target.y > 1840:
			return false
	return not _is_obstacle(target.x, target.y)


## R76-GUIDE-10：与 `_update_movement` 完全同源（共用 _walk_target_ok）。
func _step_walkable(from_p: Vector2i, d: Vector2i) -> bool:
	return _walk_target_ok(from_p, d)
func _pick_walkable_dir(p: Vector2i, dist: Dictionary, cur_d: int) -> Vector2i:
	var dirs := [Vector2i(0, 8), Vector2i(16, 0), Vector2i(-16, 0), Vector2i(0, -8)]
	var best := Vector2i(0, 0)
	var best_d := 1 << 30
	for d in dirs:
		if not _step_walkable(p, d):
			continue
		var nd := 1 << 30
		if dist.has(p + d):
			nd = int(dist[p + d])
		if nd < best_d:
			best_d = nd
			best = d
	return best


func _is_obstacle_fast(x: int, y: int) -> bool:
	if _no_collision:
		return false
	if int(PALState.scene) == 16 and x == 368 and y == 1640:
		return false   # 与 `_is_obstacle` 的 bridge16 特例一致
	if _is_obstacle_tiles(x, y):
		return true
	_ensure_walk_blocked()
	return _walk_blocked_cells.has(Vector2i(x, y))


## 只按地图图块判定障碍（忽略事件对象）；用于怪物等事件挡住引导 BFS 时的兜底。
func _is_obstacle_tiles(x: int, y: int) -> bool:
	var tx := x / 32
	var ty := y / 16
	var h := 0
	var xr := x % 32
	var yr := y % 16
	if xr + yr * 2 >= 16:
		if xr + yr * 2 >= 48:
			tx += 1
			ty += 1
		elif 32 - xr + yr * 2 < 16:
			tx += 1
		elif 32 - xr + yr * 2 < 48:
			h = 1
		else:
			ty += 1
	if current_map == null:
		return true
	return current_map.is_blocked(tx, ty, h)


