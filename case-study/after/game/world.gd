					return
	# R77-A14-9：1F 分段引导（避开北/东侧未绘制黑区，方向均实测可走）：
	#   楼梯落点 → DOWN 到大厅中部(y>=1640) → LEFT 到 x<=1120 → 店门距离场
	var target := Vector2i(976, 1704) if _hall_level else Vector2i(1168, 1368)
	_s4g_block_stairs = _hall_level
	_s4g_build(p, [target], 48)
	if not _s4g_dist.has(p):
		# task-71：场无解时按店门方向轴向回退，保证 HUD 始终给可执行方向（不指向黑区）
		_route_path = []
		_route_markers = [target]
		if _hall_level:
			if absi(p.x - target.x) >= absi(p.y - target.y) * 2:
				_a14g_key = "left" if p.x > target.x else "right"
			else:
				_a14g_key = "up" if p.y > target.y else "down"
			_a14g_left = maxi(1, (absi(p.x - target.x) + absi(p.y - target.y) * 2) / 16)
		else:
			_a14g_key = ""
			_a14g_left = 0
		return
	var cd := int(_s4g_dist[p])
	_a14g_left = cd
	_a14g_key = ""
	for d in [Vector2i(0, -8), Vector2i(0, 8), Vector2i(-16, 0), Vector2i(16, 0)]:
		var n: Vector2i = p + d
		if _s4g_dist.has(n) and int(_s4g_dist[n]) == cd - 1 and _s4g_walk_ok(n.x, n.y):
			if d.y < 0:
				_a14g_key = "up"
			elif d.y > 0:
				_a14g_key = "down"
			elif d.x < 0:
				_a14g_key = "left"
			else:
				_a14g_key = "right"
			break
	# 沿场下降生成 path（供黄点/文本一致；不参与判定）
	# PERF：路径数组用于 crumbs，按位置/时间门控重建；key/dist 每帧仍实时算
	var rebuild_path := true
	if p == _route_path_p and Engine.get_process_frames() - _route_path_fr <= 15:
		rebuild_path = false
	elif not _route_path.is_empty():
		for pc in _route_path:
			if (pc as Vector2i) == p:
				rebuild_path = false
				break
	if not rebuild_path:
		return
	var path: Array = []
	var cur := p
	var guard := 0
	while guard < 400 and int(_s4g_dist.get(cur, 0)) > 0:
		guard += 1
		var cdd := int(_s4g_dist[cur])
		var nxt := cur
		for d2 in [Vector2i(0, -8), Vector2i(0, 8), Vector2i(-16, 0), Vector2i(16, 0)]:
			var n2: Vector2i = cur + d2
			if _s4g_dist.has(n2) and int(_s4g_dist[n2]) == cdd - 1 and _s4g_walk_ok(n2.x, n2.y):
				nxt = n2
				break
		if nxt == cur:
			break
		cur = nxt
		path.append(cur)
	_route_path = path
	_route_markers = [target]
	_route_path_p = p
	_route_path_fr = Engine.get_process_frames()



func _update_route_hint() -> void:
	# round72/F93 方案A（用户批准）：过场/脚本播放期间（含楼梯动画 35682/35655）不结算出口区域。
	# 楼梯脚本会把队伍分步移到另一层，若在动画中间结算 _refresh_exit_area，会用"不可走格"
	# 算出假出口格并缓存（落点首帧 near 误判 → 按住 DOWN 直接出门、一楼大厅无法行走）。
	# 脚本结束（player_busy=false 且 VM 结束）后的第一次更新会从新落点重算。
	if (player_busy or (vm != null and vm.is_active())) and int(PALState.scene) in [17, 18, 19, 20, 21]:
		_refresh_guide_hud(true)
	if player_busy or (vm != null and vm.is_active()):
		return
	var sc := int(PALState.scene)
	# R78-STREET-5：A14 街道（落点已校正）→ 村道口 反向距离场；到出口附近 SPACE
	if sc == 5 and int(PALState.vars.get("a13_stage", 0)) >= 1 \
			and int(PALState.vars.get("a14_stage", 0)) < 1:
		_update_a5_route()
		_refresh_guide_hud(false)
		return
	# round75/P0：事件活表被脚本/auto 脚本改动过（如开场 auto 39 把门 evt4 state 置 1）→
	# 重扫换场景门；门集合变化则让出口区域缓存失效（黄框/面包屑按新状态重算）。
	if _scene_doors_dirty:
		_scene_doors_dirty = false
		_walk_blocked_scene = -9999   # round76：事件 state 可能变化 → 障碍缓存失效
		if _refresh_scene_doors():
			_exit_area_scene = -1
		_refresh_room_doors()
	if sc != 18 and sc != 17 and sc != 19 and sc != 20 and sc != 21:
		_refresh_guide_hud(false)
	# round74/P6（task-9）：场景16 密林出口为原版 mode5 触碰门，但地形是单格之字崖壁缝且无路标，
	# 黑盒不可发现 → 单独给真实引导（黄面包屑/边缘箭头/出口黄框），不改触发/不加宽区域。
	# R76-STUTTER-2：岛链/16/18 缓存有效时跳过全图 BFS（此前每 30 帧必 BFS，单次 0.3~0.9s）
	var pp_cache := abs_party()
	if sc == 16:
		# R77-FIX-6：已取紫金丹返程 → 岛链反向距离场回码头
		if _island_return_mode():
			_update_route_hint_island()
			_refresh_guide_hud(false)
			return
		var need16 := _route_path.is_empty()
		if not need16:
			var idx16 := _route_idx_of(pp_cache)
			need16 = idx16 < 0 and not _s18_step_allowed(pp_cache, _route_path[0])
		if need16 and Engine.get_process_frames() - _route16_empty_frame >= 180:
			_update_route_hint_scene16()
		return
	if sc == 18:
		var t18 := _scene18_next_target()
		var stand18: Vector2i = t18[1]
		var valid18 := _route18_stand == stand18 and not _route_path.is_empty() \
			and (_route_idx_of(pp_cache) >= 0 or _s18_step_allowed(pp_cache, _route_path[0]))
		if not valid18:
			_update_route_hint_scene18()
		_guide_action = "用锤!"
		_refresh_guide_hud(false)
		return
	if sc == 15:
		# R77-FIX-6：仙灵岛码头返程 → 与船夫对话；反向距离场
		if _island_return_mode():
			_update_route_hint_island()
			return
	if sc == 17 or sc == 19 or sc == 20 or sc == 21:
		var gt := _island_guide_target()
		var valid_island := not gt.is_empty() and not _route_path.is_empty() and _route18_stand == Vector2i(gt["target"]) \
			and (_route_idx_of(pp_cache) >= 0 or _s18_step_allowed(pp_cache, _route_path[0]))
		if not valid_island:
			_update_route_hint_island()
		_refresh_guide_hud(false)
		return
	# R77-FIX-1：scene4 有 A6 剧情引导时，crumbs/_route_path 由 _sync_a6_crumbs 单一来源提供
	if sc == 4 and _a6_guide_active():
		_route_path = []
		_guide_crumb_override = false
		return
	# R77-A14-3：A14 阶段 scene4 引导单源（反向距离场），屏蔽旧 exit-route 目标抖动
	if sc == 4 and int(PALState.vars.get("a13_stage", 0)) >= 1 \
			and int(PALState.vars.get("a14_stage", 0)) < 1:
		_update_a14_route()
		_refresh_guide_hud(false)
		return
	var groups: Dictionary = SCENE_EXIT_GROUPS.get(sc, {})
	if groups.is_empty():
		_route_path = []
		_route_markers = []
		return
	# R77-FIX-3：exit-route 组/目标 18 帧滞回（大厅多目标切换时 N 不回升/方向不翻回）
	var prev_group := _route_group
	var eg_new := _active_exit_group()
	if eg_new != _exit_grp_keep:
		if _exit_grp_key == eg_new:
			_exit_grp_frames += 1
		else:
			_exit_grp_key = eg_new
			_exit_grp_frames = 0
		if _exit_grp_keep == "" or _exit_grp_frames >= 18:
			_exit_grp_keep = eg_new
			_exit_grp_frames = 0
	else:
		_exit_grp_key = ""
		_exit_grp_frames = 0
	_route_group = _exit_grp_keep
	var em_new := _active_exit_markers()
	var em_key := str(em_new)
	if em_key != _exit_tgt_key:
		if _exit_tgt_key != em_key:
			_exit_tgt_key = em_key
			if _exit_tgt_keep.is_empty():
				_exit_tgt_keep = em_new
				_exit_tgt_frames = 0
			else:
				_exit_tgt_frames = 0
		else:
			_exit_tgt_frames += 1
		if _exit_tgt_frames >= 18:
			_exit_tgt_keep = em_new
			_exit_tgt_frames = 0
	elif _exit_tgt_keep.is_empty():
		_exit_tgt_keep = em_new
		_exit_tgt_frames = 0
	_route_markers = _exit_tgt_keep if not _exit_tgt_keep.is_empty() else em_new
	if _route_group != prev_group and sc == 4 and _hint_panel != null:
		_show_scene_hint()   # 区域切换（回廊→大厅）时重新提示当前区域出口
	# round6 设计层修复：店门等换场景门的触碰半径内不可达时，改为"走到离门最近的
	# 可行走格（出口区域）即触发"；面包屑/下一格箭头都指向该出口区域格。
	# round13：楼梯动画会把队伍瞬移到另一层，出口区域格必须按"新位置"重算，
	# 否则黄框/面包屑会停在楼上（黑盒看到"黄框在画面左上"）。
	# round72/F93：重算时机限制在非过场帧（函数开头 early-return），保证按"落地后的新位置"重算。
	if (_exit_area_scene == sc and _exit_area_cell.x >= 0 and _exit_area_from.x >= 0
			and absi(abs_party().x - _exit_area_from.x) + absi(abs_party().y - _exit_area_from.y) * 2 > 320):
		_exit_area_scene = -1
	if _exit_area_scene != sc or _exit_area_group != _route_group:
		_refresh_exit_area()
	var area_mode: bool = _exit_area_cell.x >= 0 and _exit_area_group == _route_group
	if area_mode:
		_route_markers = [_exit_area_cell]
	# R77-FIX-4b：scene4 出口路线也用反向距离场（与移动同源）重建 _route_path；N=dist
	if sc == 4 and not _route_markers.is_empty():
		var s4p := abs_party()
		_s4g_build(s4p, _route_markers, 48)
		if _s4g_dist.has(s4p):
			var s4path: Array = []
			var s4cur := s4p
			var s4guard := 0
			while s4guard < 400 and int(_s4g_dist.get(s4cur, 0)) > 0:
				s4guard += 1
				var s4d := int(_s4g_dist[s4cur])
				var s4next := s4cur
				for s4dd in [Vector2i(0, -8), Vector2i(0, 8), Vector2i(-16, 0), Vector2i(16, 0)]:
					var s4n: Vector2i = s4cur + s4dd
					if _s4g_dist.has(s4n) and int(_s4g_dist[s4n]) == s4d - 1 and _s4g_walk_ok(s4n.x, s4n.y):
						s4next = s4n
						break
				if s4next == s4cur:
					break
				s4cur = s4next
				s4path.append(s4cur)
			_route_path = s4path
			_route_markers = [s4cur] if not s4path.is_empty() else _route_markers
			_route_cache_scene = sc
			_route_cache_group = _route_group
			_route_cache_targets = _route_markers.duplicate()
			_route_cache_area = false
			_route_cache_start = s4p
			return
	var targets: Array = _route_markers
	if targets.is_empty():
		_route_path = []
		return
	var tol := 8 if area_mode else (80 if (_route_group == "street" or _route_group == "dock" or _route_group == "village") else 24)
	var avoids: Array = SCENE_DOOR_AVOID.get(sc, [])
	var start := abs_party()
	# round76：路线缓存——玩家沿缓存路线前进时只挪游标（pop_front），不重算 BFS（行走时 BFS≈0 次/秒）
	if _route_cache_scene == sc and _route_cache_group == _route_group \
			and _route_cache_area == area_mode and _same_cells(_route_cache_targets, targets):
		if not _route_path.is_empty() and (_route_path[0] as Vector2i) == start:
			_route_path.pop_front()
			_route_cache_start = start
			return
		if _route_cache_start == start:
			return
		_route_cache_start = start
	var dirs := [Vector2i(16, 0), Vector2i(-16, 0), Vector2i(0, 8), Vector2i(0, -8)]
	# round9：回客房门已改为"按空格才进"、不再被动传送，出口区域模式下**不再避门**，
	# 保证从一楼落点到门口缺口一定能 BFS 出连续面包屑（round9 卡厨房区的根因就是这里）。
	var passes := 1 if (_route_group == "street" or _route_group == "dock" or _route_group == "village" or area_mode) else 2
	for pass_i in range(passes):
		var prev := {start: start}
		var queue: Array = [start]
		var head := 0
		var goal := start
		var found := false
		while head < queue.size() and head < 40000:
			var p: Vector2i = queue[head]
			head += 1
			for t in targets:
				if absi(p.x - int(t.x)) + absi(p.y - int(t.y)) * 2 < tol:
					goal = p
					found = true
					break
			if found:
				break
			for d in dirs:
				var n: Vector2i = p + d
				if prev.has(n):
					continue
				if _is_obstacle_fast(n.x, n.y):
					continue
				if pass_i == 0 and not area_mode:
					var bad := false
					for a in avoids:
						if absi(n.x - int(a.x)) + absi(n.y - int(a.y)) * 2 < 48:
							bad = true
							break
					if bad:
						continue
				prev[n] = p
				queue.append(n)
		if found:
			var path: Array = []
			var cur := goal
			while cur != start:
				path.append(cur)
				cur = prev[cur]
			path.reverse()
			_route_path = path
			_route_cache_scene = sc
			_route_cache_group = _route_group
			_route_cache_targets = targets.duplicate()
			_route_cache_area = area_mode
			_route_cache_start = start
			return
	_route_path = []
	_route_cache_scene = sc
	_route_cache_group = _route_group
	_route_cache_targets = targets.duplicate()
	_route_cache_area = area_mode
	_route_cache_start = start


