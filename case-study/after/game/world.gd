func _s70_bottom_id_at(p: Vector2i) -> int:
	if current_map == null:
		return -1
	var slot: int = int(current_map.call("slot_at_pixel", p.x, p.y))
	if slot < 0:
		return -1
	var idx := current_map.get("_bottom_index") as PackedInt32Array
	if idx == null or slot >= idx.size():
		return -1
	return int(idx[slot])


func _ensure_s70_path_cells() -> void:
	if not _s70_path_cells.is_empty():
		return
	# R206-S70BLUE-1：用户蓝线为通路中线；只放行蓝线附近、且 tile 属于道路纹理（id2/3/42/45）的实际路面。
	var r := 48
	for i in range(S70_RED_PATH.size() - 1):
		var a: Vector2i = S70_RED_PATH[i]
		var b: Vector2i = S70_RED_PATH[i + 1]
		var steps := maxi(1, a.distance_to(b) / 8)
		for s in range(steps + 1):
			var p := a + (b - a) * s / steps
			for dx in range(-r, r + 1, 16):
				for dy in range(-r / 2, r / 2 + 1, 8):
					var q := Vector2i(((p.x + dx) / 16) * 16, ((p.y + dy) / 8) * 8)
					if _s70_bottom_id_at(q) in S70_ROAD_IDS:
						_s70_path_cells[q] = true
	# 洞口/门 evt1372：允许道路纹理与洞口石阶 tile；草/芦苇 id19/25 等仍不可走。
	for x in range(1200, 1505, 16):
		for y in range(740, 921, 8):
			var qd := Vector2i(x, y)
			var bid := _s70_bottom_id_at(qd)
			if bid in S70_ROAD_IDS or bid in S70_DOOR_IDS:
				_s70_path_cells[qd] = true
	# R206：蓝线终点到 evt1372 洞门只差 2~3 格；用洞口石阶/道路 + 门口极窄过渡（仅 id17/19 且距门<120）。
	var bstart: Vector2i = S70_RED_PATH[S70_RED_PATH.size() - 1]
	var bend := Vector2i(1424, 808)
	for ss in range(0, 17):
		var bp: Vector2i = bstart + (bend - bstart) * ss / 16
		for dx in range(-16, 17, 16):
			for dy in range(-8, 9, 8):
				var qb := Vector2i(((bp.x + dx) / 16) * 16, ((bp.y + dy) / 8) * 8)
				var bidb := _s70_bottom_id_at(qb)
				var near_door := absi(qb.x - bend.x) + absi(qb.y - bend.y) * 2 < 120
				if bidb in S70_ROAD_IDS or bidb in S70_DOOR_IDS or (near_door and bidb in [17, 19]):
					_s70_path_cells[qb] = true
	print("[a30] scene70 blue path cells=%d" % _s70_path_cells.size())


