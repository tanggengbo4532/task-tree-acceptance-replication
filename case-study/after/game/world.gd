	var idx := 0
	var kept := 0
	for eid in range(1425, 1487):
		if eid <= 0 or eid > sss.events.size():
			continue
		if not _is_encounter_event(eid):
			continue
		idx += 1
		var o: Array = sss.event(eid)
		o[PalData.EO_AUTO_SCRIPT] = 0   # 全部取消追击
		# R188：scene77 只保留 1 场普通遭遇（第3个），其余收起；Boss/剧情不受影响。
