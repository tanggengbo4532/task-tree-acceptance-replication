func _s18_leaf_cells() -> Dictionary:
	var leaf_cells := {}
	for id in range(evt_start + 1, evt_end + 1):
		var lo: Array = sss.event(id)
		if int(lo[PalData.EO_SPRITE]) == 84 and int(lo[PalData.EO_TRIGGER_MODE]) >= 4 and int(lo[PalData.EO_STATE]) > 0:
			leaf_cells[Vector2i(int(lo[PalData.EO_X]), int(lo[PalData.EO_Y]))] = true
	return leaf_cells


## R20-A：构建静态 walk 网格（一次性；事件阻挡按 metric<16 标 3x3 格；地图 tile/边界逐格判）。
func _s18_walk_build() -> void:
	_s18_walk_grid.clear()
	_s18_walk_blocked.clear()
	# R21：事件阻挡集合与 live `_is_obstacle` 同源——只判 state>=2（**不**再看 sprite，
	# 隐形/无精灵阻挡格也会被 live 拒绝，R20 漏判它导致 77~79 走廊倒转）
	for id in range(evt_start + 1, evt_end + 1):
		var lo: Array = sss.event(id)
		if int(lo[PalData.EO_STATE]) < 2:
			continue
		var ex := int(lo[PalData.EO_X])
		var ey := int(lo[PalData.EO_Y])
		for ddx in [-16, 0, 16]:
			for ddy in [-8, 0, 8]:
				var c := Vector2i(ex + ddx, ey + ddy)
				if absi(c.x - ex) + absi(c.y - ey) * 2 < 16:
					_s18_walk_blocked[c] = true
	_s18_walk_built_for = int(PALState.scene)
	var block_x: int = PARTY_OFFSET.x / 32
	var block_y: int = PARTY_OFFSET.y / 16
	var wpx: int = current_map.map_pixel_width()
	var hpx: int = current_map.map_pixel_height()
	for gx in range(0, wpx, 16):
		for gy in range(0, hpx, 8):
			var p := Vector2i(gx, gy)
			var tx := gx / 32
			var ty := gy / 16
			if tx < block_x or tx >= wpx / 32 - block_x - 1 or ty < block_y or ty >= hpx / 16 - block_y - 1:
				continue
			if _is_obstacle_tiles(gx, gy):
				continue
			if _s18_walk_blocked.has(p):
				continue
			_s18_walk_grid[p] = true


## R20-A：从目标石像使用格反向 BFS，建立"任意格→目标"距离场（静态网格 + 荷叶 pass；最终步由 live step_allowed 校验）。
func _s18_stone_build(stand: Vector2i, pass_i: int) -> void:
	# R21：目标变化（破一座石像→事件 state 变化）时网格必须重建（live 同源）
	if _s18_stone_stand != stand:
		_s18_walk_built_for = -9999
	_s18_stone_stand = stand
	_s18_stone_pass = pass_i
	_s18_stone_dirty = false
	_s18_stone_dist.clear()
	_s18_stone_next.clear()
	if _s18_walk_built_for != int(PALState.scene) or _s18_walk_grid.is_empty():
		_s18_walk_build()
	var leaf_cells := _s18_leaf_cells()
	var dirs := [Vector2i(16, 0), Vector2i(-16, 0), Vector2i(0, 8), Vector2i(0, -8)]
	_s18_stone_dist[stand] = 0
	var queue: Array = [stand]
	var head := 0
	while head < queue.size() and head < 90000:
		var p: Vector2i = queue[head]
		head += 1
		for d in dirs:
			var n: Vector2i = p + d
			if _s18_stone_dist.has(n):
				continue
			if not _s18_walk_grid.has(n):
				continue
			if pass_i == 0 and leaf_cells.has(n):
				continue
			var ekey := "%d,%d>%d,%d" % [n.x, n.y, p.x, p.y]
			if _s18_stone_blocked_edges.has(ekey):
				continue
			_s18_stone_dist[n] = int(_s18_stone_dist[p]) + 1
			_s18_stone_next[n] = p
			queue.append(n)


## R21：玩家不在 pass0 场时，用 pass0 网格 BFS 接回最近可达场格（不重建全局 pass1；允许从荷叶格迈出第一步）。
func _s18_stone_connect(pp: Vector2i, stand: Vector2i) -> Array:
	var dirs := [Vector2i(16, 0), Vector2i(-16, 0), Vector2i(0, 8), Vector2i(0, -8)]
	var prev := {pp: pp}
	var queue: Array = [pp]
	var head := 0
	var hit := Vector2i(-1, -1)
	while head < queue.size() and head < 6000:
		var p: Vector2i = queue[head]
		head += 1
		if p != pp and _s18_stone_dist.has(p):
			hit = p
			break
		for d in dirs:
			var n: Vector2i = p + d
			if prev.has(n):
				continue
			if not _s18_walk_grid.has(n):
				continue
			if not _s18_step_allowed(p, n):
				continue
			prev[n] = p
			queue.append(n)
	if hit.x < 0:
		return []
	var back: Array = []
	var cur := hit
	while cur != pp:
		back.append(cur)
		cur = prev[cur]
	back.reverse()
	var path: Array = [pp]
	path.append_array(back)
	# 接上场格后的主路线
	cur = hit
	var guard := 0
	while cur != stand and guard < 4000:
		guard += 1
		if not _s18_stone_next.has(cur):
			return []
		cur = _s18_stone_next[cur]
		path.append(cur)
	if cur != stand:
		return []
	return path


## R20-A/R21：取"当前格→目标使用格"的反向距离场路线（含当前格）。
## 被挡方向以有向边排除并重建场（最多 32 次）；不可达/超限返回 []（HUD 等待，不回退旧 BFS）。
func _s18_stone_path(pp: Vector2i, stand: Vector2i) -> Array:
	for attempt in range(8):
		if _s18_stone_stand != stand or _s18_stone_dirty or _s18_stone_dist.is_empty():
			_s18_stone_build(stand, 0)
		var path: Array = []
		if not _s18_stone_dist.has(pp):
			# R21：不重建全局 pass1；用 pass0 网格接回最近可达场格（骑乘滑行落点/偏离）
			path = _s18_stone_connect(pp, stand)
			if path.is_empty():
				_s18_diag_dump("no-connect", pp, stand)
				return []
			return path
		if int(_s18_stone_dist.get(pp, 1)) == 0:
			return [pp]
		# 沿 next 链构造；若某步 live 不可走 → 登记有向边 → 重建场后重试（不换旧 BFS）
		path = [pp]
		var cur: Vector2i = pp
		var bad := false
		var guard := 0
		while cur != stand and guard < 4000:
			guard += 1
			if not _s18_stone_next.has(cur):
				bad = true
				break
			var nxt: Vector2i = _s18_stone_next[cur]
			if not _s18_step_allowed(cur, nxt):
				_s18_stone_blocked_edges["%d,%d>%d,%d" % [cur.x, cur.y, nxt.x, nxt.y]] = true
				_s18_stone_dirty = true
				_s18_stone_rebuilds += 1
				bad = true
				break
			path.append(nxt)
			cur = nxt
		if not bad and cur == stand:
			return path
		if _s18_stone_rebuilds > 32:
			_s18_diag_dump("too-many-rebuilds", pp, stand)
			return []
	_s18_diag_dump("attempts-exhausted", pp, stand)
	return []


## R22-A：无条件诊断——石像段每 15 帧记录一次 HUD/位置/dist/四向 live 判定（缓冲，定期 flush，≤400 行滚动）
