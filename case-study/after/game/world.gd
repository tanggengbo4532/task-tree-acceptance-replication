## 从目标环开始做一次 BFS，返回可达格集合（只用于 A30 目标选择，结果缓存）。
func _build_reach_set(tgt: Vector2i, touch_r: int) -> Dictionary:
	var reach := {}
	var q: Array = []
	for gx in range(tgt.x - touch_r - 16, tgt.x + touch_r + 17, 16):
		for gy in range(tgt.y - touch_r - 16, tgt.y + touch_r + 17, 8):
			var g := Vector2i(gx, gy)
			if reach.has(g):
				continue
			var md := absi(g.x - tgt.x) + absi(g.y - tgt.y) * 2
			if md < touch_r and _s4g_walk_ok(g.x, g.y):
				reach[g] = true
				q.append(g)
	var dirs := [Vector2i(16, 0), Vector2i(-16, 0), Vector2i(0, 8), Vector2i(0, -8)]
	var head := 0
	while head < q.size() and head < 80000:
		var c: Vector2i = q[head]
		head += 1
		for d in dirs:
			var n: Vector2i = c + d
			if reach.has(n) or not _s4g_walk_ok(n.x, n.y):
				continue
			reach[n] = true
			q.append(n)
	return reach


## R174-YELLOWWALK-1：map61/64 只允许黄色土路/洞内石土地面（按 tile 位图主色分类；不按亮度）。
func _is_yellow_ground_tile(id: int) -> bool:
	if current_map == null or id < 0 or id >= current_map.tile_frames.size():
		return false
	if _yellow_tile_cache.has(id):
		return bool(_yellow_tile_cache[id])
	var im: Image = current_map.tile_frames[id]
	var r := 0.0
	var g := 0.0
	var b := 0.0
	var n := 0.0
	for yy in range(im.get_height()):
		for xx in range(im.get_width()):
			var c := im.get_pixel(xx, yy)
			if c.a > 0.1:
				r += c.r
				g += c.g
				b += c.b
				n += 1
	var ok := false
	if n > 0:
		r /= n
		g /= n
		b /= n
		var sum := r + g + b
		# R174-YELLOWWALK-1：只认“土黄/棕土路面”（r 明显大于 g，b 低）；
		# 排除草丛（r≈g/偏绿）、水、void/黑底，也排除用户参考图里的草格。
		if sum >= 0.24 and r >= 0.20 and g >= 0.13 and b < 0.22 \
				and r >= g * 1.10 and b < g * 0.80:
			ok = true
	_yellow_tile_cache[id] = ok
	return ok


func _is_yellow_cell_ok(x: int, y: int) -> bool:
