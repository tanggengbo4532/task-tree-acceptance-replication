## R154-MAPDECOR-1：scene55/map59 村外草地的“同 tileset 运行时装饰”。
## 只把 MAP59 自带的草/花/碎石图块 blend 到已预渲染的 bottom/layer_top 图像上；
## 不修改 _bottom_index/_top_index/blocked/has_content，不动事件/路线，HUD N 保持不变。
func _decorate_map59() -> void:
	if current_map == null or int(current_map.map_index) != 59:
		return
	# R155-MAPDECOR-2：同 tileset 的“地被 + 灌木/碎石带 + 踩踏土路”增强；只写 bottom/layer_top 图像，
	# 不修改 _bottom_index/_top_index/blocked/has_content，不动事件/碰撞/路线/N。
	var dark: Array = [10, 20, 63, 21, 41, 81, 82]
	var dirt: Array = [16, 413, 507, 85, 15]
	var grass: Array = [10, 12, 14, 15, 21, 41, 49, 50, 63, 81, 82, 93, 162, 193, 507]
	var tuft: Array = [4, 13, 8, 5, 11, 6, 22, 39, 36, 24, 52, 19, 26, 54, 95, 37, 85, 30, 61]
	var rock: Array = [95, 85, 61, 37, 30]
	var origin: Vector2i = PalMap.ORIGIN_SHIFT
	var seed_i := 0x5A17
	# 1) 左侧相机黑边遮挡带：x<160 是原版不可走的图外区；直接按“图像坐标”覆盖，遮住锯齿黑边。
	#    底层密铺深色草，top 层随机撒灌木/草簇，避免整格对齐的方块感。
	var edge_y0: int = 320 + origin.y
	var edge_y1: int = 1471 + origin.y
	for py_img in range(edge_y0, edge_y1, 8):
		for xx in range(0, 192, 16):
			seed_i = (seed_i * 1103515245 + 12345) & 0x7FFFFFFF
			_blend_map_tile(current_map.bottom, int(dark[seed_i % dark.size()]), Vector2i(xx, py_img))
			if (seed_i >> 13) % 4 != 0:
				_blend_map_tile(current_map.layer_top, int(tuft[(seed_i >> 5) % tuft.size()]),
					Vector2i(xx + ((seed_i >> 9) % 2) * 8, py_img + ((seed_i >> 11) % 3) - 1))
		for k in range(4):
			seed_i = (seed_i * 1103515245 + 12345) & 0x7FFFFFFF
			var hx: int = ((seed_i >> 5) % 12) * 16
			var hy: int = py_img + ((seed_i >> 9) % 3 - 1) * 8
			_blend_map_tile(current_map.layer_top, int(tuft[(seed_i >> 3) % tuft.size()]), Vector2i(hx + 8, hy))
	# 2) 村道踩踏痕：沿 (160,432)→evt926 的真实路径铺土色/干草变体，路缘撒碎石（仅图像层）。
	var path_pts: Array = [
		Vector2i(160, 432), Vector2i(160, 512), Vector2i(160, 592), Vector2i(160, 672),
		Vector2i(160, 752), Vector2i(160, 832), Vector2i(160, 912), Vector2i(176, 984),
		Vector2i(256, 1024), Vector2i(240, 1096), Vector2i(256, 1168), Vector2i(256, 1248),
		Vector2i(192, 1296),
	]
	for pi in range(path_pts.size() - 1):
		var a: Vector2i = path_pts[pi]
		var b: Vector2i = path_pts[pi + 1]
		var span := maxi(absi(b.x - a.x), absi(b.y - a.y) * 2)
		var cnt := maxi(1, span / 2)
		for s in range(cnt + 1):
			var t := float(s) / float(cnt)
			var px := int(round(lerpf(float(a.x), float(b.x), t) / 16.0)) * 16
			var py := int(round(lerpf(float(a.y), float(b.y), t) / 8.0)) * 8
			seed_i = (seed_i * 1103515245 + 12345) & 0x7FFFFFFF
			_blend_map_tile(current_map.bottom, int(dirt[seed_i % dirt.size()]), Vector2i(px + origin.x, py + origin.y))
			if s % 3 == 0:
				var ex := px + (16 if (s / 3) % 2 == 0 else -16)
				_blend_map_tile(current_map.layer_top, int(rock[(seed_i >> 7) % rock.size()]),
					Vector2i(ex + origin.x, py + origin.y))
			if s % 4 == 0:
				_blend_map_tile(current_map.bottom, int(grass[(seed_i >> 9) % grass.size()]),
					Vector2i(px + 16 + origin.x, py + origin.y))
	# 3) 草地簇：灌木状 top overlay + 地被色块，分布加密。
	var centers: Array = [
		Vector2i(200, 464), Vector2i(264, 528), Vector2i(208, 640), Vector2i(304, 720),
		Vector2i(224, 832), Vector2i(288, 944), Vector2i(208, 1056), Vector2i(272, 1168),
		Vector2i(192, 1264), Vector2i(336, 600), Vector2i(400, 760), Vector2i(336, 920),
		Vector2i(400, 1080), Vector2i(320, 1240), Vector2i(448, 520), Vector2i(464, 880),
		Vector2i(480, 640), Vector2i(544, 800), Vector2i(512, 1000), Vector2i(384, 1320),
		Vector2i(288, 440), Vector2i(368, 480), Vector2i(240, 1480), Vector2i(432, 1440),
	]
	for c in centers:
		for i in range(14):
			seed_i = (seed_i * 1103515245 + 12345) & 0x7FFFFFFF
			var ax := int(c.x) + ((seed_i >> 7) % 9 - 4) * 16
			var ay := int(c.y) + ((seed_i >> 15) % 9 - 4) * 8
			if ax < 160 or ay < 160 or ax >= PalMap.IMG_W - 160 or ay >= PalMap.IMG_H - 80:
				continue
			if _is_obstacle(ax, ay):
				continue
			var ipx := ax + origin.x
			var ipy := ay + origin.y
			match i % 5:
				0, 1:
					_blend_map_tile(current_map.bottom, int(grass[seed_i % grass.size()]), Vector2i(ipx, ipy))
				2:
					_blend_map_tile(current_map.layer_top, int(tuft[(seed_i >> 3) % tuft.size()]), Vector2i(ipx, ipy))
				3:
					_blend_map_tile(current_map.layer_top, int(tuft[(seed_i >> 11) % tuft.size()]), Vector2i(ipx + 8, ipy + 4))
				_:
					_blend_map_tile(current_map.bottom, int(grass[(seed_i >> 17) % grass.size()]), Vector2i(ipx + 16, ipy))
	# 4) 两处石堆地标（同 tileset 碎石 top overlay；纯视觉，不挡路）。
	for lm in [Vector2i(208, 560), Vector2i(256, 1160)]:
		for k in range(9):
			seed_i = (seed_i * 1103515245 + 12345) & 0x7FFFFFFF
			var rx := int(lm.x) + ((seed_i >> 7) % 5 - 2) * 16
			var ry := int(lm.y) + ((seed_i >> 15) % 5 - 2) * 8
			if _is_obstacle(rx, ry):
				continue
			_blend_map_tile(current_map.layer_top, int(rock[seed_i % rock.size()]),
				Vector2i(rx + origin.x, ry + origin.y))


func _blend_map_tile(target: Image, tile_id: int, pos: Vector2i) -> void:
	if target == null or current_map == null:
		return
	if tile_id < 0 or tile_id >= current_map.tile_frames.size():
		return
	var im: Image = current_map.tile_frames[tile_id]
	if im == null:
		return
	var px := pos.x
	var py := pos.y
	if px < 0 or py < 0 or px >= target.get_width() or py >= target.get_height():
		return
	var w := mini(im.get_width(), target.get_width() - px)
	var h := mini(im.get_height(), target.get_height() - py)
	if w <= 0 or h <= 0:
		return
	target.blend_rect(im, Rect2i(0, 0, w, h), Vector2i(px, py))


func _render() -> void:
	if current_map == null:
		return
	_img.fill(Color(0, 0, 0, 1))
	var src := Rect2i(PALState.viewport.x + PalMap.ORIGIN_SHIFT.x, PALState.viewport.y + PalMap.ORIGIN_SHIFT.y, SCREEN_W, SCREEN_H)
	var safe := Rect2i(src)
	if safe.position.x < 0:
		safe.position.x = 0
	if safe.position.y < 0:
		safe.position.y = 0
	if safe.end.x > PalMap.IMG_W:
		safe.size.x = PalMap.IMG_W - safe.position.x
	if safe.end.y > PalMap.IMG_H:
		safe.size.y = PalMap.IMG_H - safe.position.y
	if safe.size.x <= 0 or safe.size.y <= 0:
		return
	var dst := safe.position - src.position
	_img.blit_rect(current_map.bottom, safe, dst)
	_img.blend_rect(current_map.layer_top, safe, dst)

	var drawables: Array = []
	_collect_party(drawables)
	_collect_events(drawables)
	drawables.sort_custom(func(a, b): return a["sy"] < b["sy"])
	for d in drawables:
		var img: Image = d["img"]
		var px: int = d["x"]
		var py: int = d["y"]
		var w: int = img.get_width()
		var h: int = img.get_height()
		var sx0 := maxi(0, -px)
		var sy0 := maxi(0, -py)
		if sx0 >= w or sy0 >= h:
			continue
		var dw := mini(w - sx0, SCREEN_W - px - sx0)
		var dh := mini(h - sy0, SCREEN_H - py - sy0)
		if dw <= 0 or dh <= 0:
			continue
		_img.blend_rect(img, Rect2i(sx0, sy0, dw, dh), Vector2i(px + sx0, py + sy0))
	_h1_occlusion_overlay(drawables)
	_draw_scene_markers()
	_draw_route_hint()
	_apply_wave()
	if _tex != null:
		_tex.update(_img)


## H-1：玩家被前景（排序在其后绘制的事件/cover tile sprite）覆盖时，以半透明重绘，保证可见（原版手感）。
## 不改碰撞/触发；平滑淡入淡出（_occlude_alpha 0→0.55→0）。
func _h1_occlusion_overlay(drawables: Array) -> void:
	var leader_idx := -1
	for i in range(drawables.size()):
		if bool((drawables[i] as Dictionary).get("party", false)):
			leader_idx = i
			break
	var occluded := false
	if leader_idx >= 0:
		var ld: Dictionary = drawables[leader_idx]
		var lw: int = (ld["img"] as Image).get_width()
		var lh: int = (ld["img"] as Image).get_height()
		var lr := Rect2i(int(ld["x"]), int(ld["y"]), lw, lh)
		for j in range(leader_idx + 1, drawables.size()):
			var dd: Dictionary = drawables[j]
			if bool(dd.get("party", false)):
				continue
			var dw2: int = (dd["img"] as Image).get_width()
			var dh2: int = (dd["img"] as Image).get_height()
			var rr := Rect2i(int(dd["x"]), int(dd["y"]), dw2, dh2)
			if lr.intersects(rr):
				occluded = true
				break
	var target := 0.55 if occluded else 0.0
	if _occlude_alpha < target:
		_occlude_alpha = minf(target, _occlude_alpha + 0.08)
	elif _occlude_alpha > target:
		_occlude_alpha = maxf(target, _occlude_alpha - 0.08)
	if _occlude_alpha <= 0.02:
		return
	for d in drawables:
		var dd2: Dictionary = d
		if not bool(dd2.get("party", false)):
			continue
		var img: Image = dd2["img"]
		var px: int = int(dd2["x"])
		var py: int = int(dd2["y"])
		var w := img.get_width()
		var h := img.get_height()
		var sx0 := maxi(0, -px)
		var sy0 := maxi(0, -py)
		if sx0 >= w or sy0 >= h:
			continue
		var dw := mini(w - sx0, SCREEN_W - px - sx0)
		var dh := mini(h - sy0, SCREEN_H - py - sy0)
		if dw <= 0 or dh <= 0:
			continue
		var ov: Image = img.duplicate()
		if ov.get_format() != Image.FORMAT_RGBA8:
			ov.convert(Image.FORMAT_RGBA8)
		for yy in range(sy0, sy0 + dh):
			for xx in range(sx0, sx0 + dw):
				var c: Color = ov.get_pixel(xx, yy)
				if c.a <= 0.01:
					continue
				c.a *= _occlude_alpha
				ov.set_pixel(xx, yy, c)
		_img.blend_rect(ov, Rect2i(sx0, sy0, dw, dh), Vector2i(px + sx0, py + sy0))

## 选择当前区域的出口目标（按区域分组，如客栈二楼→楼梯、一楼→店门）。
func _active_exit_group() -> String:
	var sc := int(PALState.scene)
	var groups: Dictionary = SCENE_EXIT_GROUPS.get(sc, {})
	if groups.is_empty():
		return ""
	# round13：场景4 含"二楼回廊/楼梯口"与"一楼大厅"两段（同场景 map10）。
	# 二楼回廊 → 出口目标是楼梯口（按住 DOWN 下楼）；一楼大厅 → 出口目标是店门。
	if sc == 4:
		if _hall_level:
			return "street" if groups.has("street") else str(groups.keys()[0])
		return "stairs" if groups.has("stairs") else str(groups.keys()[0])
	# round16/A7：街道 → 村道出口（A6 之后才指路；A6 未完成时提示先回客栈）
	if sc == 5:
		# round75/task-13 F143：A6 起点（phase0）与 1070 后（phase2）都指路村道出口；phase1=回客栈
		if int(_a6_real_phase()) != 1 and groups.has("village"):
			return "village"
		return ""
	if sc == 6:
		return "dock" if groups.has("dock") else str(groups.keys()[0])
	return str(groups.keys()[0])


func _active_exit_markers() -> Array:
	var g := _active_exit_group()
	if g == "":
		return []
	return SCENE_EXIT_GROUPS[int(PALState.scene)][g]


## 画一个 7×7 的实心/描边箭头（pixel 画到 _img）；尖端指向 dir 方向。
func _blit_arrow(pos: Vector2i, dir: String) -> void:
	var fill := Color(1.0, 0.92, 0.25, 1.0)
	var edge := Color(0.55, 0.30, 0.0, 1.0)
	for c in range(0, 7):
		var half: int = (c * 3) / 6
		for r in range(-half, half + 1):
			var px: int = pos.x
			var py: int = pos.y
			match dir:
				"left":
					px = pos.x + c; py = pos.y + r
				"right":
					px = pos.x - c; py = pos.y + r
				"up":
					px = pos.x + r; py = pos.y + c
				_:
					px = pos.x + r; py = pos.y - c
			if px < 0 or py < 0 or px >= SCREEN_W or py >= SCREEN_H:
				continue
			_img.set_pixel(px, py, fill if c < 6 else edge)


