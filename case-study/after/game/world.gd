func _blit_arrow_color(pos: Vector2i, dir: String, fill: Color, edge: Color) -> void:
	for c in range(0, 7):
		var half: int = (c * 3) / 6
		for r in range(-half, half + 1):
			var px: int = pos.x
			var py: int = pos.y
			match dir:
				"left":
					px = pos.x + c; py = pos.y + r
				"right":
					px = pos.x - c; py = pos.y + r
				"up":
					px = pos.x + r; py = pos.y + c
				_:
					px = pos.x + r; py = pos.y - c
			if px < 0 or py < 0 or px >= SCREEN_W or py >= SCREEN_H:
				continue
			_img.set_pixel(px, py, fill if c < 6 else edge)


## round74/P9b：场景18 目标框（青色脚印框+脉冲，不画固定方向箭头；方向只看"下一步箭头"）。
func _blit_target18_box(pos: Vector2i) -> void:
	var fill := Color(0.35, 0.95, 1.0, 1.0)
	var edge := Color(0.10, 0.45, 0.85, 1.0)
	var pulse := (Time.get_ticks_msec() / 400) % 2 == 0
	for i in range(-8, 9):
		for j in range(-4, 5):
			if absi(i) == 8 or absi(j) == 4:
				var gx: int = pos.x + i
				var gy: int = pos.y + j
				if gx >= 0 and gy >= 0 and gx < SCREEN_W and gy < SCREEN_H:
					_img.set_pixel(gx, gy, edge)
	for i in range(-7, 8):
		for j in range(-6, 7):
			var a := absi(i) + absi(j) * 2
			if a > 6 and a < 11:
				var px: int = pos.x + i
				var py: int = pos.y + j
				if px >= 0 and py >= 0 and px < SCREEN_W and py < SCREEN_H:
					_img.set_pixel(px, py, fill if a >= 9 else edge)
	if pulse:
		for i in range(-11, 12):
			for j in range(-9, 10):
				var a2 := absi(i) + absi(j) * 2
				if a2 > 9 and a2 < 13:
					var qx: int = pos.x + i
					var qy: int = pos.y + j
					if qx >= 0 and qy >= 0 and qx < SCREEN_W and qy < SCREEN_H:
						_img.set_pixel(qx, qy, fill)


## round74/P9b：从缓存路线取"当前下一步"目标格（若队伍已在 path[0] 则取 path[1]）。
## task-21：与 `_update_movement()` 完全一致的"这一步能否真正走出"判定（碰撞 + 地图边界）。
## 引导只允许给出这里判定为真的方向，杜绝"HUD 显示 ← 但按了不动"。
## task-22：记录"该格该方向被 movement 层拒绝"（由 _update_movement 调用，引导学习真实移动结果）
func _s18_note_step_blocked(target: Vector2i) -> void:
	if int(PALState.scene) != 18:
		return
	var pp := abs_party()
	if absi(target.x - pp.x) + absi(target.y - pp.y) * 2 != 16:
		return
	if _s18_blocked_at != pp:
		_s18_blocked_at = pp
		_s18_blocked_dirs.clear()
	_s18_blocked_dirs[_key_dir_from_step(pp, target)] = true
	# R21：被挡可能来自事件 state 变化 → 使 walk 网格失效，下次重建 live 网格
	_s18_walk_built_for = -9999
	_s18_stone_blocked_edges["%d,%d>%d,%d" % [pp.x, pp.y, target.x, target.y]] = true
	_s18_stone_rebuilds += 1
	_s18_stone_dirty = true
	if _debug_hud:
		print("[t22] blocked dir note pos=%s dir=%s total=%d" % [
			str(pp), _key_dir_from_step(pp, target), _s18_blocked_dirs.size()])


func _s18_step_allowed(from_p: Vector2i, to_p: Vector2i) -> bool:
	if from_p == to_p:
		return true
	if current_map == null:
		return false
	if absi(to_p.x - from_p.x) + absi(to_p.y - from_p.y) * 2 != 16:
		return false
	# task-22：实测被挡方向（movement 层曾拒绝）→ 引导同样视为不可走
	if _s18_blocked_at == from_p and _s18_blocked_dirs.has(_key_dir_from_step(from_p, to_p)):
		return false
	var block_x: int = PARTY_OFFSET.x / 32
	var block_y: int = PARTY_OFFSET.y / 16
	var tx: int = to_p.x / 32
	var ty: int = to_p.y / 16
	if tx < block_x or tx >= current_map.map_pixel_width() / 32 - block_x - 1 \
			or ty < block_y or ty >= current_map.map_pixel_height() / 16 - block_y - 1:
		return false
	return not _is_obstacle(to_p.x, to_p.y)


## R76-STUTTER-2：当前格在缓存路线中的下标（找不到 -1）；路径可能不含起点（island/16）
func _route_idx_of(p: Vector2i) -> int:
	for i in range(_route_path.size()):
		if (_route_path[i] as Vector2i) == p:
			return i
	return -1


## 当前"下一步"目标格：沿缓存路线走 cursor，只有真正偏离才重规划（带冷却，避免每帧 BFS）。
## allow_replan=false 时（绘制层）只读缓存，不触发任何 BFS。
func _route18_next_point(allow_replan: bool = true) -> Vector2i:
	var pp := abs_party()
	if _route_group == "island":
		var nk1 := _island_next_key_now()
		if nk1 != "":
			var dv2 := Vector2i.ZERO
			match nk1:
				"up":
					dv2 = Vector2i(0, -8)
				"down":
					dv2 = Vector2i(0, 8)
				"left":
					dv2 = Vector2i(-16, 0)
				"right":
					dv2 = Vector2i(16, 0)
			return pp + dv2
	if not _route_path.is_empty():
		var idx := _route_idx_of(pp)
		if idx >= 0:
			_route18_cursor = idx
			if idx + 1 < _route_path.size():
				var nxt: Vector2i = _route_path[idx + 1]
				if _s18_step_allowed(pp, nxt):
					return nxt
				if not allow_replan:
					return Vector2i(-1, -1)
				# 被实际碰撞挡住 → 允许一次重规划
			else:
				return pp
		elif _s18_step_allowed(pp, _route_path[0]):
			# 路径从"下一格"开始（island/16 的路径不含起点）→ 直接作为下一步
			_route18_cursor = -1
			return _route_path[0]
	if not allow_replan:
		return Vector2i(-1, -1)
	# 真正偏离路线：重规划（15 帧冷却；冷却期内返回 (-1,-1)，HUD 显示"等待/寻路中"）
	var fr := Engine.get_process_frames()
	if fr - _route18_replan_frame < 15:
		return Vector2i(-1, -1)
	_route18_replan_frame = fr
	if int(PALState.scene) == 18:
		_update_route_hint_scene18()
	elif int(PALState.scene) == 17 or int(PALState.scene) == 19 \
			or int(PALState.scene) == 20 or int(PALState.scene) == 21:
		_update_route_hint_island()
	elif int(PALState.scene) == 16:
		_update_route_hint_scene16()
	if _route_path.is_empty():
		return Vector2i(-1, -1)
	if (_route_path[0] as Vector2i) == pp and _route_path.size() >= 2:
		return _route_path[1]
	if _s18_step_allowed(pp, _route_path[0]):
		return _route_path[0]
	return Vector2i(-1, -1)

## round74/P9b：当前"下一步按键方向"（↑↓←→），由队伍位置与缓存路线第一格决定。
## R77-FIX-6d：岛链下一步方向——每帧从反向距离场现算（四邻严格 dist-1 且真实可走）。
func _island_next_key_now() -> String:
	if _route_group != "island" or _s4g_dist.is_empty():
		return ""
	var p := abs_party()
	if not _s4g_dist.has(p):
		return ""
	var cd := int(_s4g_dist[p])
	for d in [Vector2i(0, -8), Vector2i(0, 8), Vector2i(-16, 0), Vector2i(16, 0)]:
		var n: Vector2i = p + d
		if not _s4g_dist.has(n) or int(_s4g_dist[n]) != cd - 1:
			continue
		if not _s4g_walk_ok(n.x, n.y):
			continue
		if d.y < 0:
			return "up"
		if d.y > 0:
			return "down"
		if d.x < 0:
			return "left"
		return "right"
	return ""


func _route18_current_key() -> String:
	# R77-FIX-6c：岛链回程用反向距离场直接给下一步方向（不再依赖 _route_idx_of/_s18_blocked_at 的旧路校验，
	# 避免“场里可走但旧 path 校验误判被挡”→ HUD 黄点方向翻转/卡住）。
	if _route_group == "island":
		var nk0 := _island_next_key_now()
		if nk0 != "":
			return nk0
	var np := _route18_next_point()
	if np.x < 0:
		return ""
	return _key_dir_from_step(abs_party(), np)


## round74/P9b：由"当前队伍位置→下一格"求下一步该按的键（等距视角下与方向键一致）。
func _key_dir_from_step(from_p: Vector2i, to_p: Vector2i) -> String:
	var d := to_p - from_p
	if d.x > 0:
		return "right"
	if d.x < 0:
		return "left"
	if d.y < 0:
		return "up"
	if d.y > 0:
		return "down"
	return ""


## 出口区域标记：画在"站上去就能触发"的最近可行走格上（round10：不画在黑边外）。
## 组成：地面格高亮描边（16×8 足迹）+ 黄色闪烁菱形框 + 向下箭头。
## round17：黄色框改为"常画 + 闪烁外圈脉冲"，保证任何时刻截图都能看到。
func _blit_door_area_marker(pos: Vector2i) -> void:
	var fill := Color(1.0, 0.92, 0.25, 1.0)
	var edge := Color(0.80, 0.45, 0.0, 1.0)
	var pulse := (Time.get_ticks_msec() / 400) % 2 == 0
	# 地面格高亮：把该格的 16×8 足迹描一圈，玩家能看出"站这里"
	for i in range(-8, 9):
		for j in range(-4, 5):
			if absi(i) == 8 or absi(j) == 4:
				var gx: int = pos.x + i
				var gy: int = pos.y + j
				if gx >= 0 and gy >= 0 and gx < SCREEN_W and gy < SCREEN_H:
					_img.set_pixel(gx, gy, edge)
	for i in range(-7, 8):
		for j in range(-6, 7):
			var a := absi(i) + absi(j) * 2
			if a > 6 and a < 11:
				var px: int = pos.x + i
				var py: int = pos.y + j
				if px >= 0 and py >= 0 and px < SCREEN_W and py < SCREEN_H:
					_img.set_pixel(px, py, fill if a >= 9 else edge)
	# round17：闪烁外圈（脉冲），远处也能看到"出口在这里"
	if pulse:
		for i in range(-11, 12):
			for j in range(-9, 10):
				var a2 := absi(i) + absi(j) * 2
				if a2 > 9 and a2 < 13:
					var qx: int = pos.x + i
					var qy: int = pos.y + j
					if qx >= 0 and qy >= 0 and qx < SCREEN_W and qy < SCREEN_H:
						_img.set_pixel(qx, qy, fill)
	_blit_arrow(Vector2i(pos.x, pos.y - 20), "down")


