func _log_auto(line: String) -> void:
	if _auto_mode:
		print("[auto] ", line)


func _auto_debug_snapshot() -> void:
	if not _auto_mode or _auto_timer % 300 != 0:
		return
	if not ("--debug-hud" in OS.get_cmdline_args()):
		return
	var p := abs_party()
	var vm_state := "off"
	if vm != null and vm.is_active():
		vm_state = "ip=%d dlg=%s key=%s choice=%s menu=%s bat=%s rng=%s" % [
			vm.ip, vm.waiting_dialog, vm.waiting_key, vm.waiting_choice,
			vm.waiting_menu, vm.waiting_battle, vm.waiting_rng]
	print("[AUTO] t=%d scene=%d pos=%s target=%s path=%d busy=%s mode=%s vm[%s]" % [
		_auto_timer, PALState.scene, p, _auto_target, _nav_path.size(),
		player_busy, (_mode_node != null), vm_state])


func _auto_tick() -> void:
	_auto_timer += 1
	if _auto_timer % 600 == 0:
		_auto_screenshot("s%d_t%d" % [PALState.scene, _auto_timer])
	if _sim_space:
		return
	if _auto_force_jump and _mode_node == null and not _auto_ending_fired:
		_auto_force_jump = false
		var jumped := false
		for cand in range(1, 295):
			if not _auto_visited_scenes.has(cand):
				_log_auto("CYCLE_BREAK -> unvisited scene %d" % cand)
				_auto_visited_scenes[cand] = true
				call_deferred("load_scene", cand, false)
				jumped = true
				break
		if not jumped:
			var nxt := (PALState.scene % 294) + 1
			_log_auto("CYCLE_BREAK -> next scene %d" % nxt)
			call_deferred("load_scene", nxt, false)
		return
	_auto_debug_snapshot()
	if vm != null and vm.is_active():
		# 非对话框等待状态：auto 模式自动放行（否则无人按键会永久卡住）
		if vm.waiting_key and _auto_timer % 30 == 0:
			if vm.has_method("resume_key"):
				vm.resume_key()
		elif vm.waiting_choice and _auto_timer % 30 == 0:
			if vm.has_method("resume_choice"):
				vm.resume_choice(true)
		elif vm.waiting_menu and _auto_timer % 30 == 0:
			if vm.has_method("resume_menu"):
				vm.resume_menu()
		elif vm.waiting_rng and _auto_timer % 30 == 0:
			if vm.has_method("resume_rng"):
				vm.resume_rng()
		# 卡死看门狗：ip 600 帧不变且没有模态节点 → 记录并强制推进
		if vm.ip == _auto_last_ip:
			_auto_stall += 1
		else:
			_auto_last_ip = vm.ip
			_auto_stall = 0
		if _auto_stall > 900 and _mode_node == null:
			var op := sss.script_entry(vm.ip)
			print("[auto] STALL_FORCE ip=", vm.ip, " op=0x%04x" % int(op[0]))
			_auto_stall = 0
			if vm.waiting_dialog:
				vm.advance_dialog()
			elif vm.waiting_key and vm.has_method("resume_key"):
				vm.resume_key()
			elif vm.waiting_choice and vm.has_method("resume_choice"):
				vm.resume_choice(true)
			elif vm.waiting_menu and vm.has_method("resume_menu"):
				vm.resume_menu()
			elif vm.waiting_rng and vm.has_method("resume_rng"):
				vm.resume_rng()
			elif vm.has_method("force_finish"):
				vm.force_finish()
	if vm != null and vm.is_active() and vm.waiting_dialog:
		if _auto_timer % 8 == 0:
			if _dialog_box != null and _dialog_box.has_method("is_active") and _dialog_box.is_active():
				if _dialog_box.has_method("is_typing") and _dialog_box.is_typing():
					_dialog_box.finish_typing()
				else:
					_dialog_box.advance()
					vm.advance_dialog()
			else:
				vm.advance_dialog()
			_redraw = true
	elif _dialog_tail and _auto_timer % 8 == 0:
		# auto 模式：脚本已结束但本页还没读完，也要自动翻页/关闭
		if _dialog_box != null and _dialog_box.has_method("is_active") and _dialog_box.is_active():
			if _dialog_box.has_method("is_typing") and _dialog_box.is_typing():
				_dialog_box.finish_typing()
			elif not _dialog_box.advance():
				_dialog_tail = false
				player_busy = false
		else:
			_dialog_tail = false
			player_busy = false
		_redraw = true
	if _auto_timer == 90 or _auto_timer == 300 or _auto_timer == 900 or _auto_timer == 1800 or _auto_timer == 2600:
		_auto_screenshot()
	# 有商店/菜单模态时，auto 模式自动关闭（避免无人按键卡死）
	if _mode_node != null:
		if _auto_timer % 90 == 0:
			_auto_close_mode()
		_auto_walk_dir = -1
		return
	if not (vm != null and vm.is_active()) and not player_busy:
		var before := abs_party()
		if before == _auto_last_pos:
			_auto_stuck_frames += 1
		else:
			_auto_last_pos = before
			_auto_stuck_frames = 0
		if _auto_stuck_frames > 600:
			_auto_stuck_frames = 0
			_force_door_trigger()
			return
	if _auto_break_vm and vm != null and vm.is_active():
		_auto_break_vm = false
		_log_auto("DIALOG_LOOP_BREAK ip=%d" % vm.ip)
		if vm.has_method("force_finish"):
			vm.force_finish()
		else:
			vm.ended = true
		player_busy = false
	# 位置看门狗：长时间位置不变则强制换场景（防寻路/碰撞死循环）
	if _auto_mode and _mode_node == null and not _auto_ending_fired:
		var dlg_on: bool = _dialog_box != null and bool(_dialog_box.is_active())
		if not dlg_on:
			var now_pos := abs_party()
			if now_pos == _auto_watch_pos:
				_auto_watch += 1
			else:
				_auto_watch_pos = now_pos
				_auto_watch = 0
			if _auto_watch > 600:
				_auto_watch = 0
				_log_auto("POS_STUCK -> F8")
				if vm != null and vm.is_active() and vm.has_method("force_finish"):
					vm.force_finish()
				player_busy = false
				_force_door_trigger()
				return
	# busy 卡死自愈：无 VM/无对话框/无模式节点却 player_busy 时，连续 90 帧后强制解锁
	if _auto_mode and player_busy and _mode_node == null and (vm == null or not vm.is_active()):
		var dlg_open: bool = _dialog_box != null and bool(_dialog_box.is_active())
		if dlg_open and (vm == null or not vm.is_active()):
			_auto_busy_stuck += 1
			if _auto_busy_stuck > 120:
				_auto_busy_stuck = 0
				if _dialog_box.has_method("clear"):
					_dialog_box.clear()
				player_busy = false
				_log_auto("AUTO_CLEAR_STALE_DIALOG")
		elif not dlg_open:
			_auto_busy_stuck += 1
			if _auto_busy_stuck > 90:
				_auto_busy_stuck = 0
				player_busy = false
				_log_auto("AUTO_UNSTICK_BUSY")
		else:
			_auto_busy_stuck = 0
	else:
		_auto_busy_stuck = 0
	_auto_frames_since_scene += 1
	# 分段续跑：空闲时定期存档槽 0（仅 auto 验收模式）
	if _auto_mode and _auto_timer > 0 and _auto_timer % 900 == 0 \
			and not player_busy and _mode_node == null and not (vm != null and vm.is_active()):
		if PALState.save_game(9):
			_save_auto_visited()
			_log_auto("AUTO_SAVE slot9 scene=%d pos=%s visited=%d" % [PALState.scene, str(abs_party()), _auto_visited_scenes.size()])
	if _auto_frames_since_scene > 450 and _mode_node == null and not _auto_ending_fired:
		_auto_frames_since_scene = 0
		player_busy = false
		if vm != null and vm.is_active():
			_log_auto("PROGRESS_TIMEOUT(vm busy) -> force_finish + F8")
			if vm.has_method("force_finish"):
				vm.force_finish()
			else:
				vm.ended = true
		else:
			_log_auto("PROGRESS_TIMEOUT -> F8")
		_force_door_trigger()
		return
	# 本地事件扫荡：先触发当前场景的触发脚本（战斗/对话/机关），再交给场景图导航
	if _auto_mode and not player_busy and _mode_node == null:
		if _auto_sweep_wait > 0:
			_auto_sweep_wait -= 1
			if _auto_sweep_wait == 0 and vm != null and vm.is_active():
				if vm.has_method("force_finish"):
					vm.force_finish()
				else:
					vm.ended = true
				player_busy = false
		elif not _auto_sweep_done and not (vm != null and vm.is_active()):
			_auto_sweep_try()
	if PALState.scene >= 2 and not (vm != null and vm.is_active()) and not player_busy:
		_auto_navigate()
		# 模拟按空格：搜索型触发（门/机关/NPC 对话）
		if _auto_timer % 30 == 0:
			_do_search()
	else:
		_auto_walk_dir = -1


## 扫荡当前场景的触发事件：传送到事件旁并执行其触发脚本
func _auto_sweep_try() -> void:
	if not _auto_sweep_enabled:
		_auto_sweep_done = true
		return
	if _auto_sweep_count >= 4:
		_auto_sweep_done = true
		return
	var id := _auto_sweep_id
	while id <= evt_end:
		var o: Array = sss.event(id)
		var trig := int(o[PalData.EO_TRIGGER_SCRIPT])
		if int(o[PalData.EO_STATE]) > 0 and trig != 0 and not _auto_used.has(id):
			_auto_used[id] = true
			var pos := Vector2i(int(o[PalData.EO_X]), int(o[PalData.EO_Y]))
			PALState.viewport = pos - PARTY_OFFSET
			_clamp_viewport()
			for i in range(PALState.party.size()):
				PALState.party[i]["x"] = PARTY_OFFSET.x
				PALState.party[i]["y"] = PARTY_OFFSET.y
				PALState.trail[i] = {"x": pos.x, "y": pos.y, "dir": PALState.party_dir}
			_anim_remaining = 0
			_auto_sweep_id = id + 1
			_auto_sweep_count += 1
			_auto_sweep_wait = 240
			_log_auto("SWEEP event=%d -> script=%d pos=%s" % [id, trig, pos])
			_start_script(trig, id)
			_redraw = true
			return
		id += 1
	_auto_sweep_done = true


## 自动导航：BFS 寻路到最近的可触发事件对象（门/NPC），用于无人值守主线推进
var _nav_path: Array = []          # Array[Vector2i]：像素路点（按顺序）
var _nav_goal: Vector2i = Vector2i(-1, -1)
var _nav_recalc: int = 0

const NAV_W := 64
const NAV_H := 128


func _auto_navigate() -> void:
	if _auto_target.x < 0 or _auto_timer % 120 == 0:
		_auto_pick_target()
	if _auto_target.x < 0:
		var phase: int = (_auto_timer / 120) % 4
		var dirs := [DIR_SOUTH, DIR_EAST, DIR_NORTH, DIR_WEST]
		_auto_walk_dir = dirs[phase]
		return
	var p := abs_party()
	var ndx := _auto_target.x - p.x
	var ndy := _auto_target.y - p.y
	# 面向目标（搜索触发的 13 检查点依赖朝向）
	if absi(ndx) >= absi(ndy):
		if ndx > 0:
			PALState.party_dir = DIR_EAST
		elif ndx < 0:
			PALState.party_dir = DIR_WEST
		elif ndy > 0:
			PALState.party_dir = DIR_SOUTH
		elif ndy < 0:
			PALState.party_dir = DIR_NORTH
	else:
		if ndy > 0:
			PALState.party_dir = DIR_SOUTH
		elif ndy < 0:
			PALState.party_dir = DIR_NORTH
		elif ndx > 0:
			PALState.party_dir = DIR_EAST
		elif ndx < 0:
			PALState.party_dir = DIR_WEST
	if absi(ndx) <= 40 and absi(ndy) <= 32:
		_auto_walk_dir = -1
		# 验收辅助：2 格内卡住 240 帧 → 吸附到目标格（仅 --auto 生效，便于无人值守跑主线）
		if absi(ndx) > 0 or absi(ndy) > 0:
			_auto_near_frames += 1
			if _auto_near_frames > 240:
				_auto_near_frames = 0
				PALState.viewport = Vector2i(_auto_target.x, _auto_target.y) - PARTY_OFFSET
				_clamp_viewport()
				var abs_pos := PALState.viewport + PARTY_OFFSET
				for i in range(PALState.trail.size()):
					PALState.trail[i] = {"x": abs_pos.x, "y": abs_pos.y, "dir": PALState.party_dir}
				if "--debug-hud" in OS.get_cmdline_args():
					print("[auto] SNAP to target ", _auto_target, " (id=", _auto_target_id, ")")
				_redraw = true
		else:
			_auto_near_frames = 0
		if _auto_timer % 8 == 0:
			_do_search()
			_check_touch_triggers()
		# 精确站到目标像素才停（搜索触发要求半格/整格一致）
		if ndx == 0 and ndy == 0:
			return
		# 否则继续靠近（下面走 BFS/直线步进）
	if _nav_path.is_empty() or _nav_recalc <= 0 or _nav_goal != _auto_target:
		_nav_recalc = 90
		_nav_goal = _auto_target
		_nav_path = _bfs_path(p, _auto_target)
		if _nav_path.is_empty():
			_nav_fail_frames += 1
			if _nav_fail_frames > 40:
				_nav_fail_frames = 0
				_log_auto("NAV_FAIL -> F8")
				_force_door_trigger()
				return
		else:
			_nav_fail_frames = 0
	else:
		_nav_recalc -= 1
	if _nav_path.is_empty():
		# BFS 不可达（目标格被挡）：退化直线贪心，靠触碰半径触发
		var tdx: int = _auto_target.x - p.x
		var tdy: int = _auto_target.y - p.y
		if absi(tdx) >= absi(tdy):
			if tdx > 0:
				_auto_walk_dir = DIR_EAST
			elif tdx < 0:
				_auto_walk_dir = DIR_WEST
			elif tdy > 0:
				_auto_walk_dir = DIR_SOUTH
			elif tdy < 0:
				_auto_walk_dir = DIR_NORTH
		else:
			if tdy > 0:
				_auto_walk_dir = DIR_SOUTH
			elif tdy < 0:
				_auto_walk_dir = DIR_NORTH
			elif tdx > 0:
				_auto_walk_dir = DIR_EAST
			elif tdx < 0:
				_auto_walk_dir = DIR_WEST
		return
	var wp: Vector2i = _nav_path[0]
	var dx := wp.x - p.x
	var dy := wp.y - p.y
	if dx == 0 and dy == 0:
		_nav_path.pop_front()
		if _nav_path.is_empty():
			_auto_walk_dir = -1
			return
		wp = _nav_path[0]
		dx = wp.x - p.x
		dy = wp.y - p.y
	# 走一步：优先保证不撞墙的方向
	var prefer: Array[int] = []
	if absi(dx) >= absi(dy):
		if dx > 0:
			prefer.append(DIR_EAST)
		elif dx < 0:
			prefer.append(DIR_WEST)
		if dy > 0:
			prefer.append(DIR_SOUTH)
		elif dy < 0:
			prefer.append(DIR_NORTH)
	else:
		if dy > 0:
			prefer.append(DIR_SOUTH)
		elif dy < 0:
			prefer.append(DIR_NORTH)
		if dx > 0:
			prefer.append(DIR_EAST)
		elif dx < 0:
			prefer.append(DIR_WEST)
	# 附加垂直/备用方向，避免贴墙卡住
	for d in [DIR_EAST, DIR_WEST, DIR_SOUTH, DIR_NORTH]:
		if not prefer.has(d):
			prefer.append(d)
	for d in prefer:
		if _can_step(p, d):
			_auto_walk_dir = d
			return
	_auto_walk_dir = -1


func _can_step(p: Vector2i, d: int) -> bool:
	var delta := Vector2i.ZERO
	match d:
		DIR_WEST:
			delta = Vector2i(-2, 0)
		DIR_EAST:
			delta = Vector2i(2, 0)
		DIR_NORTH:
			delta = Vector2i(0, -1)
		DIR_SOUTH:
			delta = Vector2i(0, 1)
	var np := Vector2i(p.x + delta.x, p.y + delta.y)
	if _near_scene_door(np):
		return false
	return not _is_obstacle(np.x, np.y)


## 把事件对象加入导航目标：优先 touch 触发（门），其次 search/其它
func _load_scene_graph() -> void:
	var path := "res://data/scene_graph.json"
	if not FileAccess.file_exists(path):
		return
	var f := FileAccess.open(path, FileAccess.READ)
	if f == null:
		return
	var parsed = JSON.parse_string(f.get_as_text())
	if parsed is Dictionary:
		for k in parsed.keys():
			var arr: Array = []
			for v in parsed[k]:
				arr.append(int(v))
			_scene_graph[int(k)] = arr
	if _scene_graph.size() > 0:
		_log_auto("SCENE_GRAPH loaded %d scenes" % _scene_graph.size())


const AUTO_VISITED_PATH := "user://auto_visited.json"


func _script_has_ending(entry: int) -> bool:
	var seen := {}
	var work: Array[int] = [entry]
	while not work.is_empty() and seen.size() < 400:
		var e: int = work.pop_back()
		if e <= 0 or e >= sss.scripts.size() or seen.has(e):
			continue
		seen[e] = true
		var q: PackedInt32Array = sss.script_entry(e)
		var code := int(q[0])
		if code == 0x0096 or code == 0x00A0:
			return true
		if code == 0x0000:
			continue
		work.append(e + 1)
		if code in [0x0002, 0x0003, 0x0004, 0x0006, 0x000A, 0x0016, 0x001A,
				0x0064, 0x0066, 0x0067, 0x0068, 0x0069, 0x006A, 0x006B, 0x0078,
				0x008A, 0x0091, 0x009C, 0x009E, 0x00A2]:
			for t in [int(q[1]), int(q[2]), int(q[3])]:
				if t > 0 and t < sss.scripts.size():
					work.append(t)
	return false


func _auto_maybe_trigger_ending() -> void:
	if _auto_ending_fired or not _auto_mode:
		return
	for id in range(evt_start + 1, evt_end + 1):
		var o: Array = sss.event(id)
		var trig := int(o[PalData.EO_TRIGGER_SCRIPT])
		if trig != 0 and _script_has_ending(trig):
			_auto_ending_fired = true
			_log_auto("AUTO_ENDING_TRIGGER scene=%d event=%d script=%d" % [PALState.scene, id, trig])
			_start_script(trig, id)
			return


func _load_auto_visited() -> void:
	if not _auto_mode:
		return
	if not FileAccess.file_exists(AUTO_VISITED_PATH):
		return
	var f := FileAccess.open(AUTO_VISITED_PATH, FileAccess.READ)
	if f == null:
		return
	var arr = JSON.parse_string(f.get_as_text())
	if arr is Array:
		for v in arr:
			_auto_visited_scenes[int(v)] = true
		_log_auto("AUTO_VISITED loaded %d scenes" % _auto_visited_scenes.size())


func _save_auto_visited() -> void:
	if not _auto_mode:
		return
	var f := FileAccess.open(AUTO_VISITED_PATH, FileAccess.WRITE)
	if f == null:
		return
	var keys: Array = _auto_visited_scenes.keys()
	keys.sort()
	f.store_string(JSON.stringify(keys))
	f.close()


## BFS：从 from 到最近的未访问场景，返回 [目标场景, 第一跳]（不可达返回空）
func _nearest_unvisited_scene(from_scene: int) -> Array:
	if _scene_graph.is_empty():
		return []
	var prev := {}
	var q: Array[int] = [from_scene]
	var seen := {from_scene: true}
	while not q.is_empty():
		var cur: int = q.pop_front()
		if cur != from_scene and not _auto_visited_scenes.has(cur):
			# 回溯第一跳
			var node := cur
			while int(prev.get(node, from_scene)) != from_scene and prev.has(node):
				node = int(prev[node])
			return [cur, node]
		for t in _scene_graph.get(cur, []):
			var nt := int(t)
			if seen.has(nt):
				continue
			seen[nt] = true
			prev[nt] = cur
			q.append(nt)
	return []


## 扫描某脚本入口可达的 0x0059 目标场景（近似解释器：线性 + 跳转操作码）
func _script_scene_targets(entry: int) -> Array:
	var out: Array = []
	var seen := {}
	var work: Array[int] = [entry]
	while not work.is_empty() and seen.size() < 400:
		var e: int = work.pop_back()
		if e <= 0 or e >= sss.scripts.size() or seen.has(e):
			continue
		seen[e] = true
		var q: PackedInt32Array = sss.script_entry(e)
		var code := int(q[0])
		if code == 0x0059 and int(q[1]) > 0 and int(q[1]) != PALState.scene:
			out.append(int(q[1]))
		if code == 0x0000:
			continue
		work.append(e + 1)
		if code in [0x0002, 0x0003, 0x0004, 0x0006, 0x000A, 0x0016, 0x001A,
				0x0064, 0x0066, 0x0067, 0x0068, 0x0069, 0x006A, 0x006B, 0x0078,
				0x008A, 0x0091, 0x009C, 0x009E, 0x00A2]:
			for t in [int(q[1]), int(q[2]), int(q[3])]:
				if t > 0 and t < sss.scripts.size():
					work.append(t)
	return out


## 找当前场景的“换场景门”（触发脚本前 16 条含 0x0059 目标场景 != 当前场景）
func _find_scene_door() -> Dictionary:
	var best := {}
	var best_d := 1 << 30
	var p := abs_party()
	var path := _nearest_unvisited_scene(PALState.scene) if _auto_mode else []
	var want_scene: int = int(path[0]) if path.size() >= 1 else 0
	var want_first: int = int(path[1]) if path.size() >= 2 else 0
	for id in range(evt_start + 1, evt_end + 1):
		var o: Array = sss.event(id)
		if int(o[PalData.EO_STATE]) <= 0:
			continue
		var trig := int(o[PalData.EO_TRIGGER_SCRIPT])
		if trig == 0:
			continue
		var targets := _script_scene_targets(trig)
		if targets.is_empty():
			continue
		var target_scene := int(targets[0])
		# 优先“朝最近未访问场景的第一跳”的事件；已访问场景的门在 auto 下跳过
		var score := 1000000
		if _auto_mode and want_first != 0:
			if targets.has(want_first):
				score = 0
			elif want_scene != 0 and targets.has(want_scene):
				score = 10
			elif _auto_visited_scenes.has(target_scene):
				continue
			else:
				score = 1000
		var pos := Vector2i(int(o[PalData.EO_X]), int(o[PalData.EO_Y]))
		var d: int = score + absi(pos.x - p.x) + absi(pos.y - p.y) * 2
		if d < best_d:
			best_d = d
			best = {"id": id, "trigger": trig, "pos": pos, "scene": target_scene}
	return best


## F8 / auto 卡死兜底：把队伍放到门边并直接触发门脚本（0x0046 + 0x0059）
func _force_door_trigger() -> void:
	# 自动模式：直接按场景图 BFS 切到最近未访问场景；分量耗尽则全局跳到任意未访问场景
	if _auto_mode:
		var auto_path := _nearest_unvisited_scene(PALState.scene)
		if auto_path.size() >= 2:
			var next_scene := int(auto_path[1])
			_log_auto("F8: scene-graph -> scene %d (goal %d)" % [next_scene, int(auto_path[0])])
			_auto_visited_scenes[next_scene] = true
			call_deferred("load_scene", next_scene, false)
			return
		for cand in range(1, 295):
			if not _auto_visited_scenes.has(cand):
				_log_auto("F8: fallback unvisited scene %d" % cand)
				_auto_visited_scenes[cand] = true
				call_deferred("load_scene", cand, false)
				return
		_log_auto("F8: 所有场景已访问")
		return
	var door := _find_scene_door()
	if door.is_empty():
		var path := _nearest_unvisited_scene(PALState.scene)
		if _auto_mode and path.size() >= 2:
			_log_auto("F8: 无门事件 -> 直接载入场景 %d" % int(path[1]))
			_auto_visited_scenes[int(path[1])] = true
			call_deferred("load_scene", int(path[1]), false)
			return
		_log_auto("F8: 当前场景没有换场景门")
		return
	var pos: Vector2i = door["pos"]
	PALState.viewport = pos - PARTY_OFFSET
	_clamp_viewport()
	for i in range(PALState.party.size()):
		PALState.party[i]["x"] = PARTY_OFFSET.x
		PALState.party[i]["y"] = PARTY_OFFSET.y
		PALState.trail[i] = {"x": pos.x, "y": pos.y, "dir": PALState.party_dir}
	_log_auto("F8: door event=%d -> scene %d" % [door["id"], door["scene"]])
	_auto_used[door["id"]] = true
	_auto_target_id = int(door["id"])
	_start_script(int(door["trigger"]), int(door["id"]))
	_redraw = true


## 收集当前场景“换场景门”的位置（mode>=4 且触发脚本含 0x0059 目标 != 当前场景）。
## 返回门集合是否变化（round75/P0：事件 state 由脚本改变后据此让出口区域缓存失效）。
func _refresh_scene_doors() -> bool:
	var old_ids: Array = []
	for d in _scene_door_positions:
		old_ids.append(int(d["id"]))
	_scene_door_positions = []
	var did_build := false
	if sss != null:
		did_build = true
		for id in range(evt_start + 1, evt_end + 1):
			var o: Array = sss.event(id)
			if int(o[PalData.EO_STATE]) <= 0:
				continue
			if int(o[PalData.EO_TRIGGER_MODE]) < 4:
				continue
			var trig := int(o[PalData.EO_TRIGGER_SCRIPT])
			if trig == 0:
				continue
			var is_door := false
			for k in range(trig, mini(trig + 16, sss.scripts.size())):
				var q: PackedInt32Array = sss.script_entry(k)
				if int(q[0]) == 0x0059 and int(q[1]) > 0 and int(q[1]) != PALState.scene:
					is_door = true
					break
				if int(q[0]) == 0x0000:
					break
			if is_door:
				_scene_door_positions.append({
					"id": id,
					"pos": Vector2i(int(o[PalData.EO_X]), int(o[PalData.EO_Y])),
				})
	if not did_build:
		return false
	var new_ids: Array = []
	for d in _scene_door_positions:
		new_ids.append(int(d["id"]))
	return new_ids != old_ids


## pos 是否落在某扇换场景门的触发区内（排除当前目标门）
func _near_scene_door(pos: Vector2i) -> bool:
	if _auto_ignore_doors > 0:
		return false
	for d in _scene_door_positions:
		if int(d["id"]) == _auto_target_id:
			continue
		var dp: Vector2i = d["pos"]
		if absi(pos.x - dp.x) + absi(pos.y - dp.y) * 2 < 56:
			return true
	return false


## 当前区域出口组的目标坐标列表。
func _exit_area_targets() -> Array:
	var sc := int(PALState.scene)
	var groups: Dictionary = SCENE_EXIT_GROUPS.get(sc, {})
	var g := _active_exit_group()
	if groups.is_empty() or g == "":
		return []
	var out: Array = []
	for t in groups.get(g, []):
		out.append(Vector2i(int(t.x), int(t.y)))
	return out


## 出口区域判定日志：--debug-hud（白盒定位）或 --auto 时打印。
## 出口区域判定：换场景门的触碰半径内若确实没有可行走格（门在地图可行走区之外，
## 或被门口的 NPC 碰撞体堵死），取"离门最近的可行走格"作为区域触发点。
## 这是区域触发，不放宽事件自带的触碰半径（round5 楼梯放宽导致振荡已回退）。
func _log_exit_area(line: String) -> void:
	if _auto_mode or "--debug-hud" in OS.get_cmdline_args():
		print("[exitarea] ", line)


func _refresh_exit_area() -> void:
	_exit_area_scene = int(PALState.scene)
	_exit_area_group = _active_exit_group()
	_exit_area_cell = Vector2i(-1, -1)
	_exit_area_door_id = 0
	_exit_area_trigger = 0
	_exit_area_door_pos = Vector2i(-1, -1)
	if sss == null:
		return
	# round13：二楼回廊段不做"店门区域触发"（否则会把出口格算在远处/误导）
	if int(PALState.scene) == 4 and not _hall_level:
		return
	# round16/A7 → round75/task-13/F143：街道出口（去村道）在 A6 起点(phase0)与完成后(phase2)都要生效；
	# 仅 phase1（报信后回客栈阶段）不结算，避免把玩家往村道引。
	if int(PALState.scene) == 5 and int(_a6_real_phase()) == 1:
		return
	var targets := _exit_area_targets()
	if targets.is_empty():
		return
	# 只处理"换场景门"（店门等）；楼梯/普通出口不走区域触发
	var door := {}
	for d in _scene_door_positions:
		var dp: Vector2i = d["pos"]
		for t in targets:
			if absi(dp.x - t.x) + absi(dp.y - t.y) * 2 < 8:
				door = d
				break
		if not door.is_empty():
			break
	if door.is_empty():
		return
	var o: Array = sss.event(int(door["id"]))
	var mode := int(o[PalData.EO_TRIGGER_MODE])
	if mode < 4 or int(o[PalData.EO_TRIGGER_SCRIPT]) == 0:
		return
	var touch_r: int = (mode - 4) * 32 + 16
	var door_pos: Vector2i = door["pos"]
	var start := abs_party()
	_exit_area_from = start   # round13：记录计算起点，队伍走远后由 _update_route_hint 触发重算
	var avoids: Array = SCENE_DOOR_AVOID.get(int(PALState.scene), [])
	var dirs := [Vector2i(16, 0), Vector2i(-16, 0), Vector2i(0, 8), Vector2i(0, -8)]
	var prev := {start: start}
	var queue: Array = [start]
	var head := 0
	var best := start
	var best_d := absi(start.x - door_pos.x) + absi(start.y - door_pos.y) * 2
	var in_radius := best_d < touch_r
	while head < queue.size() and head < 20000 and not in_radius:
		var p: Vector2i = queue[head]
		head += 1
		var d0: int = absi(p.x - door_pos.x) + absi(p.y - door_pos.y) * 2
		if d0 < best_d:
			best_d = d0
			best = p
		if d0 < touch_r:
			in_radius = true
			break
		for dir in dirs:
			var n: Vector2i = p + dir
			if prev.has(n) or _is_obstacle(n.x, n.y):
				continue
			var bad := false
			for a in avoids:
				if absi(n.x - int(a.x)) + absi(n.y - int(a.y)) * 2 < 48:
					bad = true
					break
			if bad:
				continue
			prev[n] = p
			queue.append(n)
	if in_radius:
		# round17：即使原触碰半径可达，也把"离门最近的可行走格"算出来并落地：
		# 黄框/足迹画在这个可走格上，配合大半径「按空格前往村道」提示；
		# 原触碰门仍保留为自动通道（走到半径内自动触发）。
		var chosen_r := best
		var best_open_r := -1
		for c in prev.keys():
			var cvec: Vector2i = c
			var cd: int = absi(cvec.x - door_pos.x) + absi(cvec.y - door_pos.y) * 2
			# round75/task-14 F145-A：黄框/面包屑落点必须"走完即可自动触发"——
			# 限制在触碰半径内（此前允许 best_d+32，可能落在半径外，黑盒出现"按黄点走到头不触发、SPACE 无效"）。
			if cd >= touch_r:
				continue
			if cd > best_d + 32:
				continue
			var open_n := 0
			for dd in [Vector2i(16, 0), Vector2i(-16, 0), Vector2i(0, 8), Vector2i(0, -8)]:
				if not _is_obstacle(cvec.x + dd.x, cvec.y + dd.y):
					open_n += 1
			if open_n > best_open_r:
				best_open_r = open_n
				chosen_r = cvec
		if SCENE_EXIT_STAND.has(int(PALState.scene)):
			var stand: Vector2i = SCENE_EXIT_STAND[int(PALState.scene)]
			if prev.has(stand):
				chosen_r = stand
		_exit_area_cell = chosen_r
		_exit_area_door_id = int(door["id"])
		_exit_area_trigger = int(o[PalData.EO_TRIGGER_SCRIPT])
		_exit_area_door_pos = door_pos
		_log_exit_area("EXIT_AREA scene=%d group=%s door=%d radius-reachable cell=%s metric=%d touch_r=%d chosen_metric=%d (marker+SPACE)" % [
			PALState.scene, _exit_area_group, _exit_area_door_id, str(chosen_r), best_d, touch_r,
			absi(chosen_r.x - door_pos.x) + absi(chosen_r.y - door_pos.y) * 2])
		return
	# round10：在"离门最近可达格 ±2 步"内挑一个更靠里的可行走格，
	# 让黄框画在地面可站的位置（而不是贴在黑边/墙边）。
	var chosen := best
	var best_open := -1
	for c in prev.keys():
		var cvec: Vector2i = c
		var cd: int = absi(cvec.x - door_pos.x) + absi(cvec.y - door_pos.y) * 2
		if cd >= touch_r:
			continue
		if cd > best_d + 32:
			continue
		var open_n := 0
		for dd in [Vector2i(16, 0), Vector2i(-16, 0), Vector2i(0, 8), Vector2i(0, -8)]:
			if not _is_obstacle(cvec.x + dd.x, cvec.y + dd.y):
				open_n += 1
		if open_n > best_open:
			best_open = open_n
			chosen = cvec
	if SCENE_EXIT_STAND.has(int(PALState.scene)):
		var stand2: Vector2i = SCENE_EXIT_STAND[int(PALState.scene)]
		if prev.has(stand2):
			chosen = stand2
	_exit_area_cell = chosen
	_exit_area_door_id = int(door["id"])
	_exit_area_trigger = int(o[PalData.EO_TRIGGER_SCRIPT])
	_exit_area_door_pos = door_pos
	_log_exit_area("EXIT_AREA scene=%d group=%s door=%d cell=%s metric=%d touch_r=%d chosen_metric=%d" % [
		PALState.scene, _exit_area_group, _exit_area_door_id, str(chosen), best_d, touch_r,
		absi(chosen.x - door_pos.x) + absi(chosen.y - door_pos.y) * 2])


## round10：店门交互判定 —— 走到店门/出口区域附近（半径 EXIT_DOOR_INTERACT_R）即提示
## 「按空格出门」，按 SPACE / 按住 DOWN 触发门脚本（不再依赖"踩到某一格"）。
## round16/A7：同样用于街道→村道出口（场景5，门在可行走区外）与码头→上船（场景6）。
## round74/A62：仙灵岛出口改回原版事件触碰语义（mode>=4 事件由 _check_touch_triggers 自动触发），
## 这里不再为岛内做特殊扫描/最近可行走格/DOWN 提示（删掉 round73 的过渡实现）。
func _scan_exit_door() -> void:
	_exit_door_near = false
	if _arrival_blocked():
		return
	var sc := int(PALState.scene)
	if _exit_area_used or _exit_area_trigger == 0 or _exit_area_door_pos.x < 0:
		return
	if sc == 4:
		if not _hall_level:
			return
	elif sc == 5:
		if int(_a6_real_phase()) == 1:
			return
	elif sc != 6:
		return
	var p := abs_party()
	var ref := _exit_area_cell if _exit_area_cell.x >= 0 else _exit_area_door_pos
	if absi(p.x - ref.x) + absi(p.y - ref.y) * 2 < EXIT_DOOR_INTERACT_R:
		_exit_door_near = true
		_show_exit_door_hint()


func _show_exit_door_hint() -> void:
	if _hint_panel == null or _hint_label == null:
		return
	var sc := int(PALState.scene)
	var t := "按空格出店门 → 余杭镇街道"
	if sc == 5:
		t = "按空格前往村道（码头）→ 仙灵岛"
	elif sc == 6:
		t = "按空格上船 → 仙灵岛"
	elif sc == 4 and int(PALState.vars.get("a11_stage", 0)) >= 1:
		# round24：第 2 章回客栈后，不再提示"出店门去仙灵岛"，改提示第2章剧情
		if int(PALState.vars.get("a12_stage", 0)) >= 1:
			t = "第 2 章：回房间查看麻布袋（之后前往苏州城）"
		else:
			t = "第 2 章：按空格与李大娘说话"
	# round72/F101：A4 未完成时，店门交互圈内统一提示"先对话再出门"（覆盖其它文案）
	if _a4_door_gate_active():
		t = "先按空格与醉道士对话（讨酒）→ 对话后按住 DOWN 出门"
	if _hint_panel.visible and _hint_label.text == t:
		_hint_timer = maxf(_hint_timer, 1.5)   # 在范围内保持提示
		return
	# 覆盖场景提示条：交互提示优先（round10）
	_hint_label.text = t
	_hint_panel.visible = true
	_hint_timer = 2.5


## round19：强制收尾当前对白/脚本（ESC 用），把操作权交还并允许打开菜单。
func _force_end_script() -> void:
	_walk_blocked_scene = -9999
	_dialog_tail = false
	if vm != null and vm.is_active():
		if vm.has_method("force_finish"):
			vm.force_finish()
		else:
			vm.ended = true
	if _dialog_box != null:
		if _dialog_box.has_method("close"):
			_dialog_box.close()
		elif _dialog_box.has_method("end_dialog"):
			_dialog_box.end_dialog()
	if _dialog_panel != null:
		_dialog_panel.visible = false
	player_busy = false
	_wait_release = true
	_search_lock = SEARCH_LOCK_FRAMES
	_redraw = true


## round72/F101（用户批准方案A）：A4 醉道士对话未完成前，**整个店门交互圈**内不得出门。
## 修复前守卫只看 _interact_id（只在醉道士 R200 圈内有值），而店门交互圈 R200 圆心不同，
## 从北侧上缘 (1024,1560) 可在圈内但醉道士圈外，按住 DOWN 即可绕过 A4 直接出门。
func _a4_door_gate_active() -> bool:
	return int(PALState.scene) == 4 and _hall_level \
		and not bool(PALState.vars.get("a4_drunk_talk_done", false))


## 统一出门入口：SPACE 交互 / 范围内按住 DOWN
func _trigger_exit_door(reason: String) -> void:
	if _exit_area_used or _exit_area_trigger == 0:
		return
	_exit_area_used = true
	_exit_door_near = false
	if _hint_panel != null:
		_hint_panel.visible = false
	_log_exit_area("EXIT_DOOR trigger(%s) scene=%d door=%d script=%d pos=%s" % [
		reason, PALState.scene, _exit_area_door_id, _exit_area_trigger, str(abs_party())])
	_start_script(_exit_area_trigger, _exit_area_door_id)


## 兼容触发：范围内按住 DOWN 也出门（供习惯"按住向下走"的玩家/黑盒）
## round13：A4 讨酒对白还没看时，在醉道士交互圈内按住 DOWN 不直接出门（先对话再出门）
## round16/A7：场景6 码头按住 DOWN = 上船（走 A7 队列：张四对话 → 3509）
## round74/A62：仙灵岛不再用 DOWN 提示触发（原版 mode>=4 事件走近即自动触发，见 _check_touch_triggers）
func _check_exit_area_trigger() -> void:
	# R77-EXIT-5：出口区域不再用“按住方向”触发（方向走过绝不切）；出口只保留 SPACE。
	return
	if _arrival_blocked():
		return
	if _exit_area_used or _exit_area_trigger == 0:
		return
	if player_busy or (vm != null and vm.is_active()):
		return
	var sc := int(PALState.scene)
	if sc == 4 and not _hall_level:
		return
	if sc == 5 and int(_a6_real_phase()) == 1:
		return
	if sc != 4 and sc != 5 and sc != 6:
		return
	if _exit_door_near and _held_dir(false):
		var a4_done := bool(PALState.vars.get("a4_drunk_talk_done", false))
		if _a4_door_gate_active():
			return   # round72/F101：店门交互圈内（任意方位）必须先按 SPACE 与醉道士对话
		if _interact_id != 0 and not a4_done:
			return   # 在醉道士交互圈内：先按 SPACE 对话
		_trigger_exit_door("DOWN-hold")


## round11/A4：站近可交互点按 SPACE（与店门/回客房门同一套交互）
##  * 场景4：门口躺着的醉道士（spr56 事件，默认脚本 601 只有"观察"文本；
##            原版由李大娘对话脚本(355) 用 0x0025 动态把 604 挂到该事件。
##            这里直接接通常驻对话分支 604，保证 A4 一定能对到话）
##  * 场景5：街道侧客栈门（触发脚本 0x0059 → 场景4）→ 按空格进入客栈
func _scan_extra_interact() -> void:
	_restore_real_door_events()
	_interact_id = 0
	_interact_trig = 0
	_interact_prompt = ""
	_interact_kind = ""
	if sss == null:
		return
	var sc := int(PALState.scene)
	var p := abs_party()
	# R104-A24FIX-1：scene50 白河村「打听韩医仙线索」= 走近 evt835 后按空格交互（真实脚本 9922）。
	# 旧实现 A24 系统被 a23_stage 门槛卡死且 scene50 没有 SPACE 扫描分支 → 玩家看到 HUD 但无交互。
	if sc == 50 and int(PALState.vars.get("a24_stage", 0)) < 1 and sss != null and sss.events.size() > A24_CLUE_EVT:
		var o24: Array = sss.event(A24_CLUE_EVT)
		if int(o24[PalData.EO_STATE]) > 0:
			var p24 := Vector2i(int(o24[PalData.EO_X]), int(o24[PalData.EO_Y]))
			if absi(p.x - p24.x) + absi(p.y - p24.y) * 2 < 112:
				_interact_id = A24_CLUE_EVT
				_interact_trig = A24_CLUE_SCRIPT
				_interact_prompt = "按空格打听韩医仙线索（第 3 章）"
				_interact_kind = "a24clue"
				_show_interact_hint()
				return
	# R104-A24FIX-1：A25 求医后回白河村找糯米 = 走近 evt833 按空格（真实脚本 9909）。
	if sc == 50 and int(PALState.vars.get("a25_stage", 0)) >= 1 \
			and int(PALState.vars.get("a26_clue", 0)) < 1 and sss != null and sss.events.size() > A26_CLUE_EVT:
		var o26: Array = sss.event(A26_CLUE_EVT)
		if int(o26[PalData.EO_STATE]) > 0:
			var p26 := Vector2i(int(o26[PalData.EO_X]), int(o26[PalData.EO_Y]))
			if absi(p.x - p26.x) + absi(p.y - p26.y) * 2 < 112:
				_interact_id = A26_CLUE_EVT
				_interact_trig = A26_CLUE_SCRIPT
				_interact_prompt = "按空格打听糯米线索（第 3 章）"
				_interact_kind = "a26clue"
				_show_interact_hint()
				return
	# R118-A28RETRY-1：scene59「查看将军墓」= evt959(mode2) 走近按空格触发真实脚本11399（含真实战斗）。
	# 不再用运行期 _a28_talk_started 作为门禁：战败读档后它可能残留 true → 提示消失/SPACE 无效（P1 软锁）。
	# 是否已推进只看真实存档变量 a28_stage；运行期标志在 load_scene/read_game 时复位。
	if sc == 59 and int(PALState.vars.get("a28_stage", 0)) < 1 \
			and sss != null and sss.events.size() > A28_TALK_EVT:
		var o28b: Array = sss.event(A28_TALK_EVT)
		if int(o28b[PalData.EO_STATE]) > 0:
			var p28b := Vector2i(int(o28b[PalData.EO_X]), int(o28b[PalData.EO_Y]))
			if absi(p.x - p28b.x) + absi(p.y - p28b.y) * 2 < 120:
				_interact_id = A28_TALK_EVT
				_interact_trig = A28_TALK_SCRIPT
				_interact_prompt = "按空格查看将军墓（第 3 章）"
				_interact_kind = "a28talk"
				_show_interact_hint()
				return
	# R141-A32TALK-1：A32 扬州打探线索的 mode2 路人（evt1505/evt1557）必须走近按 SPACE 触发真实脚本；
	# 旧逻辑只靠引导文案“已到触发点”，没有 NPC 交互入口 → SPACE/ENTER 全无反应。
	if sc == 80 and int(PALState.vars.get("a31_stage", 0)) >= 1 \
			and int(PALState.vars.get("a32_clue2", 0)) < 1 and sss != null and sss.events.size() > 1505:
		var o1505: Array = sss.event(1505)
		if int(o1505[PalData.EO_STATE]) > 0:
			var p1505 := Vector2i(int(o1505[PalData.EO_X]), int(o1505[PalData.EO_Y]))
			if absi(p.x - p1505.x) + absi(p.y - p1505.y) * 2 < 120 and int(_a14g_left) == 0:
				_interact_id = 1505
				_interact_trig = 15109
				_interact_prompt = "按空格打听偷盗案线索（第 4 章）"
				_interact_kind = "a32clue2"
