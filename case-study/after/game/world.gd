				_s4g_avoid_events[_aid2] = _a19_evt_ring(sss.event(_aid2))
	var mode_g := int(o[PalData.EO_TRIGGER_MODE])
	var rings_g: Array = [_a19_evt_ring(o)]
	if mode_g < 4:
		rings_g = [_a19_evt_ring(o), 96, 160, 240]
	# 1) 主目标：目标环 →（仅非门目标）迷宫兜底大环
	for rr in rings_g:
		_s4g_build(p, [_a19g_t], rr)
		if int(_s4g_dist.get(p, -1)) >= 0:
			_a19g_dist = _s4g_dist
			return
	# R120-WATER-1b：玩家停在开放水域（旧档/旧路线残留）且不在目标场可达集合里 →
	# 救到“目标连通分量”最近的岸格后重建，避免 HUD 无方向/把 N 指到别的门。
	if current_map != null and current_map.is_open_water_at(p.x, p.y) and not _s4g_dist.is_empty():
		var best_w := Vector2i(-1, -1)
		var best_wd := 1 << 30
		for qk in _s4g_dist.keys():
			var q: Vector2i = qk
			var wd := absi(q.x - p.x) + absi(q.y - p.y) * 2
			if wd < best_wd:
				best_wd = wd
				best_w = q
		if best_w.x >= 0:
			PALState.viewport = best_w - PARTY_OFFSET
			_clamp_viewport()
			print("[water] R120-WATER-1b rescue %s -> %s scene=%d" % [str(p), str(best_w), int(PALState.scene)])
			_a19_guide_rebuild(evt_id)
			return
	# R146-INN94-1：客栈 scene94 上下层由脚本 0x006E 滚动定位，端口按队伍坐标换算后
	# evt1728 目标层与当前层在“事件阻挡”下不连通。夜间已开启且已下楼时，把队伍落到
	# 目标门环内最近可走格（等价于原版滚屏后的楼梯落点），再按正常 HUD 走到 evt1728。
	if int(PALState.scene) == 94 and int(PALState.vars.get("a33_down", 0)) >= 1 \
			and sss != null and sss.events.size() > 1786 and int(sss.event(1786)[PalData.EO_STATE]) > 0 \
			and (evt_id == 1728 or evt_id == 1729 or evt_id == 1730) and not _s4g_dist.has(p):
		var inn_t: Vector2i = _a19g_t
		var landed := Vector2i(-1, -1)
		for rad in [16, 32, 48, 64]:
			for ox in range(-rad, rad + 1, 16):
				for oy in range(-rad, rad + 1, 8):
					if absi(ox) + absi(oy) * 2 >= rad:
						continue
					var cand := inn_t + Vector2i(ox, oy)
					if _s4g_walk_ok(cand.x, cand.y):
						landed = cand
						break
				if landed.x >= 0: break
			if landed.x >= 0: break
		if landed.x >= 0:
			PALState.viewport = landed - PARTY_OFFSET
			_clamp_viewport()
			print("[inn94] R146-INN94-1 landing %s -> %s scene=%d evt=%d" % [str(p), str(landed), int(PALState.scene), evt_id])
			_a19_guide_rebuild(evt_id)
			return
	# 2) 主目标与玩家所在连通块不通：给“可走到的门”的真实绕行方向（优先同一目标场景）
	var fb := _a19_find_reachable_door(p, next_dest)
	# R134-FBFILTER-1：若主目标不可达，只接受“目的地==目标下一场景”的门作为绕行；
	# 禁止把玩家导向其它场景门（用户 r133：目标 evt802→scene55，却被 evt830→scene51 抢走）。
	if not fb.is_empty() and next_dest > 0:
		var fb_o: Array = sss.event(int(fb["id"]))
		var fb_dests := _script_scene_targets(int(fb_o[PalData.EO_TRIGGER_SCRIPT]))
		if fb_dests.is_empty() or int(fb_dests[0]) != next_dest:
			fb = {}
			_a19g_cd0 = false
	# R171-GUIDESAME-1：fallback 门与主目标同一个 event 时，说明主目标 BFS 第一次构建与场景载入竞争失败；
	# 重试一次主目标；成功直接用主目标（避免 HUD 错误进入“等待/绕行”或用同点假方向）。
	if not fb.is_empty() and int(fb["id"]) == evt_id:
		_s4g_key = ""
		_s4g_build(p, [_a19g_t], _a19_evt_ring(o))
		if _s4g_dist.has(p):
			_a19g_dist = _s4g_dist
			_a19g_fb = false
			return
		_a19g_key = ""
		fb = {}
	if not fb.is_empty():
		_a19g_fb = true
		_a19g_fb_dir = str(fb["dir"])
		_a19g_fb_left = int(fb["left"])
		_a19g_fb_id = int(fb["id"])
		_a19g_dist = {}
		return
	# 3) 连门也走不到：保持“等待/绕行”文案（已缓存，不再每帧重算）
	_a19g_dist = {}


