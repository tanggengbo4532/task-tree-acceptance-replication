## 战斗/菜单等模块用的脚本钩子：同步跑完一段脚本（遇到需要按键/等待则中断）
func run_script_entry(entry: int) -> bool:
	if entry == 0:
		return false
	run_script_entry_sync(entry, 0xFFFF)
	return true


func run_script_entry_sync(entry: int, evt_id: int = 0xFFFF) -> void:
	var tmp := ScriptVM.new()
	tmp.setup(sss, self)
	# round74/场景18（C）：捕获脚本对白（原 sync runner 遇到 waiting_dialog 就停，
	# 对白无处显示——破天锤失败「没有反应」等反馈因此丢失）。
	_sync_dialog_capture = true
	_sync_dialogs = []
	tmp.start(entry, evt_id)
	var guard := 0
	while tmp.is_active() and not tmp.waiting_dialog and guard < 2000:
		tmp.tick()
		guard += 1
	_sync_dialog_capture = false
	if PALState != null:
		PALState.script_last_success = bool(tmp.script_success)
		PALState.script_last_dialogs = _sync_dialogs.duplicate()


