func _a19_pick_story_door(p: Vector2i, sc: int) -> int:
	if sc == 141 and int(PALState.vars.get("a36_stage", 0)) >= 1:
		if int(PALState.vars.get("a37_stage", 0)) < 1:
			return 2373
		if int(PALState.vars.get("a38_stage", 0)) < 1:
			return 2378
	var ids: Array = _a19_story_door_ids(sc)
	if ids.is_empty():
		return 0
	if _a19g_story_scene != sc:
		_a19g_story_scene = sc
		_a19g_story_id = 0
	if int(_a19g_story_id) > 0 and ids.has(int(_a19g_story_id)) and _a19_door_reachable(p, int(_a19g_story_id)):
		return int(_a19g_story_id)
	for v in ids:
		var id := int(v)
		if _a19_door_reachable(p, id):
			_a19g_story_id = id
			return id
	_a19g_story_id = 0
	return 0


## 场景内可作为“出口/交互门”的事件（trigger 脚本含 0x0059）；按场景缓存。
func _a19_alt_doors(sc: int) -> Array:
	if _a19g_alt.has(sc):
		return _a19g_alt[sc]
	var out: Array = []
	if sss == null or current_map == null:
		return out
	var r := scene_event_range(sc)
	for id in range(r[0] + 1, r[1] + 1):
		if id <= 0 or id >= sss.events.size():
			continue
		var o: Array = sss.event(id)
		if int(o[PalData.EO_STATE]) <= 0:
			continue
		if int(o[PalData.EO_TRIGGER_MODE]) < 4:
			continue
		var trig := int(o[PalData.EO_TRIGGER_SCRIPT])
		if trig <= 0:
			continue
		var dests := _script_scene_targets(trig)
		if dests.is_empty():
			continue
		out.append({"id": id, "pos": Vector2i(int(o[PalData.EO_X]), int(o[PalData.EO_Y])),
			"ring": _a19_evt_ring(o), "dest": int(dests[0])})
	_a19g_alt[sc] = out
	return out


## 玩家当前连通块内最近的可用场景门。优先目标场景 == next_dest；找不到再考虑其它门。
## 返回 {id,dir,left}（dir=第一步方向，left=剩余步数）；不可达返回 {}。
func _a19_find_reachable_door(p: Vector2i, next_dest: int, max_visited: int = 6000) -> Dictionary:
	var doors := _a19_alt_doors(int(PALState.scene))
	if doors.is_empty():
		return {}
	for pass_i in range(2):
		var prev := {p: p}
		var q: Array = [p]
		var head := 0
		var hit_p := Vector2i(-1, -1)
		var hit_id := 0
		while head < q.size() and head < max_visited:
			var c: Vector2i = q[head]
			head += 1
			for d0 in doors:
				if pass_i == 0 and int(d0["dest"]) != next_dest:
					continue
				var dp: Vector2i = d0["pos"]
				if absi(c.x - dp.x) + absi(c.y - dp.y) * 2 < int(d0["ring"]):
					hit_p = c
					hit_id = int(d0["id"])
					break
			if hit_p.x >= 0:
				break
			for d in [Vector2i(0, 8), Vector2i(0, -8), Vector2i(-16, 0), Vector2i(16, 0)]:
				var n: Vector2i = c + d
				if prev.has(n):
					continue
				if not _s4g_walk_ok(n.x, n.y):
					continue
				prev[n] = c
				q.append(n)
		if hit_p.x >= 0:
			var left := 0
			var cur := hit_p
			var first := hit_p
			var guard := 0
			while cur != p and guard < 4000:
				guard += 1
				first = cur
				cur = prev[cur]
				left += 1
			var dv := first - p
			var dir := ""
			if dv == Vector2i(0, -8):
				dir = "up"
			elif dv == Vector2i(0, 8):
				dir = "down"
			elif dv == Vector2i(-16, 0):
				dir = "left"
			elif dv == Vector2i(16, 0):
				dir = "right"
			if dir != "":
				return {"id": hit_id, "dir": dir, "left": left}
			if left == 0:
				# 玩家已经在门触发圈内：dir=""/left=0，由上层显示“已到触发点”（不伪造方向）
				return {"id": hit_id, "dir": "", "left": 0}
	return {}


