func _party_all_dead() -> bool:
	for i in range(PALState.max_party_member_index + 1):
		var role := int(PALState.party[i]["role"])
		if int(PALState.roles["hp"][role]) > 0:
			return false
	return true


## 战败：显示提示 → 返回标题画面（PAL98 行为）
func _game_over() -> void:
	if _game_over_shown:
		return
	# R260-GAMEOVER-1：先消费掉 lose 结果，防止 await 期间全灭兜底重复触发。
	_last_battle_result = ""
	_game_over_shown = true
	player_busy = true
	_held_dirs.clear()
	print("[world] GAME_OVER")
	if _dialog_box != null:
		_dialog_box.set_style(3)
		_dialog_box.push_line("胜败乃兵家常事，大侠请重新来过……")
	# 按键继续（最多 8 秒），避免玩家来不及看清
	var waited := 0.0
	while waited < 8.0:
		await get_tree().process_frame
		waited += get_process_delta_time()
		if Input.is_anything_pressed():
			break
	_game_over_shown = false
	# R244-GAMEOVER-LOADSAVE-1：PAL98 战败应回到最近存档，绝不重开新游戏/覆盖存档。
	# 原实现 reload_current_scene() 会重载 main.tscn → 标题/新游戏（tester 实测 scene2 李大娘开场）。
	var slot := _latest_save_slot_for_gameover()
	print("[save] GAMEOVER picked slot=%d current_loaded=%d" % [int(slot), int(PALState.current_save_slot)])
	if slot > 0:
		PALState.current_save_slot = slot
		_log_auto("GAMEOVER -> load save slot=%d" % slot)
		request_load_game()
		return
	# 无任何存档：保留原行为（回标题），不创建/覆盖存档。
	get_tree().reload_current_scene()


## R244-GAMEOVER-LOADSAVE-1：优先回当前读档槽；否则取槽1-5中最新修改时间的存档。
func _latest_save_slot_for_gameover() -> int:
	var cur := int(PALState.current_save_slot)
	if cur > 0 and FileAccess.file_exists(PALState.save_path(cur)):
		return cur
	# R270-SLOTFIX：绝不回退到“最新档/槽1”；只回当前载入槽。没有有效当前槽则走标题/不覆盖。
	_log_auto("GAMEOVER no current save slot=%d -> title (no latest fallback)" % cur)
	return 0


