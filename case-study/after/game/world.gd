		return
	if player_busy and _mode_node != null:
		return
	# R151-A28EXIT-1：将军墓出口 evt945 等 c3 目标门，若“引导已到触发点”但交互扫描尚未布防
	# （读档/到点保护/门口提示被让位等边缘），SPACE 直接按同源目标事件触发，避免“到点无响应”。
