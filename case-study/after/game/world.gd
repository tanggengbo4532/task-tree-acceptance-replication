## R241-S85TILE-1：scene85 蓝笔 tile 位图（2048 字节，64*128*2 slot）。
func _s85_ensure_bits() -> void:
	if _s85_walk_bits.is_empty():
		_s85_walk_bits = Marshalls.base64_to_raw(S85_WALK_BITS_B64)




func _scene_route_ground_cell_ok(sc: int, p: Vector2i) -> bool:
	var bits: PackedByteArray
	if sc == 106:
		if _s106_route_bits.is_empty(): _s106_route_bits = Marshalls.base64_to_raw(S106_WALK_BITS_B64)
		bits = _s106_route_bits
	elif sc == 109:
		if _s109_route_bits.is_empty(): _s109_route_bits = Marshalls.base64_to_raw(S109_WALK_BITS_B64)
		bits = _s109_route_bits
	elif sc == 118:
		if _s118_route_bits.is_empty(): _s118_route_bits = Marshalls.base64_to_raw(S118_WALK_BITS_B64)
		bits = _s118_route_bits
	else:
		return true
	if bits.size() < 2048:
		return false
	var slot := _s85_slot_at_pixel(p.x, p.y)
	if slot < 0:
		return false
	return (bits[slot / 8] & (1 << (slot % 8))) != 0


func _s85_slot_at_pixel(x: int, y: int) -> int:
	var tx: int = x / 32
	var ty: int = y / 16
	var h := 0
	var xr: int = x % 32
	var yr: int = y % 16
	if xr + yr * 2 >= 16:
		if xr + yr * 2 >= 48:
			tx += 1
			ty += 1
		elif 32 - xr + yr * 2 < 16:
			tx += 1
		elif 32 - xr + yr * 2 < 48:
			h = 1
		else:
			ty += 1
	if tx < 0 or tx >= 64 or ty < 0 or ty >= 128:
		return -1
	return (ty * 64 + tx) * 2 + h


func _s85_ground_cell_ok(p: Vector2i) -> bool:
	_s85_ensure_bits()
	var slot := _s85_slot_at_pixel(p.x, p.y)
	if slot < 0 or _s85_walk_bits.size() < 2048:
		return false
	return (_s85_walk_bits[slot / 8] & (1 << (slot % 8))) != 0


func _s85_slot_center(slot: int) -> Vector2i:
	var q := slot / 2
	var tx := q % 64
	var ty := q / 64
	var h := slot % 2
	return Vector2i(tx * 32 + h * 16 + 16, ty * 16 + h * 8 + 8)


func _s85_nearest_walk_pixel(p: Vector2i) -> Vector2i:
	_s85_ensure_bits()
	var best := p
	var bestd := 1 << 30
	for slot in range(16384):
		if (_s85_walk_bits[slot / 8] & (1 << (slot % 8))) == 0:
			continue
		var c := _s85_slot_center(slot)
		var d := absi(c.x - p.x) + absi(c.y - p.y) * 2
		if d < bestd:
			bestd = d
			best = c
	return best


