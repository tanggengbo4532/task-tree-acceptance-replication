## 当前是否按住某方向（事件驱动 + 轮询双通道，合成键与真实键盘都生效）
func _held_dir(up: bool) -> bool:
	if up:
		return _held_dirs.has(KEY_UP) or _held_dirs.has(KEY_W) \
			or Input.is_key_pressed(KEY_UP) or Input.is_key_pressed(KEY_W)
	return _held_dirs.has(KEY_DOWN) or _held_dirs.has(KEY_S) \
		or Input.is_key_pressed(KEY_DOWN) or Input.is_key_pressed(KEY_S)


## round76：方向键 code → DIR_*（输入缓冲用）
func _dir_from_keycode(k: int) -> int:
	match k:
		KEY_LEFT, KEY_A:
			return DIR_WEST
		KEY_RIGHT, KEY_D:
			return DIR_EAST
		KEY_UP, KEY_W:
			return DIR_NORTH
		KEY_DOWN, KEY_S:
			return DIR_SOUTH
	return -1


func _unhandled_input(event: InputEvent) -> void:
	# 方向键用“事件驱动 + 轮询”双通道：真实键盘与 PostMessage 合成键都能工作
	if event is InputEventKey:
		var ev := event as InputEventKey
		if not ev.echo and _DIR_KEYS.has(ev.keycode):
			if ev.pressed:
				_held_dirs[ev.keycode] = true
				# round76：缓冲一个待处理步（60ms 轻按可能在两帧之间按下+松开 → held 查不到；这里保证至少 1 格）
				_pending_move_dir = _dir_from_keycode(ev.keycode)
				_pending_move_frame = Engine.get_process_frames()
			else:
				_held_dirs.erase(ev.keycode)
		if not ev.pressed:
			return
	if not (event is InputEventKey and event.pressed and not event.echo):
		return
	var k: int = (event as InputEventKey).keycode
	# R157-BATTLERESET-1：战斗节点存在时世界层不处理任何按键，避免旧战斗/世界交互双消费（指令阶段重复追加）。
	if _real_battle_active or _mode_node != null:
		return
	# R144-DIALOGKEY-1：对白推进 SPACE/ENTER 都必须有效。把对白优先处理放在所有 SPACE 交互分支之前，
	# 避免夜间剧情（player_busy 可能为 false）时 SPACE 被门口/NPC 分支先吞掉、只有 ENTER 能翻页。
	if (k == KEY_SPACE or k == KEY_ENTER or k == KEY_KP_ENTER) \
			and _dialog_box != null and _dialog_box.has_method("is_active") and _dialog_box.is_active():
		if _dialog_box.has_method("is_typing") and _dialog_box.is_typing():
			_dialog_box.finish_typing()
		elif _dialog_box.advance():
			if vm != null and vm.is_active() and vm.waiting_dialog:
				vm.advance_dialog()
		else:
			if vm != null and vm.is_active() and vm.waiting_dialog:
				vm.advance_dialog()
			elif _dialog_tail:
				_dialog_tail = false
				player_busy = false
