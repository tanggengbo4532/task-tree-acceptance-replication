## 门/出口几何：优先用当前场景已扫描到的换场景门（真实 mode 半径），否则用给定兜底坐标
func _a6_door_geo(evt_id: int, fallback_pos: Vector2i) -> Dictionary:
	var out := {"pos": fallback_pos, "touch_r": 48}
	for d in _scene_door_positions:
		if int(d["id"]) == evt_id:
			out["pos"] = d["pos"]
			var o: Array = sss.event(evt_id) if sss != null else []
			if o.size() > PalData.EO_TRIGGER_MODE:
				var mode := int(o[PalData.EO_TRIGGER_MODE])
				if mode >= 4:
					out["touch_r"] = (mode - 4) * 32 + 16
			break
	return out


