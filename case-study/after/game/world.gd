## 脱困：向最近的“格点”（16/8px 对齐）可走位置吸附（保持 sdlpal 离散位置语义）
func _unstick_if_needed() -> void:
	var p := abs_party()
	if not _is_obstacle(p.x, p.y) and p.x % 16 == 0 and p.y % 8 == 0:
		return
	_snap_to_lattice(p)


func _snap_to_lattice(from_pos: Vector2i) -> void:
	var base := Vector2i(from_pos.x - from_pos.x % 16, from_pos.y - from_pos.y % 8)
	for r in range(0, 13):
		for dyi in range(-r, r + 1):
			for dxi in range(-r, r + 1):
				if absi(dxi) + absi(dyi) > r:
					continue
				var np := Vector2i(base.x + dxi * 16, base.y + dyi * 8)
				if np.x < 0 or np.y < 0 or np.x >= current_map.map_pixel_width() or np.y >= current_map.map_pixel_height():
					continue
				if _is_obstacle(np.x, np.y):
					continue
				PALState.viewport = np - PARTY_OFFSET
				_clamp_viewport()
				_anim_remaining = 0
				_log_auto("SNAP_LATTICE -> %s" % np)
				_redraw = true
				return


## 连续受阻时强制脱困（格点吸附）
func _unstick_force() -> void:
	_snap_to_lattice(abs_party())


func _update_movement() -> void:
	if vm != null and vm.is_active():
		_held_dirs.clear()
		_pending_move_dir = -1   # round76：对白/脚本期间不保留输入缓冲
	# round13：切换场景/楼梯动画结束后，必须等方向键全部松开才恢复移动
	if _wait_release:
		_pending_move_dir = -1   # round76：等松键期间不保留缓冲，避免切换后突然走一格
		var still_held: bool = _held_dirs.has(KEY_LEFT) or _held_dirs.has(KEY_A) \
			or _held_dirs.has(KEY_RIGHT) or _held_dirs.has(KEY_D) \
			or _held_dirs.has(KEY_UP) or _held_dirs.has(KEY_W) \
			or _held_dirs.has(KEY_DOWN) or _held_dirs.has(KEY_S) \
			or Input.is_key_pressed(KEY_LEFT) or Input.is_key_pressed(KEY_RIGHT) \
			or Input.is_key_pressed(KEY_UP) or Input.is_key_pressed(KEY_DOWN)
		if still_held:
			PALState.party[0]["frame"] = _party_idle_frame(int(PALState.party[0]["role"]))
			_redraw = true
			return
		_wait_release = false
	if _move_cooldown > 0:
		_move_cooldown -= 1
		return
	var dir := -1
	var held_left: bool = _held_dirs.has(KEY_LEFT) or _held_dirs.has(KEY_A) or Input.is_key_pressed(KEY_LEFT) or Input.is_key_pressed(KEY_A)
	var held_right: bool = _held_dirs.has(KEY_RIGHT) or _held_dirs.has(KEY_D) or Input.is_key_pressed(KEY_RIGHT) or Input.is_key_pressed(KEY_D)
	var held_up: bool = _held_dirs.has(KEY_UP) or _held_dirs.has(KEY_W) or Input.is_key_pressed(KEY_UP) or Input.is_key_pressed(KEY_W)
	var held_down: bool = _held_dirs.has(KEY_DOWN) or _held_dirs.has(KEY_S) or Input.is_key_pressed(KEY_DOWN) or Input.is_key_pressed(KEY_S)
	if _auto_mode and _auto_walk_dir >= 0:
		dir = _auto_walk_dir
	elif held_left:
		dir = DIR_WEST
	elif held_right:
		dir = DIR_EAST
	elif held_up:
		dir = DIR_NORTH
	elif held_down:
		dir = DIR_SOUTH
	# R77-FIX-1：首次方向输入后解除读档宽限（必须放在 dir 计算之后）
	if dir >= 0:
		_load_wait_move = false
		_load_grace_until = -1
	# round76：held 键已产生移动 → 清掉 pending，避免松键后多走一步（精确走位过冲）
	if dir >= 0:
		_pending_move_dir = -1
	# round76：轻按缓冲——无 held 键时消费一个待处理步（≤15 帧内有效；避免过期误走）
	if dir < 0 and _pending_move_dir >= 0:
		if Engine.get_process_frames() - _pending_move_frame <= 15:
			dir = _pending_move_dir
		_pending_move_dir = -1
	if dir < 0:
		PALState.party[0]["frame"] = _party_idle_frame(int(PALState.party[0]["role"]))
		_redraw = true
		return
	PALState.party_dir = dir
	_s18_last_dir_frame = Engine.get_process_frames()
	var delta := Vector2i.ZERO
	match dir:
		DIR_WEST:
			delta = Vector2i(-16, 0)
		DIR_EAST:
			delta = Vector2i(16, 0)
		DIR_NORTH:
			delta = Vector2i(0, -8)
		DIR_SOUTH:
			delta = Vector2i(0, 8)
	var target := abs_party() + delta
	# R303-STAIRASSIST：scene206/207 石阶/栅栏拐角，玩家若仍按旧方向撞墙，
	# 自动改用HUD当前指向的一步（仅当该格真实可走）；不是传送，不改变N/任务。
	if int(PALState.scene) in [206, 207] and str(_a14g_key) != "" and _is_obstacle(target.x, target.y):
		var hd := -1
		match str(_a14g_key):
			"up": hd = DIR_NORTH
			"down": hd = DIR_SOUTH
			"left": hd = DIR_WEST
			"right": hd = DIR_EAST
		if hd >= 0:
			var hdelta := Vector2i.ZERO
			match hd:
				DIR_WEST: hdelta = Vector2i(-16, 0)
				DIR_EAST: hdelta = Vector2i(16, 0)
				DIR_NORTH: hdelta = Vector2i(0, -8)
				DIR_SOUTH: hdelta = Vector2i(0, 8)
			if hdelta != delta and not _is_obstacle(abs_party().x + hdelta.x, abs_party().y + hdelta.y):
				dir = hd
				delta = hdelta
				target = abs_party() + delta
	var block_x: int = PARTY_OFFSET.x / 32
	var block_y: int = PARTY_OFFSET.y / 16
	var tx: int = target.x / 32
	var ty: int = target.y / 16
	if tx < block_x or tx >= current_map.map_pixel_width() / 32 - block_x - 1 or ty < block_y or ty >= current_map.map_pixel_height() / 16 - block_y - 1:
		_s18_move_log(dir, target, "border")
		_s18_note_step_blocked(target)
		_redraw = true
		return
	# R77-A14-12：scene4 一楼大厅外圈黑区不可进入（仅 movement 限制；A14 中央给任意位置 SPACE 出客栈）
	if int(PALState.scene) == 4 and _hall_level and _stair_anim_kind == "":
		# 仅东南/东侧黑区与南边界（北侧 y<1560 保留为楼梯通道，楼梯触发区可走）
		if target.x < 560 or target.x > 1456 or target.y > 1840:
			_s18_note_step_blocked(target)
			_redraw = true
			return
	if _is_obstacle(target.x, target.y):
		if int(PALState.scene) == 185 and _no_move_frames < 3:
			print("[R293] blocked scene185 from=%s target=%s dir=%d" % [str(abs_party()),str(target),dir])
		if int(PALState.scene) in [206, 207] and _no_move_frames < 3:
			print("[R301] blocked scene=%d from=%s target=%s dir=%d N=%d" % [int(PALState.scene), str(abs_party()), str(target), dir, int(_a14g_left)])
		_s18_move_log(dir, target, "obstacle")
		_s18_note_step_blocked(target)
		_no_move_frames += 1
		if _no_move_frames > 30:
			_no_move_frames = 0
			# R85-DEADLOCK：优先解除读档跳过/安全区，让真实 touch 战斗/事件触发；
			# 只有玩家确实落在障碍/非格点（异常态）时才做格点吸附（避免把正常卡死变成传送）。
			var pp0 := abs_party()
			if _is_obstacle(pp0.x, pp0.y) or pp0.x % 16 != 0 or pp0.y % 8 != 0:
				_unstick_force()
			else:
				_load_skip_events.clear()
				_load_safe_radius = 0
		PALState.party[0]["frame"] = _party_idle_frame(int(PALState.party[0]["role"]))
		_redraw = true
		return
	_no_move_frames = 0
	# 离散一步（碰撞已检查），记录轨迹（每 8px 一段）
	var old_abs := abs_party()
	PALState.viewport += delta
	_clamp_viewport()
	var steps := (absi(delta.x) + absi(delta.y)) / 8
	for k in range(steps):
		var t: Vector2i = old_abs + Vector2i(
			int(delta.x * k / maxi(1, steps)), int(delta.y * k / maxi(1, steps)))
		for j in range(PALState.trail.size() - 1, 0, -1):
			PALState.trail[j] = PALState.trail[j - 1].duplicate()
		PALState.trail[0] = {"x": t.x, "y": t.y, "dir": PALState.party_dir}
	_step_frame = (_step_frame + 1) % WALK_FRAMES
	_update_lead_frame()
	# INPUT-1（全场景统一）：一次轻按最多 1 步——冷却 12 帧（≈200ms）覆盖正常短按时长，
	# 避免按住/短按跨 cooldown 造成横向 32 / 纵向 16 两格；长按仍按冷却周期连续走。
	_move_cooldown = 12
	_redraw = true


func _update_lead_frame() -> void:
	var role := int(PALState.party[0]["role"])
	var lead_frame: int = PALState.party_dir * 3
	if int(PALState.roles["walk_frames"][role]) == 4:
		lead_frame = PALState.party_dir * 4 + _step_frame
	elif (_step_frame & 1) != 0:
		lead_frame = PALState.party_dir * 3 + (_step_frame + 1) / 2
	PALState.party[0]["frame"] = lead_frame
	# 跟随者朝向/帧跟随领队
	for i in range(1, PALState.party.size()):
		PALState.party[i]["frame"] = lead_frame


var _s185_user_walk: Dictionary = {}

func _s185_user_route_ok(p: Vector2i) -> bool:
	if _s185_user_walk.is_empty():
