func _do_search() -> void:
	# round19：搜索锁（脚本/对白刚结束 / 刚上船时，ENTER 不做事件搜索，避免闲聊循环重触发）
	if _search_lock > 0:
		return
	# 移植 play.c: PAL_GetSearchTriggerRange + PAL_Search（13 检查点 × 场景事件对象）
	var p := abs_party()
	var x := p.x
	var y := p.y
	var x_offset := 16 if (PALState.party_dir == DIR_NORTH or PALState.party_dir == DIR_EAST) else -16
	var y_offset := 8 if (PALState.party_dir == DIR_EAST or PALState.party_dir == DIR_SOUTH) else -8
	var pos: Array = [Vector2i(x, y)]
	for i in range(4):
		pos.append(Vector2i(x + x_offset, y + y_offset))
		pos.append(Vector2i(x, y + y_offset * 2))
		pos.append(Vector2i(x + x_offset, y))   # round74/S1b：对齐 sdlpal ref PAL_Search rgPos[i*3+3]=(x+xOffset,y)
		x += x_offset
		y += y_offset
	for i in range(13):
		var dh := 1 if posmod(pos[i].x, 32) != 0 else 0
		var dx: int = pos[i].x / 32
		var dy: int = pos[i].y / 16
		for id in range(evt_start + 1, evt_end + 1):
			var o: Array = sss.event(id)
			var mode := int(o[PalData.EO_TRIGGER_MODE])
			# round74/task-2 S1：恢复 sdlpal 2.0.x 经典搜索语义 `<`（旧版 ref/play_2.0.2017.1114.c:445 /
			# 2.0.2021.0214.c:445 均为 wTriggerMode * 6 - 4 < i；master 才有 <=）。禁止任何宽区域/跳过。
			if int(o[PalData.EO_STATE]) <= 0 or mode >= 4 or mode * 6 - 4 < i:
				continue
			var ex: int = int(o[PalData.EO_X]) / 32
			var ey: int = int(o[PalData.EO_Y]) / 16
			var eh := 1 if posmod(int(o[PalData.EO_X]), 32) != 0 else 0
			if dx != ex or dy != ey or dh != eh:
				continue
			# 面向队伍并摆出站立姿势
			o[PalData.EO_CUR_FRAME] = 0
			o[PalData.EO_DIRECTION] = (PALState.party_dir + 2) % 4
			for l in range(PALState.max_party_member_index + 1):
				PALState.party[l]["frame"] = PALState.party_dir * 3
			_redraw = true
			var entry := int(o[PalData.EO_TRIGGER_SCRIPT])
			if entry != 0:
				if _auto_mode:
					_auto_used[id] = true
				_start_script(entry, id)
			return


## 每帧事件对象状态更新（对齐 play.c PAL_GameUpdate：消失计时 / 离屏恢复 / auto script / 队伍挡位推开）
func _update_event_updates() -> void:
	# R75-GAME1：战后/逃跑追逐冷却递减
	for pid in _chase_pause.keys():
		var left := int(_chase_pause[pid]) - 1
		if left <= 0:
			_chase_pause.erase(pid)
		else:
			_chase_pause[pid] = left
	# R164-GUARDRESTORE-1：宽限到期后先把临时清场的遭遇事件恢复，再继续正常帧更新。
	_restore_encounter_events_after_guard()
	# R77-FIX-1：读档宽限内不推进 auto 脚本
	if _load_grace_active():
		return
	# pass 1（play.c:81-192）：vanish 计时 → state<0 离屏恢复 → state>0 且 vanish==0 时每帧推进 auto 脚本
	for id in range(evt_start + 1, evt_end + 1):
		var o: Array = sss.event(id)
		var vanish := int(o[PalData.EO_VANISH])
		if vanish != 0:
			o[PalData.EO_VANISH] = vanish + (1 if vanish < 0 else -1)
			continue
		var state := int(o[PalData.EO_STATE])
		if state < 0:
			# play.c:96-105：sState<0（0x0052 战后切换态 / 待重生）时，原版仅在事件**离开视口矩形**
			# （x<vx 或 x>vx+320 或 y<vy 或 y>vy+320，原版 y 上限同样写 +320）才恢复为 +abs(state)。
			# round74 旧实现按"在视野内"恢复，与 sdlpal 相反 —— 导致战斗胜利后怪物在原地立即重生、
			# 与真实追击叠加会把玩家原地锁死。
			var off_view := int(o[PalData.EO_X]) < PALState.viewport.x \
				or int(o[PalData.EO_X]) > PALState.viewport.x + 320 \
				or int(o[PalData.EO_Y]) < PALState.viewport.y \
				or int(o[PalData.EO_Y]) > PALState.viewport.y + 320
			if off_view:
				o[PalData.EO_STATE] = absi(state)
				o[PalData.EO_CUR_FRAME] = 0
				_redraw = true
			continue
		if state > 0:
			# R159-FLEECOOLDOWN-2：逃跑后的 10s 脱战窗口内，跳过**所有遭遇/追击事件的 auto 脚本**，
			# 否则 0x4C 追击 auto 会继续追并重新开战（R136 原来只暂停同一 event）。
			if Time.get_ticks_msec() < _battle_guard_until_ms and _is_encounter_event(id):
				continue
			# R138-FLEEGUARD-2：逃跑保护期内/未离原圈时，同一事件的 auto 脚本也暂停推进，
			# 否则 auto 脚本可能重新开启战斗/进入等待，造成“圈内移动锁死”。
			if id == _flee_guard_evt:
				var fpp := abs_party()
				var fgd2 := absi(fpp.x - int(o[PalData.EO_X])) + absi(fpp.y - int(o[PalData.EO_Y])) * 2
				if Engine.get_process_frames() < _flee_guard_until or fgd2 < _flee_guard_ring:
					continue
				_flee_guard_evt = 0
			var auto_entry := int(o[PalData.EO_AUTO_SCRIPT])
			if auto_entry != 0 and vm != null and vm.has_method("run_auto"):
				# round75/P0：对齐 sdlpal PAL_RunAutoScript——auto 脚本**每帧推进一条指令**并回写
				# 下一入口（原版主循环 play.c PAL_GameUpdate 每帧对每个 state>0 且 vanish==0 的事件
				# 调用一次；返回 0=停止）。round73 的"同一事件同一 auto entry 只跑一次"latch 并非
				# 原版语义，会把多帧 auto 脚本（如场景2 evt11 李大娘 auto=39：走到门口→置门 evt4
				# state=1→隐藏自己；各章怪物 auto=CHASE）冻结在第一步，导致 P0 房间出不去、
				# 怪物不追击等偏差。本版按用户拍板 A（全局忠实）一律每帧推进。
				var next_entry: int = vm.run_auto(auto_entry, id)
				if next_entry != auto_entry:
					o[PalData.EO_AUTO_SCRIPT] = next_entry
					_scene_doors_dirty = true
					if _debug_hud:
						print("[auto] scene=%d id=%d entry=%d->%d pos=%s" % [
							int(PALState.scene), id, auto_entry, next_entry, str(abs_party())])
					_redraw = true
	# pass 2（play.c:194-232）：blocker 型事件（state>=2）带精灵且贴住队伍（metric<=12）时，
	# 原版会把队伍按"事件朝向+1 起顺时针尝试"推出一格（16/8）到可行走格，防止追击怪物/挡路 NPC
	# 把玩家压死在原地。round73 起此逻辑缺失，与真实追击叠加会形成死局。
	if sss == null:
		return
	for id in range(evt_start + 1, evt_end + 1):
		var o: Array = sss.event(id)
		if int(o[PalData.EO_STATE]) < 2 or int(o[PalData.EO_SPRITE]) == 0:
			continue
		var party := abs_party()
		if absi(party.x - int(o[PalData.EO_X])) + absi(party.y - int(o[PalData.EO_Y])) * 2 > 12:
			continue
		var wdir := (int(o[PalData.EO_DIRECTION]) + 1) % 4
		for _k in range(4):
			var dx := -16 if (wdir == DIR_WEST or wdir == DIR_SOUTH) else 16
			var dy := -8 if (wdir == DIR_WEST or wdir == DIR_NORTH) else 8
			var nx := party.x + dx
			var ny := party.y + dy
			# 对齐 play.c:218 的 PAL_CheckObstacleWithRange(pos, TRUE, 0, TRUE) 意图：
			# 目标格需可行走（含其它事件阻挡）；check_range 分支在 sdlpal scene.c，ref 未收录，
			# 按普通地图/事件阻挡判定 [inf]。
			if not NpcMove.check_obstacle(self, nx, ny, true, 0, false):
				PALState.viewport += Vector2i(dx, dy)
				var abs_new := abs_party()
				for i2 in range(PALState.trail.size()):
					PALState.trail[i2] = {"x": abs_new.x, "y": abs_new.y, "dir": int(PALState.party_dir)}
				if _debug_hud:
					print("[push] scene=%d id=%d dir=%d from=%s to=%s" % [
						int(PALState.scene), id, wdir, str(party), str(abs_new)])
				_redraw = true
				break
			wdir = (wdir + 1) % 4


